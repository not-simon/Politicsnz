<style id="isr-acc-assets-inline-css">
:root { --isr-acc-blue:#00274C; --isr-acc-maize:#FFCB05; }

.isr-acc-alertbar {
  background: var(--isr-acc-blue);
  color: var(--isr-acc-maize);
  border-top: 3px solid var(--isr-acc-maize);
  padding: 10px 16px;
  width: 100%;
  box-sizing: border-box;
  font: inherit;
}
@media (prefers-reduced-motion: reduce){
  .isr-acc-alertbar {
    background: var(--isr-acc-blue);
    color: var(--isr-acc-maize);
    border-top: 3px solid var(--isr-acc-maize);
    padding: 10px 16px;
    width: 100%;
    box-sizing: border-box;
    font: inherit;
  }
}
.isr-acc-alertbar__text { margin: 0; line-height: 1.4; }
.isr-acc-alertbar__link { color: var(--isr-acc-maize); font-weight: 700; text-decoration: underline; }
.isr-acc-alertbar__link:focus { outline: 2px solid #fff; outline-offset: 2px; }

.isr-acc-badge {
    display:inline-block;
    margin-left:.8rem;
    padding:.125rem .5rem;
    border:2px solid currentColor;
    border-radius:.5rem;
    font-size:.875rem;
    font-weight:600;
    text-indent: 0;
}

.isr-remediation-level.isr-remediation-warning a {
    outline: 2px dashed orange;
    outline-offset: 2px;
}
.isr-remediation-level.isr-remediation-critical a {
    outline: 4px double red;
    outline-offset: 2px;
}

.isr-sr-only {
  position: absolute !important; width:1px !important; height:1px !important;
  padding:0 !important; margin:-1px !important; overflow:hidden !important;
  clip: rect(0,0,0,0) !important; white-space:nowrap !important; border:0 !important;
}

.isr-acc-details-link .dashicons {
    font-size: 16px;
    vertical-align: text-bottom;
    margin: 0 0px;
}
