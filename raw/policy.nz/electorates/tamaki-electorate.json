   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6pR1",
      "name": "Why I'm standing",
      "value": "I'm standing because Tāmaki deserves an experienced and effective MP who can get things done. I've spent years winning arguments as a lawyer and working at the highest levels of government. Now I want to turn that know-how into results for our businesses, infrastructure, beaches, streets and schools. I want a smaller and higher quality state that lives within its means so our kids can build their lives here, not overseas."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6pSw",
      "name": "About me",
      "value": "I have a traditional view of an electorate MP's job, someone easy to reach, proactive and willing to roll up my sleeves when residents need problems solved. I bring nearly two decades of experience in politics and as a lawyer to the table in order to do so. Tāmaki is a special part of Auckland and needs dedicated, effective representation in the next Parliament."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6pUr",
      "name": "Priority 1",
      "value": "Push infrastructure before intensification, particularly where the pipes are already failing"
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6pWm",
      "name": "Priority 2",
      "value": "Balance the books and cut red tape, because the cost of living is Tāmaki's top concern"
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6pYh",
      "name": "Priority 3",
      "value": "Tackle crime and anti-social behaviour so Tāmaki's streets and beaches are safe for everyone"
     }
    ],
