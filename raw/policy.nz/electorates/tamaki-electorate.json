   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6pFV",
      "name": "Why I'm standing",
      "value": "I am a medical graduate who trained in hospitals across Auckland and Northland. It was during this experience that I realised how little investment we were putting into our communities to keep people well before they got sick and save taxpayer money in the process. This ambitious level of investment in our neighbourhoods and our nature to make it easy and affordable to be happy and healthy is key to why I'm running."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6pHQ",
      "name": "About me",
      "value": "I am a good listener and team player. I can work with members of the community to champion what they believe are the greatest challenges they're experiencing and be a strong advocate for those whose voices sometimes go unheard. I am confident, steadfast in my values, willing to compromise on the smaller things to help bring us together, but never on the vision of a healthy, affordable Aotearoa where we can all thrive."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6pJL",
      "name": "Priority 1",
      "value": "Protect Tāmaki's beautiful natural environments like our Eastern beaches and the Hauraki Gulf."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6pLG",
      "name": "Priority 2",
      "value": "Make sure everyday bills, like power, groceries, and transport costs, are more affordable."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6pNB",
      "name": "Priority 3",
      "value": "Fix our tax system so that the super-rich with assets over $10 million contribute their fair share."
     }
    ],
