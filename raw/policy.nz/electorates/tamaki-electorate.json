   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6pzZ",
      "name": "Why I'm standing",
      "value": "I am running because I know that New Zealand needs Opportunity to be in parliament as the badly needed, practical, evidence-based, long term thinking political party of leaders. We do not need more ideological flip-flops between governments every 3 years undoing work and incurring billions in sunk costs - just because it wasn't their idea. We need doers not debaters and Opportunity is a party of doers ready to make things happen."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6q1U",
      "name": "About me",
      "value": "I already have a lifelong commitment to the community professionally, and know how to make things happen with decades of experience in managing the intersection between local government and central government to deliver projects for the community. I can navigate complex challenges and can bring diverse stakeholders together achieve better outcomes with a list of achievements. My professional experience spans business, sport, law and order, community and infrastructure so I will hit the ground running."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6q3P",
      "name": "Priority 1",
      "value": "Get better infill housing design and planning to support greater community and aesthetic outcomes."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6q5K",
      "name": "Priority 2",
      "value": "Improve crime and disorder, and road and transport issues to improve social connection."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6q7F",
      "name": "Priority 3",
      "value": "Get stakeholder alignment on long term planning for community, business and enviro outcomes."
     }
    ],
    "party": {
     "name": "Opportunity Party"
    },
