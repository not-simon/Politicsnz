  "candidates": [
   {
    "attributes": [
     {
      "_key": "5r5sFjSBWMIetVQk4fNTFo",
      "name": "Why I'm standing",
      "value": "My commitment is simple: stand up for working people and make sure communities like Waimakariri have a strong voice and a fair go."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4fNTL2",
      "name": "About me",
      "value": "I didn't follow the 'usual' path to Parliament. I started out my working life as a mechanic in the NZ Army. I got into politics after a life-changing cancer diagnosis. It was that experience that motivated me to make a difference - to make sure Kiwis get the healthcare they deserve."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4fNTQG",
      "name": "Priority 1",
      "value": "Advocate for the healthcare our people deserve."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4fNTVU",
      "name": "Priority 2",
      "value": "Advocate for stable and secure jobs."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4fNTai",
      "name": "Priority 3",
      "value": "Advocate for communities adversely affected by residential Fast Track applications."
     }
    ],
