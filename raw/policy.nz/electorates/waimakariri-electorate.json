   {
    "attributes": [
     {
      "_key": "5r5sFjSBWMIetVQk4fNTlA",
      "name": "Why I'm standing",
      "value": "New Zealand has been going downhill in most aspects. I believe New Zealand First is the only party that has policies to fix the broken economy. Once that is on track we can then make realistic lasting improvements in the other aspects of society that desperately need it, such as infrastructure, health, education, housing, conservation, tourism and immigration. Without a strong economy we will continue to slide."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4fNTqO",
      "name": "About me",
      "value": "I am a community based rural person, having been involved in church and voluntary community groups over the years. Currently I run a tourism business. I believe that the conservative approach is what made us a brilliant country and that parliament needs people who understand that and have experience in community and business so they are always aware of the impact on communities their decisions have."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4fNTvc",
      "name": "Priority 1",
      "value": "Farming, removing unnecessary costly interference. Our farmers know their job. Let them do it."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4fNU0q",
      "name": "Priority 2",
      "value": "Public transport - encouraging peak hour passenger rail between Rangiora and Christchurch."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4fNU64",
      "name": "Priority 3",
      "value": "Cost of living - this involves several policies including power, food costs and fuel security."
     }
    ],
