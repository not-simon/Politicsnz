   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqoz3vJ",
      "name": "Why I'm standing",
      "value": "After 17 years representing Kapiti in local government, I've joined the NZ First team to represent people in Parliament. I've long championed responsible environmental stewardship, while making the most of our abundant natural resources. I support NZ First because we recognise the two can go hand in hand. By reforming the RMA and introducing fast-track consenting, we can unlock responsible development, create well-paid jobs in our regions, and help return New Zealand to prosperity."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz3xU",
      "name": "About me",
      "value": "As well as 17 years as a councillor, I'm the Chair of the Otaki College Board, and previously was on the Board of Te Waananga o Raukawa. I have an Honours Degree in Politics from Victoria University. Through my perseverance and dedication to this community, I've helped secure new electric trains for our region, which will bring many more weekday and weekend services to our community. The investment will bring huge economic benefits to our region."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz3zf",
      "name": "Priority 1",
      "value": "Cost of living is top of mind for all households."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz41q",
      "name": "Priority 2",
      "value": "Well-paid jobs in the provinces, not just the cities, to support our provincial communities."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz441",
      "name": "Priority 3",
      "value": "Responsible environmental stewardship, while making the most of abundant natural resources."
     }
    ],
