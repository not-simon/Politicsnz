   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqoz48N",
      "name": "Why I'm standing",
      "value": "Kapiti is where I was born and grew up, and I care deeply about our people and our natural environment. In such a consequential election, our community needs grounded leadership that translates grassroots values into real action in Parliament. I want to build a thriving, sustainable future for our home by delivering quality local jobs, healthy warm homes, accessible healthcare, and real action on the cost of living."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz4AY",
      "name": "About me",
      "value": "I bring a strong track record in movement building and proven local governance experience. Having served two terms on the Kāpiti Coast District Council, chairing Strategy, Operations, and Finance, I know how to bridge community conversations with effective policy-making. I will bring an energetic, collaborative voice to Parliament to deliver practical solutions for our Kapiti electorate, through listening and being tenacious and persistent until we see change."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz4Cj",
      "name": "Priority 1",
      "value": "Tackling the cost of living: Free GP visits, solar and a $20 per week cap on public transport fares."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz4Eu",
      "name": "Priority 2",
      "value": "Investing in health: Nobody should wait weeks to see a doctor, or travel far for basic care."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz4H5",
      "name": "Priority 3",
      "value": "Fighting to bring back the work that keeps people here, as well as building the homes we need."
     }
    ],
    "party": {
     "name": "Labour Party"
