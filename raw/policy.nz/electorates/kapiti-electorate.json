   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqoz3VB",
      "name": "Why I'm standing",
      "value": "We need to restore the promise of a fair go: that everyone willing and able has the opportunity to build a life of dignity and security. And when life deals unfair blows, we stand together to support those in need. This is my purpose. A better New Zealand will be my legacy."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz3XM",
      "name": "About me",
      "value": "I have spent the majority of my working life listening as a journalist and a nurse. I will listen to the concerns of the electorate and look at draft bills in Parliament through the lens of my constituents."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz3ZX",
      "name": "Priority 1",
      "value": "Pushing for the establishment of a 24/7 polyclinic as advocated by the Kapiti Health Advisory Group."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz3bi",
      "name": "Priority 2",
      "value": "Ensuring that social housing groups have access to Crown funding so they can get on with building."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz3dt",
      "name": "Priority 3",
      "value": "Standing up for consumers by strengthening the Commerce Commission."
     }
