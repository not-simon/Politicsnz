   {
    "attributes": [
     {
      "_key": "5r5sFjSBWMIetVQk4N5MVk",
      "name": "Why I'm standing",
      "value": "In a world increasingly focused on ideological silos that determine the outcomes for nations, Opportunity Party provides sensible, evidence-based policy that transcends ideology and party politics. Our country needs balanced, logical policy-making, and that's why I choose to invest in the success of the Opportunity Party in 2026. Together we can build a stronger, sustainable future for our country."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5May",
      "name": "About me",
      "value": "I am a community-focused person with a focus on the best outcomes for myself, my family and my community. My motto is simple: when making decisions, I ask myself \"Is it the right thing to do?\""
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5MgC",
      "name": "Priority 1",
      "value": "Support the Opportunity Party to secure seats in Parliament, so our policies can be enacted."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5MlQ",
      "name": "Priority 2",
      "value": "Ensure that the needs of the people in Maungakiekie are represented equitably in Parliament."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5Mqe",
      "name": "Priority 3",
      "value": "Be a voice of reason for the people when projects like the East-West Corridor are negotiated."
     }
    ],
