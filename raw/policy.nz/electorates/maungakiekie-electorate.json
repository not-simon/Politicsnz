     {
      "_key": "5r5sFjSBWMIetVQk4N5N16",
      "name": "Why I'm standing",
      "value": "I love being able to serve the families and people of Maungakiekie as the local MP. I've lived here for nearly 30 years and nothing beats clearing obstacles and opening doors for the people in my community."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5N6K",
      "name": "About me",
      "value": "For 25 years before entering Parliament I ran local and national charities and those experiences formed my vision for how a society can best flourish. By profession I'm an accountant, by heart I'm an advocate for strong families, communities & businesses."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5NBY",
      "name": "Priority 1",
      "value": "Serve the people of Maungakiekie by clearing obstacles and opening doors - whatever their challenge."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5NGm",
      "name": "Priority 2",
      "value": "Secure further investment in our local schooling and roading infrastructure."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5NM0",
      "name": "Priority 3",
      "value": "Ensure wise housing development in Maungakiekie."
     }
    ],
