   {
    "attributes": [
     {
      "_key": "5r5sFjSBWMIetVQk4N5O1o",
      "name": "Why I'm standing",
      "value": "I have spent the past 5 years leading New Zealand First's youth wing. I believe that by stepping up to run in 2026, I can continue to represent our young Kiwis and help put New Zealanders first again. New Zealand First has the bold policy to change the direction of our country and give young people the optimism needed to stay in New Zealand."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5O72",
      "name": "About me",
      "value": "I'm advocating for a party vote for New Zealand First to help return a larger team to Parliament. If I'm fortunate enough to be part of the incoming caucus, I will bring my experience as the leader of Young New Zealand First to the team and advocate for youth issues and the things young Kiwis have raised as their biggest issues with me such as cost of living, housing, and immigration."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5OCG",
      "name": "Priority 1",
      "value": "Advocating for student loan reform to help ease cost of living and keep talent in New Zealand."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5OHU",
      "name": "Priority 2",
      "value": "Creating job opportunities across our community and growing the economy so everyone has a fair go."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5OMi",
      "name": "Priority 3",
      "value": "Putting Kiwis first. We can't continue to send billions offshore when our own people are struggling."
     }
    ],
