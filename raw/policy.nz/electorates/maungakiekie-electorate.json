   {
    "attributes": [
     {
      "_key": "5r5sFjSBWMIetVQk4N5NWS",
      "name": "Why I'm standing",
      "value": "I am asking you to give your party vote to ACT to help unlock New Zealand's potential. This country has given me so much, and I want to give back by creating opportunities for others through hard work, freedom and personal responsibility. I want more ACT MPs to cut waste, grow the country, balance the books with no new taxes, defend equal rights, improve public services, cut red tape and restore consequences for crime."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5Nbg",
      "name": "About me",
      "value": "I'm putting New Zealand ahead of personal ambition. I'm not asking you to elect me as your local MP, but to give your party vote to ACT to Lock Labour Out and Unlock New Zealand's potential. An ACT party vote will help keep the coalition Government in power, continue the good work, and give a stronger mandate to push further and faster on the issues that matter most to you."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5Ngu",
      "name": "Priority 1",
      "value": "Grow the economy to balance the books with no new taxes so incomes rise faster than living costs."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5Nm8",
      "name": "Priority 2",
      "value": "Deliver better services for taxpayers: education, police, and match Australia on medicines funding."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5NrM",
      "name": "Priority 3",
      "value": "Make decisions based on need, not race, and with one law for all and one future together."
     }
    ],
