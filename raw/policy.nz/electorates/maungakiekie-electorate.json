   {
    "attributes": [
     {
      "_key": "5r5sFjSBWMIetVQk4N5M0O",
      "name": "Why I'm standing",
      "value": "I believe in the vision that the Green Party has for Aotearoa and I want to support the kaupapa. I believe that we can all thrive, while acknowledging and uplifting the humanity and dignity of all of us. I want to make sure that all voices in Maungakiekie will be heard in the halls of Parliament."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5M5c",
      "name": "About me",
      "value": "I've lived in Maungakiekie for about half my life and have taught some ākonga living in the area for most of my professional career. I have created connections as a kaiako and bring a listening ear to listen to concerns of our area. Party Vote Green!"
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5MAq",
      "name": "Priority 1",
      "value": "Advocate for a fairer tax system to ease the cost of living."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5MG4",
      "name": "Priority 2",
      "value": "Make our local waterways swimmable and our water drinkable.  "
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5MLI",
      "name": "Priority 3",
      "value": "Ease the cost of living by investing in power infrastructure."
     }
    ],
