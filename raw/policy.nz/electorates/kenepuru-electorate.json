   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roW9Mi",
      "name": "Why I'm standing",
      "value": "I believe that New Zealand has so much more potential as a safe, prosperous, clean and sustainable place to live, but we have been let down by short-term political thinking. I want to be part of an Opportunity party that puts future generations at the heart of our decision-making."
     },
     {
      "_key": "227mFCOl8uclHuS5roW9PX",
      "name": "About me",
      "value": "I made Wellington my home a quarter of a century ago, and I have been a teacher at a number of schools around the local community for most of that time. This has given me a rich understanding of the diverse needs of the Kenepuru electorate, which I would be proud to represent."
     },
     {
      "_key": "227mFCOl8uclHuS5roW9SM",
      "name": "Priority 1",
      "value": "Advocate for good electorate-wide access to physical and mental health services."
     },
     {
      "_key": "227mFCOl8uclHuS5roW9VB",
      "name": "Priority 2",
      "value": "Ensure free public transport for the electorate."
     },
     {
      "_key": "227mFCOl8uclHuS5roW9Y0",
      "name": "Priority 3",
      "value": "Prioritise local businesses for delivering local council work."
     }
    ],
