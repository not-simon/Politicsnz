   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roW8Xu",
      "name": "Why I'm standing",
      "value": "My parents immigrated here from Glasgow, Scotland and in the 1960s Mum, Dad and the kids settled in Newlands, Wellington. I am extremely grateful for the strong multicultural community we grew up in - and consequently - have always wanted to serve and protect my Porirua and Northern Corridor communities. In these tough times I think real change is needed, and only NZ First has the backbone to carry through these cost of living reforms."
     },
     {
      "_key": "227mFCOl8uclHuS5roW8aj",
      "name": "About me",
      "value": "As a senior health and social services practitioner I have worked in services as diverse as the Women's Refuge, Red Cross Refugee Services and support for homeless communities. In cooperation with Police and legal services I have also had leadership roles in child/youth care and protection. As an MP I believe I can add value regarding how the government can increase the effectiveness of health/social services, increase staff numbers, and enhance staff retainment."
     },
     {
      "_key": "227mFCOl8uclHuS5roW8dY",
      "name": "Priority 1",
      "value": "Bringing down the cost of people's power bills by breaking up the 'gentailers' power structure."
     },
     {
      "_key": "227mFCOl8uclHuS5roW8gN",
      "name": "Priority 2",
      "value": "Bringing down the cost of food bills, by breaking up the supermarket duopoly (Foodstuffs/Woolworths)."
     },
     {
      "_key": "227mFCOl8uclHuS5roW8jC",
      "name": "Priority 3",
      "value": "Primary health care: Increasing choice of interventions, quality advice and worker satisfaction."
     }
    ],
    "party": {
     "name": "NZ First"
    },
