   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roW95m",
      "name": "Why I'm standing",
      "value": "Creating positive change is the reason I'm standing for Parliament. Wellington and New Zealand have much more to offer. I want to build a future that is prosperous, resilient, and full of opportunity for all Kiwis. A future with a thriving economy, great jobs, a flourishing environment, and world-class education and healthcare. We have complex challenges in areas like energy, healthcare, poverty, the environment, and the economy. I want to be part of solving those challenges."
     },
     {
      "_key": "227mFCOl8uclHuS5roW98b",
      "name": "About me",
      "value": "Our electorate needs someone that listens to you and your community and knows how to deliver positive change with people at the centre. I was born and raised in NZ and have lived and worked across the country, with the last 16 years in Tawa, where we've raised our family. My career has spanned government and private business. I know what it takes for government to work well and for a business to be successful."
     },
     {
      "_key": "227mFCOl8uclHuS5roW9BQ",
      "name": "Priority 1",
      "value": "Create a shared vision to coordinate effort across local & central government, businesses, and NGOs."
     },
     {
      "_key": "227mFCOl8uclHuS5roW9EF",
      "name": "Priority 2",
      "value": "Build new health services so people can get the care they need locally."
     },
     {
      "_key": "227mFCOl8uclHuS5roW9H4",
      "name": "Priority 3",
      "value": "Invest in local business hubs that create technology and manufacturing jobs."
     }
    ],
