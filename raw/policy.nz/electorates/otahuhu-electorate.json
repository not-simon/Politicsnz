   {
    "attributes": [
     {
      "_key": "JKz7wQRzjvR89dXrThdsln",
      "name": "Why I'm standing",
      "value": "I'm fighting for secure, affordable homes; quality healthcare and education; real opportunities for rangatahi; and an economy that supports local people and businesses, not just those already at the top. I stand for tino rangatiratanga in action, honouring Te Tiriti o Waitangi, and protecting our whenua and waterways for generations to come. Our communities don't need more empty promises. We need leadership that listens, shows up and fights for our people."
     },
     {
      "_key": "JKz7wQRzjvR89dXrThdsp2",
      "name": "About me",
      "value": "I'm Māori and Tongan, a husband, father, community worker, coach, an advocate for our people and in a previous life, an NZ MMA and kickboxing champion. For years, I've worked alongside rangatahi and whānau in youth development, mental health and social services. I've also stood with my whānau to protect our ancestral whenua and waterways at Rotokākahi. This campaign is about all of us building the future our communities deserve."
     },
     {
      "_key": "JKz7wQRzjvR89dXrThdssH",
      "name": "Priority 1",
      "value": "Affordable lives for all of us by taxing the super-rich, lowering power, grocery and transport costs."
     },
     {
      "_key": "JKz7wQRzjvR89dXrThdsvW",
      "name": "Priority 2",
      "value": "Fighting for secure, affordable homes; quality healthcare and education."
     },
     {
      "_key": "JKz7wQRzjvR89dXrThdsyl",
      "name": "Priority 3",
      "value": "Pursuing real opportunities and support for rangatahi to enable them and their whānau to thrive."
     }
    ],
