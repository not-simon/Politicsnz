   {
    "attributes": [
     {
      "_key": "JKz7wQRzjvR89dXrThdrmC",
      "name": "Why I'm standing",
      "value": "I want to create a future that my daughter's generation will be proud to inherit. An Aotearoa where every family is able to thrive."
     },
     {
      "_key": "JKz7wQRzjvR89dXrThdrpR",
      "name": "About me",
      "value": "I've built my career in the world of retail balancing the needs of customers with the sustainability of business. They are equally important to success and that is the philosophy I bring and that our politics sorely needs. A balanced approach will stop the pendulum swinging when the government changes."
     },
     {
      "_key": "JKz7wQRzjvR89dXrThdrsg",
      "name": "Priority 1",
      "value": "Rebuild trust of the community in Parliament by cleaning up politics. Politics should work for you!"
     },
     {
      "_key": "JKz7wQRzjvR89dXrThdrvv",
      "name": "Priority 2",
      "value": "Drive the price of power down to relieve household cost of living through investing in renewables."
     },
     {
      "_key": "JKz7wQRzjvR89dXrThdrzA",
      "name": "Priority 3",
      "value": "Revitalize the old MIT land with local partnership into a development the community can be proud of."
     }
    ],
