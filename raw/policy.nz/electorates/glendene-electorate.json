   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqoysii",
      "name": "Why I'm standing",
      "value": "I am sick of seeing New Zealand in a managed decline through successive Labour and National Governments. I want to see a brighter future built for our country, and I believe Opportunity presents the best vision for that."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyskt",
      "name": "About me",
      "value": "As a younger candidate, I bring a voice that is often ignored in our Parliament. Because I'll still be living with the consequences of today's decisions in 40 years, my focus is not just on cheap political wins that kick the can down the road, but on setting our country up for success in the decades to come."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoysn4",
      "name": "Priority 1",
      "value": "Build infrastructure for future growth, especially wastewater in Te Atatu and transport in Glendene."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyspF",
      "name": "Priority 2",
      "value": "Maintain good access to community spaces, particularly the Avondale Racecourse and Sunday Market."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoysrQ",
      "name": "Priority 3",
      "value": "Fixing Waitakere Hospital and local school roll pressures with long-term planning, not yearly panic."
     }
    ],
