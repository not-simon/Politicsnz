     {
      "_key": "RIU5sv1nWnkj6dpEqoytB1",
      "name": "Why I'm standing",
      "value": "I am running to organise communities across Aotearoa for affordable lives, healthy nature, and honest politics. We have enough in Aotearoa for all of us to live a good life. I bring with me the voices of workers who are fighting for affordable and dignified lives, honouring te Tiriti, just transitions, safe and inclusive workplaces."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoytDC",
      "name": "About me",
      "value": "I am a trusted leader in education, a respected community and trade union organiser, and have been put forward by my community to stand as an elected representative. My experiences advocating for tamariki and organising in the community have given me the experience to voice and represent our communities in Glendene."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoytFN",
      "name": "Priority 1",
      "value": "Affordable lives: Taxing the super rich, lowering power, grocery, transport and other bills."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoytHY",
      "name": "Priority 2",
      "value": "Healthy nature: Ensuring we can drink, swim, and fish in our oceans and rivers."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoytJj",
      "name": "Priority 3",
      "value": "Workers rights: Default union membership and guaranteed minimum wage increases, pay equity."
     }
    ],
