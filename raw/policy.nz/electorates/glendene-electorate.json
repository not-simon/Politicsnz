   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqoysGP",
      "name": "Why I'm standing",
      "value": "New Zealand's story has been shaped by courage and conviction, from being the first nation to give women the vote, to Rutherford splitting the atom, to Hillary conquering Everest. I'm running because I believe public service is a calling. I want to bring my experience, values and leadership back to Parliament, building on the foundations laid before us, confronting today's challenges with courage, and ensuring every New Zealander has the opportunity to fulfil their potential."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoysIa",
      "name": "About me",
      "value": "I bring more than 35 yrs of leadership across trades, community, church, governance & politics. I've served on school boards, community organisations, as an MP and a Minister of the Crown. I understand the realities around the kitchen table & the responsibility of the Cabinet table. I believe leadership requires courage, integrity & service: listening to people, standing by your convictions, and having the experience to turn those convictions into practical action that delivers results."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoysKl",
      "name": "Priority 1",
      "value": "Reduce living costs by increasing competition in food and power and essential services."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoysMw",
      "name": "Priority 2",
      "value": "Strengthen families through better education by ensuring parental support and consent."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoysP7",
      "name": "Priority 3",
      "value": "Secure better transport, healthcare and infrastructure for West Auckland's future."
     }
    ],
