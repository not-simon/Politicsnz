   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqoysvm",
      "name": "Why I'm standing",
      "value": "The time is right for a clear and uncompromising voice for animals in New Zealand - they need representation in politics. Don't waste your vote on the major parties - vote for your values, and help us get to five percent so that we can speak up for vulnerable animals."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoysxx",
      "name": "About me",
      "value": "As a long-time animal advocate, and a chartered accountant, I bring both empathy and organisational skills to help speak effectively for animals, and for this dynamic and vibrant community of animal-lovers. I won't just be another suit in Wellington - the Animal Justice Party is running in many electorates on a platform of compassion, equality and non-violence. I'll stand up for animals, who desperately need a voice in parliament. Vote for your values!"
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyt08",
      "name": "Priority 1",
      "value": "Ensure residents' compassionate nature is reflected in their representative in parliament."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyt2J",
      "name": "Priority 2",
      "value": "Foster empathy, and ensure that the needs of human and animal residents are heard in politics."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyt4U",
      "name": "Priority 3",
      "value": "Encourage more and better green spaces for humans and animals to enjoy safely together."
     }
    ],
