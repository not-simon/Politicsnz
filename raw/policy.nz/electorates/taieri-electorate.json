    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqoynfA",
      "name": "Why I'm standing",
      "value": "I believe democratic socialist values should have a voice in Parliament, to ultimately build a strong left bloc, provide resilience for the future and undo the harm caused by neoliberalism. I want to fight for equality, human rights and progressive social policies, both regionally and nationally."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoynhL",
      "name": "About me",
      "value": "I joined the Alliance due to my socialist values and community advocacy in recent years, most notably on environmental issues as a member of Climate Liberation Aotearoa, speaking out for Palestinians and indigenous rights alongside tangata whenua, against homelessness and land sales by Kāinga Ora, for workplace safety as a member of Unions Otago, for pay equity, and for all manner of community issues as deputy chair of the Waikouaiti Coast Community Board."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoynjW",
      "name": "Priority 1",
      "value": "Implement our Full Employment policy, to kickstart productivity and restore dignity."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoynlh",
      "name": "Priority 2",
      "value": "Establish the public community health service, for free GP visits, dental, optical and audiology."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoynns",
      "name": "Priority 3",
      "value": "Shift the tax burden off work and onto wealth, delivering cost-of-living relief to households."
     }
    ],
