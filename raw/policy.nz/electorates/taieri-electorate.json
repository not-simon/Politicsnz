   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqoynsE",
      "name": "Why I'm standing",
      "value": "I have represented Taieri since 2020 and have a strong record of being accessible, hardworking and willing to speak up. I hold regular street-corner meetings, travel throughout the electorate and turn what people tell me into practical action in Parliament. As Labour's spokesperson for Mental Health and Seniors, I combine community advocacy with evidence-based policy. I understand how government works and know how to ensure local voices are heard at the decision-making table."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoynuP",
      "name": "About me",
      "value": "I have represented Taieri since 2020 and have a strong record of being accessible, hardworking and willing to speak up. I hold regular street-corner meetings, travel throughout the electorate and turn what people tell me into practical action in Parliament. As Labour's spokesperson for Mental Health and Seniors, I combine community advocacy with evidence-based policy. I understand how government works and know how to ensure local voices are heard at the decision-making table."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoynwa",
      "name": "Priority 1",
      "value": "Make life more affordable through higher wages, fairer prices and strong public services. "
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoynyl",
      "name": "Priority 2",
      "value": "Ensure people in Taieri have access to affordable and timely health care and to a great hospital."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyo0w",
      "name": "Priority 3",
      "value": "Climate and flood resilience across urban South Dunedin and rural Clutha and Middlemarch."
     }
