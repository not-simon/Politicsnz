   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqoyo5I",
      "name": "Why I'm standing",
      "value": "I am standing for Parliament because I believe it is time for better representation for our community. A community I have been part of for 20 years, raised my family here and understand the opportunities and challenges our region faces. I want to be a strong, accessible advocate for the people of our area listening to their concerns, taking their issues to Parliament and working hard to achieve practical results for our community."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyo7T",
      "name": "About me",
      "value": "To be an effective representative you need to have a lived experience over a wide range of areas. For me, this includes wins and losses. Family, marriage, kids, community leadership, business management and ownership, sporting organisations and wildlife preservation and awareness. These areas are just some of the experience that I have and that has helped shape me into who I am today. I listen to our community to help shape solutions for positive outcomes."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyo9e",
      "name": "Priority 1",
      "value": "Create workable solutions for high traffic, transport and congestion, particularly for Mosgiel."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyoBp",
      "name": "Priority 2",
      "value": "Advocate for a practical long-term approach to flood protection & resilience throughout the electorate."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyoE0",
      "name": "Priority 3",
      "value": "Strengthen health care access, support Dunedin Hospital and enhance services for rural communities."
     }
    ],
