   {
    "attributes": [
     {
      "_key": "5r5sFjSBWMIetVQk4N5FLY",
      "name": "Why I'm standing",
      "value": "Now more than ever we need Green solutions to the many challenges we face in Aotearoa, including affordability, inequality and climate change. I'm standing for the Green Party of Aotearoa New Zealand to put people and planet at the heart of the next government and to ensure that decisions are made in the best interests of all of us and not big corporates and their lobbyists."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5FQm",
      "name": "About me",
      "value": "As a former city councillor and current MP, I've worked in communities across Ōtautahi and Ilam for over a decade and value the wide range of groups and voices here. I have an environmental science degree and have a track record of planning for the future, taking lead roles in transport and climate adaptation for the city."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5FW0",
      "name": "Priority 1",
      "value": "Make life more affordable with cheaper groceries and electricity, and rebalancing the tax system."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5FbE",
      "name": "Priority 2",
      "value": "Act boldly to both cut climate pollution and to prepare our communities for the future."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5FgS",
      "name": "Priority 3",
      "value": "Focus on students - with rental WOFs, free public transport and work towards fees-free study."
     }
    ],
