  "candidates": [
   {
    "attributes": [
     {
      "_key": "5r5sFjSBWMIetVQk4N5Fw8",
      "name": "Why I'm standing",
      "value": "Graduating from university, I want to repay the community that shaped me. Ilam is a constituency that has been taken for granted by right-wing politicians who have not delivered. Doorknocking every weekend since March, I can see how tough it is for Ilam right now. The cost of living is simply too high, and National is not tackling the structural issues that matter. Better is possible, and better starts with Labour."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5G1M",
      "name": "About me",
      "value": "I bring a fresh approach and energy needed to serve constituents well, not just tick the boxes. Being a local MP is an 80+ hour a week job, and I can serve the constituency locally and in Parliament above and beyond the standard. I have a working-class background which reflects the experience of a lot of the electorate, working from 14 years old. I've lived rurally, regionally, and in cities, so I understand many backgrounds."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5G6a",
      "name": "Priority 1",
      "value": "Making housing accessible for Ilam and advocating for renters' rights."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5GBo",
      "name": "Priority 2",
      "value": "Tackling unemployment so the people of Ilam can have good jobs, locally."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5GH2",
      "name": "Priority 3",
      "value": "Making healthcare affordable and accessible in Ilam."
     }
    ],
    "party": {
