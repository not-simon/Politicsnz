   {
    "attributes": [
     {
      "_key": "MBeO7ojrohBwl7F7zAOlEw",
      "name": "Why I'm standing",
      "value": "I came home in 2021 expecting to see us thriving. Instead, I found a sleeping economy. Productivity is low, costs are climbing, infrastructure is creaking, our environment is ignored and droves of talented New Zealanders are leaving. Our next Government needs people with real experience in delivering change, not managing the status quo. It's time to make the hard, evidence-based decisions that are required to improve for our economy, our environment and our public services."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOlHm",
      "name": "About me",
      "value": "I'm a mum, a school board member, an internationally experienced media, technology and telco executive, and a pretty average basketball coach who's passionate about helping New Zealand embrace innovation, especially AI and emerging technologies. I know how to turn strategy into action, bring people together and deliver results. We have smart people, world-class businesses and incredible natural advantages. We now need better long-term thinking and the courage to modernise and grow our economy."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOlKc",
      "name": "Priority 1",
      "value": "Fix infrastructure while enabling better urban growth. This includes traffic congestion."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOlNS",
      "name": "Priority 2",
      "value": "Build environmental and climate resilience (aka 'flood-proofing') and protect our Hauraki Gulf."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOlQI",
      "name": "Priority 3",
      "value": "Clean up politics: regulate lobbying, investigate corruption and launch Citizens' Assemblies."
     }
    ],
