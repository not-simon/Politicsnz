   {
    "attributes": [
     {
      "_key": "MBeO7ojrohBwl7F7zAOm42",
      "name": "Why I'm standing",
      "value": "My motivation is ensuring that every person in New Zealand has the ability to achieve their full potential. We are the greatest country in the world, with all the natural assets, ability and culture to succeed - I want to play my part in ensuring Government is up to the job of delivering. Good jobs, warm and dry homes and access to healthcare are the foundation of that. Better starts now."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOm6s",
      "name": "About me",
      "value": "I come from outside of politics. Like many people, I left school straight into a job. Through curiosity and work ethic I rose to senior media roles. Studying late in life, I finished a Master's in Public Policy in my 30s. My career has been about connecting with Kiwis and I believe that the North Shore deserves an MP that knows how hard life is at the moment, and will do something about it."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOm9i",
      "name": "Priority 1",
      "value": "Investing in our health workforce at North Shore Hospital to keep our community healthy."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOmCY",
      "name": "Priority 2",
      "value": "Support local families with the cost of living with practical policies to help household budgets."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOmFO",
      "name": "Priority 3",
      "value": "Investing in local roads and transport, making it cheaper and easier to get around our community."
     }
    ],
    "party": {
