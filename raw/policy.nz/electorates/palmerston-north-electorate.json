   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqoz912",
      "name": "Why I'm standing",
      "value": "It is a privilege to do this job and one I don't take lightly. Being able to advocate for the communities that I know and love is something I'm deeply passionate about. Ensuring we can all have affordable lives, and a healthy thriving nature. We need a politics that is for all of us."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz93D",
      "name": "About me",
      "value": "It is a privilege to do this job and one I don't take lightly. Being able to advocate for the communities that I know and love is something I'm deeply passionate about. Upholding Te Tiriti o Waitangi is important to me which involved working with tangata whenua and tangata tiriti to build an Aotearoa we can all be proud of. Kia kaha."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz95O",
      "name": "Priority 1",
      "value": "Affordable Lives, by taxing the rich, lowering power, grocery, transport and other bills."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz97Z",
      "name": "Priority 2",
      "value": "Healthy Nature. Ensuring we can drink, swim, and fish in our oceans and rivers."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz99k",
      "name": "Priority 3",
      "value": "Decisions in our hands. Making sure our voices are central to our democracy and not the corporations."
     }
    ],
