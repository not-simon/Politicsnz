   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqoz8au",
      "name": "Why I'm standing",
      "value": "I believe NZ already has everything it needs to become a socially and environmentally just country; what we need now is leadership that empowers people, strengthens communities, and unlocks the full potential of Aotearoa New Zealand so we can continue to punch above our weight and demonstrate how we can live sustainably alongside nature."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz8d5",
      "name": "About me",
      "value": "Sport, volunteering, and community have always been central to my life - like so many kiwis. Our strength comes from our diversity, connection to nature and community. I believe NZ's strength has always come from ordinary people stepping up for one another. My focus will always be about building healthier communities, creating stronger opportunities for young people, and bringing more long-term thinking into the way we lead and develop the country."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz8fG",
      "name": "Priority 1",
      "value": "The wellbeing of our people - and I'm not just talking about health."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz8hR",
      "name": "Priority 2",
      "value": "Helping young people find a meaningful pathway to adulthood - after all, they are our future."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz8jc",
      "name": "Priority 3",
      "value": "Ensuring people who work full time and do an honest day's work can live a decent life."
     }
    ],
