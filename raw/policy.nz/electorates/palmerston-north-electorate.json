   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqoz8ny",
      "name": "Why I'm standing",
      "value": "I'm running for re-election as our local MP to continue advocating for the place I'm very proud to call my home. Palmerston North is a community that has shaped me, supported me, and given me much. I want to keep being a strong voice for local people, standing up for our city's interests, and helping create opportunities that allow our community and country to thrive."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz8q9",
      "name": "About me",
      "value": "I'm approachable, hardworking, and deeply committed to the community I'm proud to call home. I listen to people, understand the issues that matter to them, and work constructively to get results. I'm happy to stand on my track record as a strong and effective advocate for our community, working hard to ensure local voices are heard and local priorities are advanced. I'm committed to fairness, opportunity, and delivering positive outcomes for the people I represent."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz8sK",
      "name": "Priority 1",
      "value": "Improve access to healthcare so local families can get care closer to home."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz8uV",
      "name": "Priority 2",
      "value": "Advocate for investment in infrastructure to create jobs and support our growing city and region."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz8wg",
      "name": "Priority 3",
      "value": "Champion access to affordable housing so local families can find a place to call home."
     }
    ],
