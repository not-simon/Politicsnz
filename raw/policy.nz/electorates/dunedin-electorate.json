   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWSOY",
      "name": "Why I'm standing",
      "value": "To contribute to some good long term thinking so that NZ looks after our environment (that our economy depends on) and everyone is able to live their best life with secure and healthy housing, access to healthcare and a good job. Wellbeing and social justice are critical. People need to have the capacity to participate in community and to spend time with loved ones."
     },
     {
      "_key": "227mFCOl8uclHuS5roWSRN",
      "name": "About me",
      "value": "I love Dunedin. The past 3 years as the electorate MP has been a privilege and also very grounding (in a good way). I like people and have focussed my staff resource on helping constituents. As an advocate and ambassador for Dunedin I have - and will continue to - bring people / ministers here and our issues to Wellington."
     },
     {
      "_key": "227mFCOl8uclHuS5roWSUC",
      "name": "Priority 1",
      "value": "Completing the new Dunedin Hospital Inpatients build and services"
     },
     {
      "_key": "227mFCOl8uclHuS5roWSX1",
      "name": "Priority 2",
      "value": "Building social housing in Dunedin (note National has paused Carroll St & other Kāinga Ora builds)"
     },
     {
      "_key": "227mFCOl8uclHuS5roWSZq",
      "name": "Priority 3",
      "value": "Monitoring and enforcement of healthy homes standards in rental properties"
     }
