   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWSfU",
      "name": "Why I'm standing",
      "value": "I want to advance the democratic socialist policies of the Alliance that will improve the lives of the working class majority, in jobs, health care, housing and a resilient future."
     },
     {
      "_key": "227mFCOl8uclHuS5roWSiJ",
      "name": "About me",
      "value": "I have lived in Dunedin most of my life and have a good understanding of this community. In my many years as an official with the Maritime Union of New Zealand, I have worked to get real results for working people, in wages, conditions, safety and security. I have a strong understanding of the economy and the issues that need to be focussed on going forward."
     },
     {
      "_key": "227mFCOl8uclHuS5roWSl8",
      "name": "Priority 1",
      "value": "Restore full employment led by KiwiWorks – a 21st century Ministry of Works."
     },
     {
      "_key": "227mFCOl8uclHuS5roWSnx",
      "name": "Priority 2",
      "value": "Transform our transport network through New Zealand coastal shipping, rail and free public transport."
     },
     {
      "_key": "227mFCOl8uclHuS5roWSqm",
      "name": "Priority 3",
      "value": "Create free community health clinics that include dental and eye care."
     }
