   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWRqg",
      "name": "Why I'm standing",
      "value": "I am running because I believe Parliament is for the people and I am one of those people. I'm a mum, a wife, a worker, a farmer, and someone who has built a life in New Zealand through hard work and service. I know what it's like to face everyday pressures and still keep going. I want to bring that grassroot experience to Parliament and truly represent our wider community."
     },
     {
      "_key": "227mFCOl8uclHuS5roWRtV",
      "name": "About me",
      "value": "I believe we should be there to serve the people. I would bring servant leadership, integrity, hard work, and genuine respect for people. My experience in family life, farming, business, HR and community advocacy keeps me grounded in the realities people face. Politically, I believe in opportunity, personal responsibility and strong communities. Most importantly, I will listen, be accessible and never forget who I am there to serve."
     },
     {
      "_key": "227mFCOl8uclHuS5roWRwK",
      "name": "Priority 1",
      "value": "Help Dunedin businesses thrive, so local businesses can create more jobs and opportunities."
     },
     {
      "_key": "227mFCOl8uclHuS5roWRz9",
      "name": "Priority 2",
      "value": "Increase access to affordable, warm and quality housing so they can build their futures in Dunedin."
     },
     {
      "_key": "227mFCOl8uclHuS5roWS1y",
      "name": "Priority 3",
      "value": "Create stronger pathways into employment and training, to have more reason to stay in Dunedin."
     }
    ],
