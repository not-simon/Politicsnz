   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWRIo",
      "name": "Why I'm standing",
      "value": "I am running because I'm frustrated with the short-term thinking and political bickering that is holding New Zealand back. I love New Zealand, and I believe we can be an example for the rest of the world. So I am standing for Opportunity to champion evidence-based policies, long-term planning, and collaborative, practical solutions. We need to work together to make a better, fairer society that gives everyone the opportunity to thrive."
     },
     {
      "_key": "227mFCOl8uclHuS5roWRLd",
      "name": "About me",
      "value": "My career in infrastructure asset management, working in local government and central government in NZ and the UK, has taught me how to work with all sorts of people to deliver practical, long-term results. I believe in service, which is why I Chair the Dunedin Fringe Arts Trust and coach my local rugby team. I will bring a pragmatic, evidence-based approach to Parliament, prioritizing the long-term needs of Kiwis over political point-scoring."
     },
     {
      "_key": "227mFCOl8uclHuS5roWROS",
      "name": "Priority 1",
      "value": "Making houses better quality, so people don't get sick, and more affordable, so people can live!"
     },
     {
      "_key": "227mFCOl8uclHuS5roWRRH",
      "name": "Priority 2",
      "value": "Building the new Dunedin Hospital as promised to ensure proper healthcare for our whole region."
     },
     {
      "_key": "227mFCOl8uclHuS5roWRU6",
      "name": "Priority 3",
      "value": "Delivering a $370 weekly Citizen's Income to ensure everyone can afford basic living costs."
     }
    ],
