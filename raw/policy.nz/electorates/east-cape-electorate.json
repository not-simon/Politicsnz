  "candidates": [
   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqoz7e7",
      "name": "Why I'm standing",
      "value": "I'm running because I care deeply about the East Cape and the people who call it home. I've spent a lot of time listening to people across our communities, and I know many are doing it tough. I want our kids to see a future for themselves here, our whānau to have access to good jobs, healthcare and housing, and our communities to feel hopeful again. I'm running because I believe we can do better."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz7gI",
      "name": "About me",
      "value": "Raised between Whakatāne and Gisborne, I know the East Cape and the realities our families face. I've experienced hardship and know what it takes to work hard and keep moving forward. I bring nine years in Parliament, including as a Minister, alongside experience in business and education. I know how to advocate, navigate government and get things done. I'll bring that experience, determination and deep connection to be a strong voice for the East Cape."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz7iT",
      "name": "Priority 1",
      "value": "I'll put people first and fight for the healthcare, housing and security we all deserve."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz7ke",
      "name": "Priority 2",
      "value": "I'll champion sustainable growth, new industries and a resilient economy for generations to come."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz7mp",
      "name": "Priority 3",
      "value": "I'll back our young people with the skills, training and opportunities to build their future here."
     }
    ],
    "party": {
     "name": "Labour Party"
    },
