   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWH3j",
      "name": "Why I'm standing",
      "value": "New Zealand is the country I chose to call home 37 years ago, and I am deeply grateful for the life and opportunities it has given my family. I am running because I want to give back through public service and help preserve those same opportunities for my children, grandchildren and future generations. I want a safe, prosperous and united New Zealand, with strong families, thriving businesses, responsible government and a confident national identity."
     },
     {
      "_key": "227mFCOl8uclHuS5roWH6Y",
      "name": "About me",
      "value": "I bring over 24 years of business experience, a Master's in Business Innovation and Entrepreneurship, and years of mentoring and community advocacy. As a mother of three, I understand the pressures facing families and businesses. My Christian faith has shaped my commitment to integrity, service and personal responsibility. I will bring practical experience, sound judgement and a strong work ethic to Parliament, always remembering that elected representatives are there to serve the people."
     },
     {
      "_key": "227mFCOl8uclHuS5roWH9N",
      "name": "Priority 1",
      "value": "Improve transport and infrastructure to keep pace with Upper Harbour's rapid growth."
     },
     {
      "_key": "227mFCOl8uclHuS5roWHCC",
      "name": "Priority 2",
      "value": "Support local businesses to create jobs, opportunity and stronger communities."
     },
     {
      "_key": "227mFCOl8uclHuS5roWHF1",
      "name": "Priority 3",
      "value": "Strengthen community safety and ensure Upper Harbour families have a strong voice."
     }
    ],
