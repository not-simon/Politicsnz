   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWIQP",
      "name": "Why I'm standing",
      "value": "I'm running because I want New Zealand to be fairer and more hopeful. No child should grow up in poverty and no one should be without a safe, secure home. I also want us to protect the rivers, coastlines and green spaces that make this country so special. Politics should be about making life better for people now, while looking after the place we leave to the next generation."
     },
     {
      "_key": "227mFCOl8uclHuS5roWITE",
      "name": "About me",
      "value": "I listen, I work hard and I genuinely enjoy meeting people and hearing their stories. I'm good at relating to people from all walks of life and bringing together people with different views. My work has taught me how to build relationships, solve problems and turn good ideas into something practical. I'd bring that same approach to Parliament: stay accessible, do the work and make sure people feel heard."
     },
     {
      "_key": "227mFCOl8uclHuS5roWIW3",
      "name": "Priority 1",
      "value": "Make life more affordable: lower power, grocery and transport costs, with a fairer tax system."
     },
     {
      "_key": "227mFCOl8uclHuS5roWIYs",
      "name": "Priority 2",
      "value": "Protect the places we love: clean up waterways and coastlines and protect green spaces for our kids."
     },
     {
      "_key": "227mFCOl8uclHuS5roWIbh",
      "name": "Priority 3",
      "value": "Give people a real say: make sure communities are heard on housing, transport and infrastructure."
     }
    ],
