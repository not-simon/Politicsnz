   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWHKf",
      "name": "Why I'm standing",
      "value": "Our community deserves a strong, experienced local MP who gets things done. Since being elected in 2023, I've worked hard to deliver more classrooms, safer neighbourhoods and better public transport, including opening Westgate Bus Station as the first stage of the Northwest Busway, which National is committed to delivering. I want to build on that progress, continue advocating for local families and businesses, and build a better future for Upper Harbour."
     },
     {
      "_key": "227mFCOl8uclHuS5roWHNU",
      "name": "About me",
      "value": "The Northwest of Auckland has been my home for over a decade, and my family loves what makes Upper Harbour special. Before entering Parliament in 2023, I ran two businesses, worked in communications and public relations, led the Newmarket Business Association, and served as an Auckland Councillor and transport chair. I've since chaired the Finance and Expenditure Committee and now serve as a Minister. I bring the experience and commitment to represent Upper Harbour effectively."
     },
     {
      "_key": "227mFCOl8uclHuS5roWHQJ",
      "name": "Priority 1",
      "value": "No new taxes and a stronger economy: Cutting wasteful spending so Kiwis keep more of what they earn"
     },
     {
      "_key": "227mFCOl8uclHuS5roWHT8",
      "name": "Priority 2",
      "value": "Building the future for Upper Harbour: Delivering classrooms, transport and jobs for our community"
     },
     {
      "_key": "227mFCOl8uclHuS5roWHVx",
      "name": "Priority 3",
      "value": "Safer communities and education: Backing Police, tackling crime and teaching the basics brilliantly"
     }
    ],
