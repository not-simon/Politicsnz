     {
      "_key": "227mFCOl8uclHuS5roWHbb",
      "name": "Why I'm standing",
      "value": "I've had a lifelong interest in politics, and it has always been my intention to represent my local community and fight for those who are most vulnerable. For me, Labour is the party that most closely reflects my values. They put people first and are working to ensure every New Zealander has the opportunity to flourish."
     },
     {
      "_key": "227mFCOl8uclHuS5roWHeQ",
      "name": "About me",
      "value": "I work hard to understand communities, and I fight for them. My senior leadership experience spans education, health and ageing, leading not-for-profit organisations, professional and volunteer associations – sectors that make a real difference in people's lives. I have strong connections with Filipino, ethnic and migrant communities, as well as the LGBTQIA+ community. I am a candidate who understands and reflects that diversity."
     },
     {
      "_key": "227mFCOl8uclHuS5roWHhF",
      "name": "Priority 1",
      "value": "Advocate for jobs, training and education so everyone can build a good life in New Zealand."
     },
     {
      "_key": "227mFCOl8uclHuS5roWHk4",
      "name": "Priority 2",
      "value": "Advocate for affordable, accessible healthcare so everyone can get well and stay well."
     },
     {
      "_key": "227mFCOl8uclHuS5roWHmt",
      "name": "Priority 3",
      "value": "Advocate for policies supporting small businesses so they can do well, create jobs and grow."
     }
