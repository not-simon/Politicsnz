   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqoyvUj",
      "name": "Why I'm standing",
      "value": "I'm running for election because I care deeply about the place I call home. Born and raised in Mount Maunganui, I'm proud of what I've achieved as the local MP over the past three years, but there is still more to do. I want to keep delivering practical results on cost of living, infrastructure, healthcare, law and order, and education. I believe in backing aspiration, rewarding hard work, and helping local families get ahead."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyvWu",
      "name": "About me",
      "value": "I'll make a good elected representative because I'm approachable, empathetic, and committed to helping people. My involvement in the community as a former volunteer firefighter, rugby referee, hockey umpire, and cricketer has connected me with people from all walks of life and taught me the value of service. Over the past three years as MP, I've worked hard to listen, be accessible, and deliver results. Regardless of political views, I'll represent everyone in our community."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyvZ5",
      "name": "Priority 1",
      "value": "Grow our local Mt Maunganui economy to create jobs, lift wages, and help families get ahead."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyvbG",
      "name": "Priority 2",
      "value": "Deliver the local roads and infrastructure needed to keep our growing community moving."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyvdR",
      "name": "Priority 3",
      "value": "Improve access to timely healthcare, raise educational achievement, and keep our communities safe."
     }
    ],
