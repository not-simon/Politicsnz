  "candidates": [
   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqoyvhn",
      "name": "Why I'm standing",
      "value": "I was born here, like many generations of my family before me. New Zealand has always been my home, and I have never wanted to live anywhere else. I love this country and want to see us all do well economically and socially. I care about the future of New Zealand and our people. I want our future generations to live in a safe and prosperous country."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyvjy",
      "name": "About me",
      "value": "I care about our future. I am currently a second-term councillor in Western Bay. It has been a privilege to serve and defend the community I live in. I have spent my professional career in banking, managing large teams of advisers. I have established an investment business, with partners and currently run a mortgage advice business. My tertiary qualifications were attained extramurally. I know how to balance multiple priorities. I live it."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyvm9",
      "name": "Priority 1",
      "value": "Encouraging significant economic & employment growth in the Bay and regionally throughout NZ."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyvoK",
      "name": "Priority 2",
      "value": "Encouraging sensible, appropriate & enduring housing in this district & nationally. "
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyvqV",
      "name": "Priority 3",
      "value": "Ensuring councils are funded adequately to maintain and improve parks, reserves, plantings & beaches."
     }
    ],
