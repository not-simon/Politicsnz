   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqoyua7",
      "name": "Why I'm standing",
      "value": "I am standing for election because I believe New Zealand can and must do better - a society where economic and political power serves people rather than concentrated wealth and narrow self-interest. I want to help build a more cooperative and compassionate New Zealand, grounded in economic democracy, social justice and care for our environment, and committed to the happiness and all-round welfare of all."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyucI",
      "name": "About me",
      "value": "I would bring to Parliament many years of experience working for social justice, community development and economic alternatives. My work in restorative justice, community lending through the Nelson Enterprise Loan Trust, cooperative development and post-capitalist economics has taught me to listen, think independently and look beyond short-term political solutions. I would be a strong advocate for my constituents, while also seeking practical solutions that serve the wider interests of people and the environment."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyueT",
      "name": "Priority 1",
      "value": "Strengthen local health services and ensure everyone can access quality care."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyuge",
      "name": "Priority 2",
      "value": "Build affordable housing & encourage co-ops in order to reduce poverty and hardship in Nelson."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyuip",
      "name": "Priority 3",
      "value": "Grow a more self-reliant regional economy that supports communities and protects our environment."
     }
    ],
