  "candidates": [
   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqoyu7o",
      "name": "Why I'm standing",
      "value": "I stepped into politics because I want a future where Kiwi kids look back and say, 'They did right by us'."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyu9z",
      "name": "About me",
      "value": "As a mum, an immigrant and an entrepreneur, I know what it means to work hard, take a chance, and build something from the ground up. I've learned how to bring people together, listen properly, and find a way forward when people don't always agree. I care deeply about our community, and I would bring that same energy to Parliament — working hard, staying grounded, and making sure people here are heard and represented well."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyuCA",
      "name": "Priority 1",
      "value": "Improve trust in politics because people deserve fair, transparent decisions they can believe in."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyuEL",
      "name": "Priority 2",
      "value": "Back regional communities because local strengths can drive both resilience and productivity."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyuGW",
      "name": "Priority 3",
      "value": "Strengthen our natural resilience because our identity and economy depend on a healthy environment."
     }
    ],
