   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqoymzn",
      "name": "Why I'm standing",
      "value": "I believe Whangārei and Northland have enormous potential. As a former mayor, business owner and engineer, I've seen what our communities can achieve and what holds us back. I want to take that experience to Parliament, get the infrastructure and investment our region needs, create opportunities for local businesses and jobs, and ensure our young people can build their futures here."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyn1y",
      "name": "About me",
      "value": "I bring practical experience from being the former mayor of Whangārei, running businesses and working alongside our community. I listen, I'm accessible, and I'm prepared to work with people from all backgrounds to find practical solutions. I believe elected representatives must be accountable, stand up for their communities and follow through on what they promise. I know Whangārei, its people, its challenges and its potential, and I'm ready to be their strong voice in Parliament."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyn49",
      "name": "Priority 1",
      "value": "Build the four-lane highway to improve resilience, safety and unlock Northland's growth."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyn6K",
      "name": "Priority 2",
      "value": "Develop Whangārei's Special Economic Zone to attract investment and grow local businesses."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyn8V",
      "name": "Priority 3",
      "value": "Create well-paid local jobs so our young people can build their futures here."
     }
    ],
