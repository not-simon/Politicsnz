  "candidates": [
   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqoymZf",
      "name": "Why I'm standing",
      "value": "I want to be a strong voice for Whangarei to represent our people in Wellington. Whangarei is an amazing place to live, work and play and we have so much to offer. Our primary sector, deep water port, talented people and an incredible coastline. I grew up here with Northland values and our family are committed to delivering for all Northlanders. "
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoymbq",
      "name": "About me",
      "value": "Growing up in Whangarei, my values are aligned to our community. Those values are embedded in family, individual responsibility and less government interference. I also bring real-world experience to the role. Previously, as CEO of a large real estate company, I learned the value of teamwork, strategy and execution. My experience also includes working in the Middle East and graduating from the Harvard Executive Education programme."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyme1",
      "name": "Priority 1",
      "value": "To represent the people and communities of Whangārei to ensure our voices are heard in Wellington. "
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoymgC",
      "name": "Priority 2",
      "value": "Completing major infrastructure projects commenced under this National Government including 4 lanes."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoymiN",
      "name": "Priority 3",
      "value": "Growing our prosperity through economic development, job creation and marine sector opportunities."
     }
    ],
