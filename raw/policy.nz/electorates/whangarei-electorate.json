   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqoymmj",
      "name": "Why I'm standing",
      "value": "I'm motivated by the legacy we're leaving for our young people. Opportunity has consistently focused on the future of work and the effect of automation, and that forward-looking approach is why I'm standing. We need evidence-based policy that helps with affordable housing, a long-term plan for Health and Education, while protecting the Environment."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoymou",
      "name": "About me",
      "value": "I'm standing as a candidate and asking voters to party vote Opportunity. I'm here to try and raise the profile of the party locally by first listening to voters' concerns and to see if our policies can help."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoymr5",
      "name": "Priority 1",
      "value": "Healthy Oceans policy! I'm a surfer & I'd like see protection for the ocean & fisheries."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoymtG",
      "name": "Priority 2",
      "value": "Abundant Energy, Reduce reliance on imported energy, lowering energy costs & creating regional jobs."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoymvR",
      "name": "Priority 3",
      "value": "Clean up politics, Democracy works when policy serves people, not industry groups & the very wealthy."
     }
    ],
