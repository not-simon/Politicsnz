   {
    "attributes": [
     {
      "_key": "lXvsWGt582gEfwb3601XcF",
      "name": "Why I'm standing",
      "value": "I am running for Parliament because my story and political journey are deeply rooted in Auckland Central. Having cut my teeth organising at the University of Auckland to make Albert Park safer, I know real change happens when communities unite. From our high-rises to Waiheke Island, people are struggling with housing and rising living costs. I want to deliver practical solutions—increasing housing supply, improving public transport, and ensuring every family can build a future here."
     },
     {
      "_key": "lXvsWGt582gEfwb3601XhJ",
      "name": "About me",
      "value": "I'm standing because Auckland Central deserves a voice that understands both the history and the future being built together. The electorate is at a turning point. I am part of the generation leaving for overseas because they cannot find the opportunities they need. The effort to fight for a future here must be shown to be worthwhile. With a population where 50% were born overseas, the diversity of the area is its greatest strength."
     },
     {
      "_key": "lXvsWGt582gEfwb3601XmN",
      "name": "Priority 1",
      "value": "Support local businesses to get government contracts, grow exports and foster innovation"
     },
     {
      "_key": "lXvsWGt582gEfwb3601XrR",
      "name": "Priority 2",
      "value": "Champion our local arts and creative sector so they don't have to choose between art and survival."
     },
     {
      "_key": "lXvsWGt582gEfwb3601XwV",
      "name": "Priority 3",
      "value": "Ease the cost of living: cap transit fares, make GP visits free, and lower power bills."
     }
    ],
