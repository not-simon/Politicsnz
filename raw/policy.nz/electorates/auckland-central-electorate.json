    "attributes": [
     {
      "_key": "lXvsWGt582gEfwb3601W41",
      "name": "Why I'm standing",
      "value": "I am asking you to give your party vote to ACT. I want more ACT MPs who will fight to cut waste and grow the country, balance the books with no new taxes, defend equal rights, deliver better public services, cut red tape, and restore real consequences for crime. In Auckland Central, please choose whichever electorate candidate you believe will best represent the area and give your party vote to ACT."
     },
     {
      "_key": "lXvsWGt582gEfwb3601W95",
      "name": "About me",
      "value": "I'm putting NZ ahead of personal ambition and not asking you to elect me as your local MP. Give your party vote to ACT to Unlock New Zealand's potential. It means locking the left out and keeping the coalition Government in power, but ensuring that it can go further and faster on the issues that matter most to you. A party vote for ACT will re-elect the Government and make it stronger."
     },
     {
      "_key": "lXvsWGt582gEfwb3601WE9",
      "name": "Priority 1",
      "value": "Grow the economy to balance the books with no new taxes so incomes rise faster than living costs."
     },
     {
      "_key": "lXvsWGt582gEfwb3601WJD",
      "name": "Priority 2",
      "value": "Deliver better services for taxpayers: education, police, and match Australia on medicines funding."
     },
     {
      "_key": "lXvsWGt582gEfwb3601WOH",
      "name": "Priority 3",
      "value": "Make decisions based on need, not race, and with one law for all and one future together."
     }
    ],
