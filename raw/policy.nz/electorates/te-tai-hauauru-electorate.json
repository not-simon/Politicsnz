 "election": {
  "candidates": [
   {
    "attributes": [
     {
      "_key": "lXvsWGt582gEfwb3603WE5",
      "name": "Why I'm standing",
      "value": "I believe Aotearoa New Zealand can be unique in the world; a thriving multicultural nation built on a bicultural foundation, set in Te Tiriti o Waitangi. I believe in a future where the economy puts our people at its heart and respects our taiao. Where Māori futures are shaped by Māori hands, and we all advance together in a fairer, more inclusive Aotearoa."
     },
     {
      "_key": "lXvsWGt582gEfwb3603WJ9",
      "name": "About me",
      "value": "I'm dedicated to creating meaningful and real change for all Māori, as a key part of a thriving and fair Aotearoa. Born and raised in Porirua, I bring executive, investment and governance experience as CEO of a Māori charitable trust and board roles on Iwi, impact investment and economic development entities. A Fulbright Scholar and Stanford grad, I bring a diverse background in business, science, governance, finance, management and social impact investment."
     },
     {
      "_key": "lXvsWGt582gEfwb3603WOD",
      "name": "Priority 1",
      "value": "Back small businesses to grow good jobs, with decent incomes, leading to strong local economies."
     },
     {
      "_key": "lXvsWGt582gEfwb3603WTH",
      "name": "Priority 2",
      "value": "Foster an environment that promotes home ownership, with safe, warm and secure housing for whānau."
     },
     {
      "_key": "lXvsWGt582gEfwb3603WYL",
      "name": "Priority 3",
      "value": "Enable Te Tai Hauāuru's transition from fossil fuels to renewable energy infrastructure."
     }
    ],
    "party": {
     "name": "Labour Party"
    },
