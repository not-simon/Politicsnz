   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqoypd6",
      "name": "Why I'm standing",
      "value": "I've advocated for the environment for many years and want to keep using my experience and knowledge to affect meaningful change for people and planet in Parliament. I'm passionate about the promise of unity for our nation if we uphold our founding agreement Te Tiriti o Waitangi. I want to see us move towards farming practices that don't harm the environment or animals. Everyone should have access to safe drinking water as a basic right."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoypfH",
      "name": "About me",
      "value": "I have served as an opposition Green MP for three years now and contributed to stopping the resumption of live animal exports at sea, ensuring that permissible glyphosate residue levels were not raised, and challenging destructive mining of our lands and oceans. I believe I am an effective representative and would like to continue the work for another term."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyphS",
      "name": "Priority 1",
      "value": "Ensure affordable living by lowering power, food, and transport bills and taxing the super rich."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoypjd",
      "name": "Priority 2",
      "value": "Ensure healthy nature by making sure you can drink, swim, and fish in our rivers and oceans."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyplo",
      "name": "Priority 3",
      "value": "Uphold our founding agreement, celebrate our diversity, and make a thriving society for all of us."
     }
    ],
