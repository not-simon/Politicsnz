   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqoypqA",
      "name": "Why I'm standing",
      "value": "My husband, kids and I have called Waitākere home for 15 years.  I believe we need someone who will advocate for the local organisations that serve our community, for accessible healthcare and fit for purpose transport Infrastructure. Nature is such a strong part of our identity out West and I will bring a focus on ensuring the protection and preservation of our environment and growing connections that our kids have to nature."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoypsL",
      "name": "About me",
      "value": "I studied law in Auckland and then at Oxford, and I have spent my career over the last twenty years fighting for everyday New Zealanders. Whether it was in Community Law, at the Human Rights Commission, or with Amnesty International. I have always put people first, standing up for those whose voices weren't being heard. That is exactly what I will do for the people of Waitākere in Parliament."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoypuW",
      "name": "Priority 1",
      "value": "Advocating for more resources for Waitākere Hospital and the health workforce out West."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoypwh",
      "name": "Priority 2",
      "value": "Advocating for our local community services to ensure cost of living support is available."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoypys",
      "name": "Priority 3",
      "value": "Advocating for Glen Eden crossing to be prioritised for development to ensure it's safe."
     }
    ],
