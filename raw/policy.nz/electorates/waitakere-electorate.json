   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqoyozu",
      "name": "Why I'm standing",
      "value": "I'm running because I want Waitākere to be a community where families can get ahead, businesses can thrive, and people feel safe and optimistic about the future. Having lived in West Auckland for over 40 years, raised my family here and built a business, I understand both its opportunities and challenges. I want to use my experience in business, community and Parliament to be a strong, practical voice for Waitākere."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyp25",
      "name": "About me",
      "value": "I bring experience from business, community service and Parliament. I've spent more than 25 years building a family business and previously served as a Member of Parliament. I know the importance of listening, working hard and being accountable for results. West Auckland has been home for most of my life, and I'm deeply invested in its future. I would bring practical experience, strong local connections and a determination to advocate effectively for Waitākere."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyp4G",
      "name": "Priority 1",
      "value": "Improve community safety so families and businesses feel secure in their neighbourhoods"
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyp6R",
      "name": "Priority 2",
      "value": "Strengthen local health services so Waitākere families can get quality care closer to home."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyp8c",
      "name": "Priority 3",
      "value": "Support local businesses and jobs so our town centres thrive and families can get ahead."
     }
    ],
