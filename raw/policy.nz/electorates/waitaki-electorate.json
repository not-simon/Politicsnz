    "policies": []
   },
   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6dAx",
      "name": "Why I'm standing",
      "value": "I am running to promote the ACT Party vote in the Waitaki. I've been thoroughly impressed with how our ACT MPs have been able to effectively deliver on the things we campaigned on during the last three years in government, and I want to see that work continue. Our electorate has experienced parliamentarians offering us representation, I'm asking you to choose the candidate you believe is best and to give your party vote to ACT."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6dCs",
      "name": "About me",
      "value": "I have a day job, so I'm not asking you to elect me as your local MP. I am asking you to give your party vote to ACT to Lock Labour Out and unlock New Zealand's potential. To retain the current Government and ensure that it takes more direct action on the issues that matter most to you. A party vote for ACT restores the current coalition providing a stronger drive to get things done."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6dEn",
      "name": "Priority 1",
      "value": "Let farmers farm, reduce red tape, protect property rights, address rural crime, no new taxes."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6dGi",
      "name": "Priority 2",
      "value": "Deliver better services for taxpayers: education, police, and match Australia on medicines funding."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6dId",
      "name": "Priority 3",
      "value": "See decisions based on need, not identity politics, with one law for all and one future together."
     }
    ],
