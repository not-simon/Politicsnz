  "candidates": [
   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6cvb",
      "name": "Why I'm standing",
      "value": "I was not satisfied with any of the parties presently represented in Parliament."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6cxW",
      "name": "About me",
      "value": "Most of my career has been in the public sector, focussed on improving our functions and services. This requires long-term planning and evidence-based decision-making. I can offer sound experience in these areas."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6czR",
      "name": "Priority 1",
      "value": "Improving democracy: involving people in open decision-making, e.g., through citizen assemblies."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6d1M",
      "name": "Priority 2",
      "value": "Reviewing tax provisions by clear planning for what we want and how we will pay for it fairly."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6d3H",
      "name": "Priority 3",
      "value": "Balancing environmental protection with economic development."
     }
    ],
    "party": {
     "name": "Opportunity Party"
    },
