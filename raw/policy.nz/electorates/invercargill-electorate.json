    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWF6M",
      "name": "Why I'm standing",
      "value": "Let's make New Zealand clean and green again."
     },
     {
      "_key": "227mFCOl8uclHuS5roWF9B",
      "name": "About me",
      "value": "I have huge experience with people wanting to access cannabis, grow cannabis or hemp, how to use it and also educate people."
     },
     {
      "_key": "227mFCOl8uclHuS5roWFC0",
      "name": "Priority 1",
      "value": "Legalizing cannabis, even though this is a one policy party, it leads onto other dynamics - health, education."
     },
     {
      "_key": "227mFCOl8uclHuS5roWFEp",
      "name": "Priority 2",
      "value": "Tax dollars, by legalizing cannabis tax dollars are accrued by business and tourism."
     },
     {
      "_key": "227mFCOl8uclHuS5roWFHe",
      "name": "Priority 3",
      "value": "Repeal the Misuse of Drugs Act. Replace the pine with hemp or incorporate hemp to repair the land."
     }
    ],
