   },
   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWEVf",
      "name": "Why I'm standing",
      "value": "I want all of those living in Aotearoa to be able to live affordable lives, to be able to live in a country where nature thrives and where local communities are properly involved in decision-making that will impact on them."
     },
     {
      "_key": "227mFCOl8uclHuS5roWEYU",
      "name": "About me",
      "value": "I have lived and worked in Southland for most of my life and have held many governance and leadership roles in education, food resilience, the arts, community housing and support a community museum and community nursery. I have also volunteered as a governance mentor. I have experience in strategic planning and building collaborative solutions to problems. I enjoy outdoor pursuits and recently completed the Tour Aotearoa, the cycle ride from Cape Reinga to Bluff."
     },
     {
      "_key": "227mFCOl8uclHuS5roWEbJ",
      "name": "Priority 1",
      "value": "Establish a night shelter for Invercargill's 60+ rough sleepers and increase housing supply."
     },
     {
      "_key": "227mFCOl8uclHuS5roWEe8",
      "name": "Priority 2",
      "value": "Continue to support efforts to improve local food resilience and affordability."
     },
     {
      "_key": "227mFCOl8uclHuS5roWEgx",
      "name": "Priority 3",
      "value": "Ensure our region's health and welfare systems are funded and staffed to appropriately meet need."
     }
    ],
