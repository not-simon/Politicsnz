   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWEmb",
      "name": "Why I'm standing",
      "value": "I'm a proud Waihopai/Invercargill community advocate with more than a decade of leadership in food security, disability inclusion, housing, and whānau wellbeing. I am standing to champion the issues that matter most to our community. I want to ensure OUR voices are heard at the decision-making table. My work has always been grounded in people: supporting whānau, creating opportunities, strengthening community connections, and advocating for those too often left behind."
     },
     {
      "_key": "227mFCOl8uclHuS5roWEpQ",
      "name": "About me",
      "value": "I believe our community deserves leadership which is grounded in grassroots knowledge and understanding of our community. My passion is in creating equitable outcomes for people who live with the challenges of disability. It is in advocating for our seniors to enable them to live rich and fulfilling lives in their golden years. It is in ensuring that our community is resilient through food sovereignty. It is about changing aspiration into action. Better Starts Now"
     },
     {
      "_key": "227mFCOl8uclHuS5roWEsF",
      "name": "Priority 1",
      "value": "Be accessible to constituents, remain connected to community groups and advocate effectively."
     },
     {
      "_key": "227mFCOl8uclHuS5roWEv4",
      "name": "Priority 2",
      "value": "Food resilience and Kai Sovereignty for our people prioritized over globally insecure marketplaces"
     },
     {
      "_key": "227mFCOl8uclHuS5roWExt",
      "name": "Priority 3",
      "value": "Thriving small/med businesses, which flow into jobs, homes, edu-training and affordable living."
     }
    ],
