  "candidates": [
   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWUJ6",
      "name": "Why I'm standing",
      "value": "I am asking you to give your party vote to ACT. I want more ACT MPs who will fight to cut waste and grow the country, balance the books with no new taxes, defend equal rights, deliver better public services, cut red tape, and restore real consequences for crime. In our electorate, I'm asking you to choose whichever electorate candidate you believe will best represent the area and give your party vote to ACT."
     },
     {
      "_key": "227mFCOl8uclHuS5roWULv",
      "name": "About me",
      "value": "I'm not asking you to elect me as your local MP; I'm asking you to give your party vote to ACT to Lock Labour Out and Unlock New Zealand's potential. It means keeping the coalition Government in power, but ensuring that it can go further and faster on the issues that matter most to you. A party vote for ACT will re-elect the Government and make it stronger. I am a current list MP."
     },
     {
      "_key": "227mFCOl8uclHuS5roWUOk",
      "name": "Priority 1",
      "value": "Let farmers farm, cut red tape, protect property rights, crack down on rural crime, no new taxes."
     },
     {
      "_key": "227mFCOl8uclHuS5roWURZ",
      "name": "Priority 2",
      "value": "Deliver better services for taxpayers: education, police, and match Australia on medicines funding."
     },
     {
      "_key": "227mFCOl8uclHuS5roWUUO",
      "name": "Priority 3",
      "value": "Make decisions based on need, not race, and with one law for all and one future together."
     }
    ],
