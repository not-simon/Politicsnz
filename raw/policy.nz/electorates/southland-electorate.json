   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWTiP",
      "name": "Why I'm standing",
      "value": "I'm running because I care deeply about Southland and the people who call it home. I've spent my life working, raising a family, building businesses and being involved in our local communities. I've seen first-hand the challenges our rural and regional communities face. I want to take that practical experience to Parliament, listen to the people of Southland, stand up for our region and make sure our voice is heard loud and clear."
     },
     {
      "_key": "227mFCOl8uclHuS5roWTlE",
      "name": "About me",
      "value": "I am not a career politician; I'm a grassroots Kiwi, that brings real-life experience to the table. We need more New Zealanders in Wellington that understand life's real pressures, and have experience in solution-focused outcomes, not ideological views based on predictions and modeling. We need people that understand how to manage budgets and can pivot when you need to. Doing what is right, not what's easy, no matter how hard the task."
     },
     {
      "_key": "227mFCOl8uclHuS5roWTo3",
      "name": "Priority 1",
      "value": "Infrastructure: better roads, reliable energy and infrastructure that unlocks Southland's potential."
     },
     {
      "_key": "227mFCOl8uclHuS5roWTqs",
      "name": "Priority 2",
      "value": "Productive economy: back farmers, businesses and industry by cutting red tape and growing our economy."
     },
     {
      "_key": "227mFCOl8uclHuS5roWTth",
      "name": "Priority 3",
      "value": "Listen to Southlanders, strengthen local communities and put local voices at the heart of decisions."
     }
    ],
