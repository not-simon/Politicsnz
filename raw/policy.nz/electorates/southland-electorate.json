   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWTRT",
      "name": "Why I'm standing",
      "value": "I am campaigning for the party vote for Opportunity to be part of a team that focuses on building consensus for long-term, structural plans so New Zealand can actually move forward, rather than continue on its decades-long trajectory of managed decline. I want to co-create a country that uses technology to protect its sovereignty, enrich its people, and preserve our natural environment."
     },
     {
      "_key": "227mFCOl8uclHuS5roWTUI",
      "name": "About me",
      "value": "I am a public health researcher and policy writer who has spent years building cross-Party consensus to achieve legislative outcomes. I have proven myself a very effective advocate even with limited resources. I understand the Parliamentary process, and as a list MP will be prepared to work constructively with whoever is in power to improve the material conditions for people living in the Southland electorate. As Opportunity says, \"We are our results.\""
     },
     {
      "_key": "227mFCOl8uclHuS5roWTX7",
      "name": "Priority 1",
      "value": "Take pressure off ratepayers: restrict Fast-track, fund innovation, infrastructure and conservation."
     },
     {
      "_key": "227mFCOl8uclHuS5roWTZw",
      "name": "Priority 2",
      "value": "Electrify everything to save money, establish energy sovereignty, and benefit our health."
     },
     {
      "_key": "227mFCOl8uclHuS5roWTcl",
      "name": "Priority 3",
      "value": "Cap political donations and regulate lobbying."
     }
    ],
