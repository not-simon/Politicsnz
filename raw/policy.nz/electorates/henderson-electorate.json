   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqozEjx",
      "name": "Why I'm standing",
      "value": "I'm standing for ACT because I believe in individual freedom and responsibility, smaller government, free markets, and equal rights for all—values increasingly under pressure."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqozEm8",
      "name": "About me",
      "value": "I'm prioritizing New Zealand's future over personal ambition. I'm not asking for your vote to become your local MP. Instead, I ask you to give your party vote to ACT to keep Labour out and unlock New Zealand's potential. This will help maintain the coalition Government's stability while enabling it to make faster progress on the issues that matter most. Voting for ACT will re-elect the Government and strengthen it."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqozEoJ",
      "name": "Priority 1",
      "value": "Grow the economy to balance the books with no new taxes so incomes rise faster than living costs."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqozEqU",
      "name": "Priority 2",
      "value": "Deliver better services for taxpayers: education, police, and match Australia on medicines funding."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqozEsf",
      "name": "Priority 3",
      "value": "Make decisions based on need, not race, and with one law for all and one future together."
     }
    ],
