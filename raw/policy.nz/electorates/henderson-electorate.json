  "candidates": [
   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqozESX",
      "name": "Why I'm standing",
      "value": "I joined The Opportunity Party in 2022 because I believe we can do better. Through my experience in engineering, project management, and public policy, I have seen the challenges and opportunities facing our communities. I am standing to help build a fairer, more prosperous country through practical, evidence-based solutions and accountable leadership. Most importantly, I want future generations to enjoy equal or greater opportunities, ensuring every New Zealander has the chance to thrive and contribute."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqozEUi",
      "name": "About me",
      "value": "I will be a good elected representative because I bring proven leadership, practical problem-solving skills, and a commitment to serving people. Through my experience leading teams in engineering, project management, and public policy, I have learned how to listen, work collaboratively, and deliver results. Having lived and worked across New Zealand, I understand the challenges facing our communities."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqozEWt",
      "name": "Priority 1",
      "value": "Making housing more affordable and reducing living costs so West Auckland families can get ahead."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqozEZ4",
      "name": "Priority 2",
      "value": "Investing in transport and infrastructure to reduce congestion and improve connectivity."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqozEbF",
      "name": "Priority 3",
      "value": "Creating quality jobs, apprenticeships, and training pathways for future generations."
     }
    ],
