   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqozEFT",
      "name": "Why I'm standing",
      "value": "I am here to help build thriving communities, and am proud to be the local candidate for Henderson. This is where I live, shop, walk my dog, and am raising my young family. I believe in 'nothing about us without us', which guides my fight for fat liberation, Te Tiriti, systemic change, and disability rights. If you care about people and planet, Party Vote Green this election."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqozEHe",
      "name": "About me",
      "value": "I have worked as an advocate, evaluator, gig worker, and parent, and have a master's degree in green criminology. I have experience in governance, policy, non-profits, and businesses of all sizes. Recently, I've worked for sport and rainbow charitable organisations, where I channel my passion for equitable access and wellbeing for every community. I care about getting things done, and rebuilding our systems so they serve and support all of us."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqozEJp",
      "name": "Priority 1",
      "value": "Ensure our healthcare system is well-resourced, inclusive, properly supported and accessible."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqozEM0",
      "name": "Priority 2",
      "value": "Centre tino rangatiratanga in our climate action and adaptation, supporting grassroots solutions."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqozEOB",
      "name": "Priority 3",
      "value": "Tax the mega-rich to ensure all of us have what we need to live good, dignified lives."
     }
    ],
