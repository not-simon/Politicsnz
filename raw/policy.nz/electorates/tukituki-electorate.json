   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6ePj",
      "name": "Why I'm standing",
      "value": "I am a proud conservation advocate, mum of two, business owner, and landowner. The past three years have galvanised my resolve to protect our land, waterways, and natural spaces and make the world a better place for the next generation. I am standing for Opportunity because I believe we have the strongest environmental policies and the best chance to implement long-term change in this and other fields, while also having a thriving economy."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6eRe",
      "name": "About me",
      "value": "I am down to earth, pragmatic, honest and tough. Although I am new to politics, like the rest of the Opportunity candidates I believe this is our strength as we are connected to community without being jaded by the political system - it is time for a fresh voice. We are here as disruptors this election and if you trust us with your party vote, we aim to promote unity, innovation, and nature in Parliament."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6eTZ",
      "name": "Priority 1",
      "value": "Address the cost of living by advocating for a fairer tax system and universal basic income."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6eVU",
      "name": "Priority 2",
      "value": "Be a staunch advocate for strong environmental guardrails for the land, rivers, oceans in our rohe."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6eXP",
      "name": "Priority 3",
      "value": "Facilitate the next booming Hawke's Bay economy through innovation and support for small business."
     }
    ],
