   {
    "attributes": [
     {
      "_key": "lXvsWGt582gEfwb3601TCl",
      "name": "Why I'm standing",
      "value": "I want New Zealand to be an affordable and fair place for my kids – doing my best for them means fighting for all families to have affordable healthcare, for our young people to have jobs, for our workers to be paid a decent wage and an environment that we care for as kaitiaki."
     },
     {
      "_key": "lXvsWGt582gEfwb3601THp",
      "name": "About me",
      "value": "I live in Manurewa with my two young children and husband. I am of Te Aitanga-a-Māhaki, Ngāi Tahu and Ngāi Tūhoe. Before I was an MP I was a lawyer, a community advocate and a mum. As your local MP I've been working hard for the last six years for our community: cleaning up rubbish, helping people to access Government services, and being your voice in Parliament."
     },
     {
      "_key": "lXvsWGt582gEfwb3601TMt",
      "name": "Priority 1",
      "value": "Real action on the cost of living; affordable and accessible healthcare; and good jobs for people"
     },
     {
      "_key": "lXvsWGt582gEfwb3601TRx",
      "name": "Priority 2",
      "value": "Support Manurewa families to access Government support (housing, healthcare, immigration, etc)"
     },
     {
      "_key": "lXvsWGt582gEfwb3601TX1",
      "name": "Priority 3",
      "value": "Clean local environment and healthy Puhinui Stream, and local improvements that our community needs"
     }
    ],
