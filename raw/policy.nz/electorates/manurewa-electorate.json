  "candidates": [
   {
    "attributes": [
     {
      "_key": "lXvsWGt582gEfwb3601UBX",
      "name": "Why I'm standing",
      "value": "I am standing for NZ First because I believe in its founding principles of putting New Zealand and New Zealanders first. I believe in one law for all, accountable government policies that strengthen our economy. I share the party's goal, bringing back common sense to government and ensuring our nation's future is guided by fairness, opportunity and self reliance. I bring voices and perspectives that will strengthen the party's connection with communities that may feel overlooked."
     },
     {
      "_key": "lXvsWGt582gEfwb3601UGb",
      "name": "About me",
      "value": "As a New Zealand born of Samoan decent, I have lived the real challenges that many families face. I know the struggle is real. I understand what it means to work hard, build a business and give back through community involvement. I offer diversity, authenticity and a strong community voice. My goal is to help shape policy, influence positive change and ensure all New Zealanders including our pacific communities are heard, valued and empowered."
     },
     {
      "_key": "lXvsWGt582gEfwb3601ULf",
      "name": "Priority 1",
      "value": "Cost of living - Break up the duopoly (supermarket chains) - Same with the power chains suppliers"
     },
     {
      "_key": "lXvsWGt582gEfwb3601UQj",
      "name": "Priority 2",
      "value": "Unemployment & economic pressure - Create opportunities - Support small businesses and entrepreneurs"
     },
     {
      "_key": "lXvsWGt582gEfwb3601UVn",
      "name": "Priority 3",
      "value": "Community safety - Serious action for repeat offenders - Advocate for stronger frontline policing"
     }
    ],
    "party": {
     "name": "NZ First"
    },
