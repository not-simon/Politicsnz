   {
    "attributes": [
     {
      "_key": "lXvsWGt582gEfwb3601Th9",
      "name": "Why I'm standing",
      "value": "I am running for election because, having lived in South Auckland for most of my life, I have witnessed the challenges facing domestic animals, particularly dogs and cats. I want to help strengthen prevention, education, responsible animal guardianship and access to support, while bringing animal welfare into conversations about community wellbeing and our environment. I believe animals deserve compassion, protection and a voice, and that stronger collaboration can create meaningful, practical change for our communities."
     },
     {
      "_key": "lXvsWGt582gEfwb3601TmD",
      "name": "About me",
      "value": "I will make a good elected representative because I value listening, collaboration and practical community-focused solutions. I bring almost 20 years of active Rotary service and nearly a decade of vegan advocacy, reflecting my commitment to people, animals and our planet. I want to work constructively with Council, Animal Management, SPCA, veterinary clinics, rescue groups and communities, ensuring frontline experiences are heard. I believe representation means being accessible, accountable, compassionate and willing to work together."
     },
     {
      "_key": "lXvsWGt582gEfwb3601TrH",
      "name": "Priority 1",
      "value": "Make Vet Care essential: Fund Rescue Groups, plus Clinics and De-sexing for low income families."
     },
     {
      "_key": "lXvsWGt582gEfwb3601TwL",
      "name": "Priority 2",
      "value": "Expand Government funded De-sexing and Wildlife Care as per AJP 2026 Budget Submission."
     },
     {
      "_key": "lXvsWGt582gEfwb3601U1P",
      "name": "Priority 3",
      "value": "Prevent roaming and abandonment through education, microchipping and responsible pet ownership."
     }
    ],
    "party": {
     "name": "Animal Justice Party"
    },
