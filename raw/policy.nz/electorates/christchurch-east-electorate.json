   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWKq0",
      "name": "Why I'm standing",
      "value": "I am running because democracy should belong to people daily, not just election day. Parliament operates on powers without duties, passing laws with no enforceable accountability. My motivation is not imposing my vision for Christchurch East or New Zealand, but representing yours through Binding Citizens' Initiated Referenda (0.9% threshold) and a Citizens' Accountability Chamber. These tools give you direct power to make law when Parliament fails, ensuring bottom-up accountability over top-down promises."
     },
     {
      "_key": "227mFCOl8uclHuS5roWKsp",
      "name": "About me",
      "value": "I make a good representative because I bind myself to verifiable mechanisms, making my personal traits irrelevant. My commitment is not to impose my vision for Christchurch East, but to install Binding Citizens' Initiated Referenda and a Citizens' Accountability Chamber via Standing Orders. These tools ensure accountability is procedural, giving residents direct power to hold me to account. My role is purely to transmit your mandate through established parliamentary channels."
     },
     {
      "_key": "227mFCOl8uclHuS5roWKve",
      "name": "Priority 1",
      "value": "Create system allowing the collecting of constituent voting and advocacy instructions."
     },
     {
      "_key": "227mFCOl8uclHuS5roWKyT",
      "name": "Priority 2",
      "value": "Introduce Private Member's Bill for Binding Referenda using Standing Orders"
     },
     {
      "_key": "227mFCOl8uclHuS5roWL1I",
      "name": "Priority 3",
      "value": "Audit top local issues demanding official data so that constituents may make informed decisions."
     }
    ],
