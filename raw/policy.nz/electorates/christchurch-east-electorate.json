   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWJhR",
      "name": "Why I'm standing",
      "value": "I am grateful and excited to be the MP for Christchurch East. My professional career involved producing TV shows like What Now, Fanimals and Brain Busters.  As Labour spokesperson for Science, Technology & Innovation and Broadcasting, Media and Creative Economy I'm excited by the opportunities for New Zealand.  I am committed to working with you, navigating the challenges ahead, so we can build a better, smarter and safer future for Christchurch East and New Zealand."
     },
     {
      "_key": "227mFCOl8uclHuS5roWJkG",
      "name": "About me",
      "value": "We have such strong communities across Christchurch East, and I'm committed to working with them to ensure they can thrive."
     },
     {
      "_key": "227mFCOl8uclHuS5roWJn5",
      "name": "Priority 1",
      "value": "Real action on the cost of living - too many people are working hard and struggling to get ahead."
     },
     {
      "_key": "227mFCOl8uclHuS5roWJpu",
      "name": "Priority 2",
      "value": "Support for the homeless in our community."
     },
     {
      "_key": "227mFCOl8uclHuS5roWJsj",
      "name": "Priority 3",
      "value": "Strong representation for Christchurch East communities."
     }
