   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWJQV",
      "name": "Why I'm standing",
      "value": "I have lived in the east of Christchurch almost all of my life. I have watched this community carry the cost of decisions made somewhere else. I am standing for the Alliance because the east needs more well-funded public services and greater public ownership that people here can rely on."
     },
     {
      "_key": "227mFCOl8uclHuS5roWJTK",
      "name": "About me",
      "value": "I have spent my working life making systems work for the people who rely on them, with a main focus on health systems and data. Outside of work, I pitch in where I can with local charities and public-good initiatives. I will bring the same approach to Parliament."
     },
     {
      "_key": "227mFCOl8uclHuS5roWJW9",
      "name": "Priority 1",
      "value": "Fight for more GPs and free visits in the east, because too many here can't see a doctor when sick."
     },
     {
      "_key": "227mFCOl8uclHuS5roWJYy",
      "name": "Priority 2",
      "value": "Push for faster, more frequent buses in the east, because we deserve good public transport."
     },
     {
      "_key": "227mFCOl8uclHuS5roWJbn",
      "name": "Priority 3",
      "value": "Build more state homes in Linwood and Aranui, because rents here eat too much of working incomes."
     }
    ],
