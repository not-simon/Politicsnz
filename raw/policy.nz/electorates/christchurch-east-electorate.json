   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWKFJ",
      "name": "Why I'm standing",
      "value": "I believe Aotearoa New Zealand is the best country in the world because of the richness of our Māori heritage, whakapapa, whānau and whenua. We have the taonga of Te Tiriti o Waitangi, a foundation that can protect and strengthen all of us. We are blessed with incredible whenua, natural resources, te reo Māori and a culture that is unique to this place."
     },
     {
      "_key": "227mFCOl8uclHuS5roWKI8",
      "name": "About me",
      "value": "I bring more than 30 years of experience in health, journalism, broadcasting, education, advocacy and community work. I've supported whānau through complex challenges, advocated for Smokefree Aotearoa, pay equity and Te Tiriti, and mobilised communities across the South Island. I care deeply for our whenua and regularly lead clean ups in our rohe. As a Canterbury sportswoman and youngest of seven, I bring resilience, teamwork, practical problem solving and a strong commitment to serving our communities."
     },
     {
      "_key": "227mFCOl8uclHuS5roWKKx",
      "name": "Priority 1",
      "value": "Warm, dry, secure and affordable homes with enough income to live with dignity."
     },
     {
      "_key": "227mFCOl8uclHuS5roWKNm",
      "name": "Priority 2",
      "value": "Accessible healthcare, stronger mental health support, inclusive education, disability services."
     },
     {
      "_key": "227mFCOl8uclHuS5roWKQb",
      "name": "Priority 3",
      "value": "Protect our water ways so they are safe to drink, swim and fish."
     }
    ],
