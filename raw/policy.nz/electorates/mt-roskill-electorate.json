   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6X6l",
      "name": "Why I'm standing",
      "value": "I'm running for Parliament because I want our country to prosper. We need more people who have common sense, understand how the economy works, what it's like to run a real business, and how to achieve genuine progress in Parliament. I chose to make New Zealand my home because I saw its enormous opportunities. I'm passionate about making New Zealand even greater."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6X8g",
      "name": "About me",
      "value": "I will make a good elected representative because I bring real-world experience, not just political theory. As a construction business owner and immigrant investor, I understand what encourages people to invest, create jobs and build their future in New Zealand. I know how we can attract more productive investment and drive economic growth. I will listen, speak honestly, use common sense and work hard to deliver real results for the people I represent."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6XAb",
      "name": "Priority 1",
      "value": "Support local businesses by cutting red tape, creating jobs and prosperity for Mt Roskill."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6XCW",
      "name": "Priority 2",
      "value": "Back Police and hold offenders accountable, so Mt Roskill families and businesses feel safe."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6XER",
      "name": "Priority 3",
      "value": "Make decisions so that all people in Mt Roskill are treated the same not based on race."
     }
    ],
