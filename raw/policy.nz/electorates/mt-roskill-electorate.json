   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6Wjj",
      "name": "Why I'm standing",
      "value": "I am running for Opportunity because it has a plan for a prosperous New Zealand. As a party committed to being a consistent voice in parliament for long-term change, Opportunity will be able to work across the political divide on real solutions to our problems. By cleaning up politics, abundant renewable energy, and getting R&D spending up to 2% of GDP, we can turn our stalling economy around and get the cost of living under control."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6Wle",
      "name": "About me",
      "value": "We are running a party vote campaign only in Mt Roskill. If you can only give Opportunity one of your votes, that should be the party vote! If elected, I would make a good representative due to my experience working in diverse roles in the technology sector. These roles have given me strong interpersonal skills for building relationships and a deep understanding of complex systems. I would work tirelessly to deliver long-term change for NZ."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6WnZ",
      "name": "Priority 1",
      "value": "Deliver Abundant Energy. Electrification will deliver clean, affordable energy for our homes."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6WpU",
      "name": "Priority 2",
      "value": "Clean Up Politics. Shift lobbying into the daylight and get big money out of politics."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6WrP",
      "name": "Priority 3",
      "value": "Build a Breakthrough Economy. Fund science, stand up for fairness and back small businesses."
     }
    ],
