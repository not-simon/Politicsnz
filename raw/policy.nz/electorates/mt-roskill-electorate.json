  "candidates": [
   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6WvF",
      "name": "Why I'm standing",
      "value": "Mt Roskill has given me and my family our start in life and I am running to fight for the community I love. Working people in Mt Roskill need an MP and government who will give them a fair shot - decent jobs, fair pay, good public schools and hospitals, and action on the cost of living. I am experienced and get things done. As your MP I will fight for Mt Roskill."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6WxA",
      "name": "About me",
      "value": "I've lived in Mt Roskill for 23 years and know this community at the street level. In public life I've served on the Local Board, as MP, and as a senior cabinet minister. This experience makes me an effective advocate who can get things done. I've devoted my life to public service and fighting for working people and having been through ups and downs I am fearless about speaking up for Mt Roskill."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6Wz5",
      "name": "Priority 1",
      "value": "Building affordable homes for Mt Roskill families, including public housing."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6X10",
      "name": "Priority 2",
      "value": "Taking action on the cost of living to help local households and small businesses."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6X2v",
      "name": "Priority 3",
      "value": "Speaking up for fair pay, pay equity, and decent jobs for everyone in Mt Roskill."
     }
    ],
    "party": {
     "name": "Labour Party"
    },
