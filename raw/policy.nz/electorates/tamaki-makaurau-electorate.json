 "election": {
  "candidates": [
   {
    "attributes": [
     {
      "_key": "lXvsWGt582gEfwb3603dzD",
      "name": "Why I'm standing",
      "value": "My political journey was inspired by the struggles of our people. I am running for Parliament because I believe our people deserve strong representation that can deliver for Tāmaki Makaurau. Representation that honours Te Tiriti o Waitangi. With your support, I will take the values of our whānau and our communities to Parliament. I am asking for your vote to create a better future for our mokopuna."
     },
     {
      "_key": "lXvsWGt582gEfwb3603e4H",
      "name": "About me",
      "value": "My political journey began at Waimanoni Marae, grounded in whakapapa, whānau and the values that shape who I am. Guided by kaumatua, I will bring good outcomes and accountable representation to Parliament. I will be in the ground in communities, honour Te Tiriti o Waitangi, and advocate for housing, health, and opportunity. Together, we can strengthen whānau, uphold our voices and build a fairer future where Māori aspirations are supported and every generation can thrive."
     },
     {
      "_key": "lXvsWGt582gEfwb3603e9L",
      "name": "Priority 1",
      "value": "Zero homelessness-affordable, secure and healthy housing so every whānau has a safe place to live and thrive."
     },
     {
      "_key": "lXvsWGt582gEfwb3603eEP",
      "name": "Priority 2",
      "value": "Health: Support accessible, equitable healthcare that improves outcomes for Māori."
     },
     {
      "_key": "lXvsWGt582gEfwb3603eJT",
      "name": "Priority 3",
      "value": "Opportunities: Invest in more full Emerson , skills and pathways to employment."
     }
    ],
