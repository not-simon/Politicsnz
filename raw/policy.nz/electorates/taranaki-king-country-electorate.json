   },
   {
    "attributes": [
     {
      "_key": "MBeO7ojrohBwl7F7zAPcJ0",
      "name": "Why I'm standing",
      "value": "I'm standing as your New Zealand First candidate for Taranaki–King Country because I believe our communities deserve a strong, independent voice in Parliament. I want to stand up for people who work hard, raise families and contribute to our towns and rural communities. Local decision-making should stay local, with communities having a real say in their future. I want common sense restored at every level, practical solutions delivered, waste reduced, and New Zealanders put first."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAPcLq",
      "name": "About me",
      "value": "Born and bred in the TKC electorate, I have deep roots and a genuine understanding of the people and communities I seek to represent. As a small business owner, former dairy farmer, mother, grandmother, and through years of rural advocacy, I understand the pressures facing families, farmers and businesses. I'm solutions-focused, practical and prepared to challenge red tape and productivity-killing legislation. I will listen, advocate strongly and deliver outcomes for our communities and New Zealand. "
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAPcOg",
      "name": "Priority 1",
      "value": "Exit the Paris Accord. Protect our rural economy and farmers. Cut red tape and back productivity."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAPcRW",
      "name": "Priority 2",
      "value": "Secure affordable energy. Create regional jobs & encourage growth by using our own resources."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAPcUM",
      "name": "Priority 3",
      "value": "Keep local decisions local. Ensure decisions affecting us are made by people who live and work here."
     }
    ],
