 "election": {
  "candidates": [
   {
    "attributes": [
     {
      "_key": "MBeO7ojrohBwl7F7zAPc1y",
      "name": "Why I'm standing",
      "value": "I am asking you to give your party vote to ACT.  I would like more ACT MPs fighting for a New Zealand where our children can thrive — with equal rights, a great education, functioning health services and safe communities to grow up in.  In our electorate, I'm asking you to choose whichever electorate candidate you believe will best represent the area and give your party vote to ACT."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAPc4o",
      "name": "About me",
      "value": "I'm putting NZ ahead of personal ambition. I'm not asking you to elect me as your local MP. I'm asking you to give your party vote to ACT to Lock Labour Out and unlock New Zealand's potential. It means keeping the coalition Government in power, but ensuring that it can go further and faster on the issues that matter most to you. A party vote for ACT will re-elect the Government and make it stronger."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAPc7e",
      "name": "Priority 1",
      "value": "Grow the economy to balance the books with no new taxes so incomes rise faster than living costs."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAPcAU",
      "name": "Priority 2",
      "value": "Deliver better services for taxpayers especially in healthcare & access to more funded medicines."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAPcDK",
      "name": "Priority 3",
      "value": "Make decisions based on need, not race, and with one law for all and one future together."
     }
    ],
    "party": {
     "name": "ACT Party"
    },
