  "candidates": [
   {
    "attributes": [
     {
      "_key": "lXvsWGt582gEfwb3603T7d",
      "name": "Why I'm standing",
      "value": "This election, I am running to be the independent voice of Te Tai Tonga. Uncompromised by party politics and accountable only to the people. I will continue to stand up for Te Tiriti o Waitangi, rangatiratanga and constitutional change, while challenging a political system that too often leaves our whānau behind. I am running to put people first and to advance outcomes for Te Tai Tonga."
     },
     {
      "_key": "lXvsWGt582gEfwb3603TCh",
      "name": "About me",
      "value": "Over the past three years we have connected with whānau across Te Tai Tonga including pulling together the hīkoi against the Treaty Principles Bills from Bluff to Pōneke. We have provided an education platform on social media to raise awareness of Te Tiriti o Waitangi, spoken truth to legislation and have spoken out against this Government's anti-Māori agenda. I commit to continuing that work, and take the voice of Te Tai Tonga to Paremata."
     },
     {
      "_key": "lXvsWGt582gEfwb3603THl",
      "name": "Priority 1",
      "value": "Tangata, our people are our wealth. Restore rangatiratanga in community and grow our potential."
     },
     {
      "_key": "lXvsWGt582gEfwb3603TMp",
      "name": "Priority 2",
      "value": "Te Tiriti, the foundation of all constitutional rights in Aotearoa. Equity rises for all when upheld."
     },
     {
      "_key": "lXvsWGt582gEfwb3603TRt",
      "name": "Priority 3",
      "value": "Taiao, we must not let extraction of its resources be the economic solution. We must protect it."
     }
    ],
    "party": {
     "name": "Independent"
    },
