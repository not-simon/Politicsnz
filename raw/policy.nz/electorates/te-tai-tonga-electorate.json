   {
    "attributes": [
     {
      "_key": "lXvsWGt582gEfwb3603SYB",
      "name": "Why I'm standing",
      "value": "I believe everyone in Aotearoa can enjoy a good life and a healthy environment and that everyone should be treated with dignity and respect. New Zealanders have a proud history of fairness, kindness and looking out for each other but these values are under attack and need protecting. I am standing for the Green Party because we are strongly committed to evidence-led inclusive policy that empowers all people and the planet to flourish."
     },
     {
      "_key": "lXvsWGt582gEfwb3603SdF",
      "name": "About me",
      "value": "I have studied, worked in Te Tai Tonga rohe for most of my life, have raised my two sons here, and have enjoyed much of its beautiful wilderness areas. I bring expertise in public health nutrition research, focused on Māori wellbeing and achieving equitable health outcomes through evidence-led, Māori-centred transformative solutions. I am an outspoken champion for policies that protect our communities from unhealthy commodities including junk food and drinks, alcohol, tobacco products and vapes."
     },
     {
      "_key": "lXvsWGt582gEfwb3603SiJ",
      "name": "Priority 1",
      "value": "Reducing the cost of living through more affordable housing, kai, transport and energy."
     },
     {
      "_key": "lXvsWGt582gEfwb3603SnN",
      "name": "Priority 2",
      "value": "Protecting our wai to make sure we continue to have clean water to drink, swim and fish in."
     },
     {
      "_key": "lXvsWGt582gEfwb3603SsR",
      "name": "Priority 3",
      "value": "An education system that uplifts tauira Māori by valuing te reo, Te Tiriti and mātauranga Māori."
     }
    ],
