   },
   {
    "attributes": [
     {
      "_key": "lXvsWGt582gEfwb3603Tc1",
      "name": "Why I'm standing",
      "value": "I believe New Zealand is ready for drug reform, as shown in the 2020 referendum, 48.4% voted for change. People should not be criminalised over a plant. Prohibition does not work. Legalisation can grow the economy and lower the crime rate. Hemp should come under Ministry of Primary Industry not Ministry of Health. Changing hemp status will grow our GDP, the whole plant could be utilised for housing, agriculture, food production and other industrial uses."
     },
     {
      "_key": "lXvsWGt582gEfwb3603Th5",
      "name": "About me",
      "value": "I have spent most of my life in Te Tai Tonga, from Invercargill to Christchurch. I have been a recreational user of cannabis, have made and used rongoa for a few years for myself and others. I found the pathway to medical cannabis very costly. It did not make sense to me, I had to see a 'practitioner' to gain a prescription I could make myself. I am pro choice."
     },
     {
      "_key": "lXvsWGt582gEfwb3603Tm9",
      "name": "Priority 1",
      "value": "To make cannabis legal. To expunge all cannabis convictions."
     },
     {
      "_key": "lXvsWGt582gEfwb3603TrD",
      "name": "Priority 2",
      "value": "Create a strong cannabis and hemp industry."
     },
     {
      "_key": "lXvsWGt582gEfwb3603TwH",
      "name": "Priority 3",
      "value": "Improve the lives of Māori and lower income whanau improving health, housing and growing the economy."
     }
    ],
    "party": {
     "name": "Aotearoa Legalise Cannabis Party"
    },
