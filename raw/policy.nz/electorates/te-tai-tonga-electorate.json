   {
    "attributes": [
     {
      "_key": "lXvsWGt582gEfwb3603S3n",
      "name": "Why I'm standing",
      "value": "I am standing because Te Tai Tonga deserves a voice for the people. I want to bring those voices into Parliament and make sure decisions are made with our whānau, not done to them. For me this is about our mokpuna, and about getting practical things moving for our communities."
     },
     {
      "_key": "lXvsWGt582gEfwb3603S8r",
      "name": "About me",
      "value": "What I can offer is my connection to communities, my commitment to whānau and the courage to speak up when our people are being ignored. I am ready to listen, do the work and stay accountable to the whānau who put me there."
     },
     {
      "_key": "lXvsWGt582gEfwb3603SDv",
      "name": "Priority 1",
      "value": "We will protect and entrench Te Tiriti, and progress constitutional transformation."
     },
     {
      "_key": "lXvsWGt582gEfwb3603SIz",
      "name": "Priority 2",
      "value": "We will ensure that whānau have access to secure housing, affordable kai, power, and health services."
     },
     {
      "_key": "lXvsWGt582gEfwb3603SO3",
      "name": "Priority 3",
      "value": "We will put more money in the pockets of low- and middle-income workers by changing the tax system."
     }
    ],
