   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWddj",
      "name": "Why I'm standing",
      "value": "I'm standing again to represent our amazing communities in Parliament, to champion local interests and ensure our voices are heard in Wellington. I believe in Rangitīkei and the people who call our part of the world home. I'm proud of what I've achieved as your local MP. I'm seeking your support so I can continue to advocate for what matters to you and your family - economic growth, better health and education and safer communities."
     },
     {
      "_key": "227mFCOl8uclHuS5roWdgY",
      "name": "About me",
      "value": "Rangitīkei has been my home for 30 years. It's where Rich and I raised our three now adult children, at 'Tunnel Hill', a sheep and beef farm in Turakina. We built our business, 'Coastal Lamb' from scratch here, with Rangitīkei at its heart. I'm a proven advocate, grounded by strong practical, commercial and community experience. I care about people - and I care about getting results for you and your family."
     },
     {
      "_key": "227mFCOl8uclHuS5roWdjN",
      "name": "Priority 1",
      "value": "Cost of Living - grow the economy to create jobs and increase wages."
     },
     {
      "_key": "227mFCOl8uclHuS5roWdmC",
      "name": "Priority 2",
      "value": "Healthcare - increase the availability of after-hours healthcare services across the Rangitīkei."
     },
     {
      "_key": "227mFCOl8uclHuS5roWdp1",
      "name": "Priority 3",
      "value": "Education - ensure our kids attend school regularly and are taught the basics brilliantly."
     }
    ],
