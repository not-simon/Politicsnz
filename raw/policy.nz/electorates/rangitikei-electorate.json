   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWdMn",
      "name": "Why I'm standing",
      "value": "After 24 years in Police, running businesses and serving my community as a councillor, I know the pressures facing everyday New Zealanders. I am standing for NZ First because I believe in putting New Zealanders first. One flag. One country. One people. Enough of woke politics and billions sent offshore. Let's build our own wealth, develop our resources responsibly, strengthen law and order and put our communities first."
     },
     {
      "_key": "227mFCOl8uclHuS5roWdPc",
      "name": "About me",
      "value": "24 yrs serving as a Police Officer, experience running businesses, and years of local government experience as a councillor. I understand accountability, leadership and the importance of listening to people and getting things done. I have strong connections across Rangitikei, raising my family here and understand the issues facing our rural communities, families, farmers, workers and small businesses. I believe in common sense, equal rights, personal responsibility, law and order and putting New Zealanders first."
     },
     {
      "_key": "227mFCOl8uclHuS5roWdSR",
      "name": "Priority 1",
      "value": "Bring down the cost of living by breaking up the gentailers of electricity and supermarket duopoly."
     },
     {
      "_key": "227mFCOl8uclHuS5roWdVG",
      "name": "Priority 2",
      "value": "Increase Police resources and focus less on paperwork and more on frontline property crime."
     },
     {
      "_key": "227mFCOl8uclHuS5roWdY5",
      "name": "Priority 3",
      "value": "Leave the Paris Accord and help farmers without overbearing regulation hamstringing their business."
     }
    ],
