   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWcov",
      "name": "Why I'm standing",
      "value": "I believe there is enough wealth in Aotearoa for everyone to lead a good life. But everyone needs to pay their fair share. We need to look after the forests, soil, air and water to sustain us and future generations. We need to honour Te Tiriti and ensure that power and wealth sit with our communities. For all of us."
     },
     {
      "_key": "227mFCOl8uclHuS5roWcrk",
      "name": "About me",
      "value": "My focus is on the Green's party vote. I ran my own financial planning business and have a strong interest in politics and economics. Social justice has always been important to me. Touring NZ for a year on motorcycles, Lynne and I witnessed the horrifying degradation of our taiao, entrenched poverty and the concentration of wealth. This experience strongly informs my political commitment."
     },
     {
      "_key": "227mFCOl8uclHuS5roWcuZ",
      "name": "Priority 1",
      "value": "My first priority is to alleviate the cost of living crisis."
     },
     {
      "_key": "227mFCOl8uclHuS5roWcxO",
      "name": "Priority 2",
      "value": "To protect our agriculture against extreme weather.  "
     },
     {
      "_key": "227mFCOl8uclHuS5roWd0D",
      "name": "Priority 3",
      "value": "To protect our agriculture   international market access."
     }
    ],
