   {
    "attributes": [
     {
      "_key": "MBeO7ojrohBwl7F7zAOpPG",
      "name": "Why I'm standing",
      "value": "I want to do my part to create a better future for my children and future generations. I love my country and I am proud of my New Zealand heritage. I believe that all New Zealanders should be treated equally, with one law for all, regardless of ethnicity, gender or belief. We should put the interests of New Zealanders first and I'm determined to fight for the rights of everyday Kiwi Mums and Dads."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOpS6",
      "name": "About me",
      "value": "I am a proud dad of a large family. I have worked in the construction industry as a plumber, gasfitter and drainlayer for the last 27 years. As a parent and working-class Kiwi, I understand all too well the pressures that face everyday New Zealanders. We need politicians to represent us that have real life practical experience and who can come up with common-sense practical solutions to the problems facing us today."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOpUw",
      "name": "Priority 1",
      "value": "Ensuring that ratepayer's money is spent on the things that are necessary to the community."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOpXm",
      "name": "Priority 2",
      "value": "Promote Timaru as a great tourist destination, support local tourism attractions and opportunities."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOpac",
      "name": "Priority 3",
      "value": "Campaign for appropriate funding for road maintenance, so we can travel and trade effectively."
     }
    ],
