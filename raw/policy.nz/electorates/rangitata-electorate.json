   {
    "attributes": [
     {
      "_key": "MBeO7ojrohBwl7F7zAOpgI",
      "name": "Why I'm standing",
      "value": "Having served as your MP for the past three years, supporting constituents and advocating for Mid and South Canterbury in Wellington, I know what it takes to represent our region and deliver real results for our community. I'm focused on growing our region, creating more jobs and higher incomes, reducing the cost of living and making sure our region gets the investment we deserve."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOpj8",
      "name": "About me",
      "value": "In 2023, I was proud to be elected as the Member of Parliament for Rangitata. I'm a local boy, born and raised in Timaru with roots in both Mid and South Canterbury. In 2026, I'm once again asking for your vote to elect me as your MP for Rangitata. I'm committed to making Mid and South Canterbury the safest, best and most prosperous place to live for every family who calls it home."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOply",
      "name": "Priority 1",
      "value": "Deliver the new $140m Ashburton Bridge by the end of 2027, on time and on budget."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOpoo",
      "name": "Priority 2",
      "value": "Secure additional investment in our road, transport and logistics infrastructure network."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOpre",
      "name": "Priority 3",
      "value": "Grow our region by creating more jobs and higher incomes in agriculture, tourism and manufacturing."
     }
    ],
