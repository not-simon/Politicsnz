   {
    "attributes": [
     {
      "_key": "MBeO7ojrohBwl7F7zAOp5O",
      "name": "Why I'm standing",
      "value": "I am running for ACT because I wish to help grow its party vote to ensure as many people with the values and principles that they stand for are elected into the next government. This is important because they are the one party whose fundamental base values of personal freedom, equal rights and personal responsibility (you are responsible for your life, not the government) resonate with me."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOp8E",
      "name": "About me",
      "value": "As a chartered accountant I deal with people, their financial issues, and the compliance costs on a daily basis. I have seen the effect increased regulation has been causing including increased financial costs, and the time it is taking to just continue doing the same business. I'd like to be effective in changing some of that so that people can get on with their life. Live in the freedom and the prosperity that they deserve."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOpB4",
      "name": "Priority 1",
      "value": "Improve Road funding - ensure the user charges we pay locally are used locally. Remove barriers."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOpDu",
      "name": "Priority 2",
      "value": "Medical Care - Help reduce wait times by allowing Pharmacists to do more. Pharmac Funding - access."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOpGk",
      "name": "Priority 3",
      "value": "Environment - Work with Hunters to help control pests. Ensure DOC is focused on its own job."
     }
    ],
