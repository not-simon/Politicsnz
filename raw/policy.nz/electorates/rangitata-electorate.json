  "candidates": [
   {
    "attributes": [
     {
      "_key": "MBeO7ojrohBwl7F7zAOq0A",
      "name": "Why I'm standing",
      "value": "Growing up on a farm listening to my dad's stories sparked a lifelong interest in politics. Today, I'm standing because I believe New Zealand needs politics that is less tribal and more focused on what works. I want to help build a country where people can live with dignity, young people can get ahead, and communities can thrive. That's why I'm standing to represent Rangitata and help shape a better future for the next generation."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOq30",
      "name": "About me",
      "value": "I've spent my career helping people and organisations solve problems, deliver change, and achieve better outcomes. I listen carefully, value evidence, and enjoy working with people who hold different views. Growing up in a rural community and living and working across New Zealand has given me an appreciation for the challenges and opportunities facing our regions. I'll be an approachable, hardworking representative who focuses on practical solutions and long-term thinking."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOq5q",
      "name": "Priority 1",
      "value": "Support farming and business to create jobs, grow incomes, and strengthen our local economy."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOq8g",
      "name": "Priority 2",
      "value": "Create opportunities for young people to thrive here and older generations to retire with dignity."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOqBW",
      "name": "Priority 3",
      "value": "Restore nature and biodiversity so future generations inherit a healthier environment."
     }
    ],
    "party": {
     "name": "Opportunity Party"
    },
