   {
    "attributes": [
     {
      "_key": "MBeO7ojrohBwl7F7zAOS3W",
      "name": "Why I'm standing",
      "value": "I believe that Aotearoa can be a powerhouse of education and industry. We have the potential to lead the world and look after our people at home, but we have spent four decades labouring under the failed Rogernomic agenda.  I believe that every kiwi should have access to a job at a decent wage, a house at a fair price, and a world-class, free education."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOS6M",
      "name": "About me",
      "value": "Wellington North deserves a tireless, fiercely local representative prepared to stand up for our city in Parliament. We have been ignored by successive governments for many years. This has to change.   Two of my fellow candidates are guaranteed list seats in the next parliament, with a likely third. By giving me your electorate vote, Wellington North has a chance to gain four effective, progressive MPs for the price of one."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOS9C",
      "name": "Priority 1",
      "value": "Fighting for full employment. Every kiwi has the right to a good job at a decent wage."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOSC2",
      "name": "Priority 2",
      "value": "Increasing student allowance and making education free from ECE-Tertiary/Trades/Vocational training."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOSEs",
      "name": "Priority 3",
      "value": "Reforming Health with a Community Health Service so people get the treatment that they need, quickly"
     }
    ],
