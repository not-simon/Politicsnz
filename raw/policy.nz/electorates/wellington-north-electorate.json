   {
    "attributes": [
     {
      "_key": "MBeO7ojrohBwl7F7zAORje",
      "name": "Why I'm standing",
      "value": "We've had decades of shuffling left and right, rather than moving forwards; of parties blaming each other for the problems they inherited, without offering meaningful solutions.  Whether it's health, incomes or the environment - our country can be dramatically better - but only if we choose to do better things."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAORmU",
      "name": "About me",
      "value": "We need people in parliament who see their role as a serious responsibility, not a competition or a game. We need people who look to the next generation, not just the 3-year political cycle. I have demonstrated commitment to making our country better. I am determined to work constructively across parliament to address the root causes of our challenges."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAORpK",
      "name": "Priority 1",
      "value": "Cleaning up politics and improving outcomes by regulating lobbying and political donations."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAORsA",
      "name": "Priority 2",
      "value": "Securing a cross-party plan and increased funding for health, especially primary and preventative."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAORv0",
      "name": "Priority 3",
      "value": "Shifting tax off work and onto land, to lower housing costs, and increase incomes."
     }
    ],
