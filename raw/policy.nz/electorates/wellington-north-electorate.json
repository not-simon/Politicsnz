     {
      "_key": "MBeO7ojrohBwl7F7zAOSba",
      "name": "Why I'm standing",
      "value": "I'm proud to have represented you as your MP for Wellington Central. I want to build on my track record of delivering for an affordable, safe and FUN Pōneke."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOSeQ",
      "name": "About me",
      "value": "I've served our community as a city councillor for four years, and your local MP for the last three years. We've made massive gains in housing, transport and the arts. But we need to change the government so we can use the tools of government to create jobs, stimulate the local economy and protect our precious natural environment."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOShG",
      "name": "Priority 1",
      "value": "Housing affordability: build public housing, rental WOF, rent controls, wealth tax for speculators"
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOSk6",
      "name": "Priority 2",
      "value": "Jobs: paid placements, fees-free tertiary ed, abolish the training wage, keep workforce here bonding"
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOSmw",
      "name": "Priority 3",
      "value": "Vibes: support for local artists and venues, stimulating our economy, more money in people's pockets"
     }
