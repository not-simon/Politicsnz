   {
    "attributes": [
     {
      "_key": "MBeO7ojrohBwl7F7zAOSsc",
      "name": "Why I'm standing",
      "value": "I am standing for New Zealand First because I believe that we have the experience, expertise and policy to help make New Zealand the best country in the world. Three years of a Labour majority saw record debt, high inflation and billions of dollars spent and nothing to show for it."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOSvS",
      "name": "About me",
      "value": "I have lived in Wellington since 2016 and I have seen how the decisions made in Parliament can impact entire communities. I have a wealth of experience and expertise that I feel will help me in making decisions for the nation. I believe in putting New Zealand First in every case - especially on the international stage."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOSyI",
      "name": "Priority 1",
      "value": "To put New Zealand, and New Zealanders, first both domestically and internationally."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOT18",
      "name": "Priority 2",
      "value": "Champion New Zealand industry."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOT3y",
      "name": "Priority 3",
      "value": "Grow the economy and New Zealand based industries to create more exports and more jobs."
     }
    ],
