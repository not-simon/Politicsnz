   {
    "attributes": [
     {
      "_key": "MBeO7ojrohBwl7F7zAORSc",
      "name": "Why I'm standing",
      "value": "I love Wellington North and want to serve our community well. Too many people are struggling with the cost of living, insecure work and pressure on local services. Wellington North needs an MP who listens, works constructively and delivers practical results. I will stand up for local jobs, support local businesses, invest in infrastructure and fight for affordable services—always focused on getting things done for our community."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAORVS",
      "name": "About me",
      "value": "I am a pragmatic, hardworking and community-minded person who listens carefully and works constructively with others. My experience as a Minister has taught me how government works and what it takes to turn good ideas into practical results. I do not believe in point-scoring or protest for its own sake. I believe in building relationships, negotiating in good faith and following through. I am committed to representing everyone in Wellington North and getting things done."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAORYI",
      "name": "Priority 1",
      "value": "Good jobs through ending National's public service cuts and creating jobs in the private sector."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAORb8",
      "name": "Priority 2",
      "value": "Relief on the cost of living including capping public transport fares at $20 per week."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAORdy",
      "name": "Priority 3",
      "value": "Fixing our health system with affordable care in the community and a guaranteed job for grad nurses."
     }
    ],
