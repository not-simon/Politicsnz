   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6qQR",
      "name": "Why I'm standing",
      "value": "I'm standing for ACT as after 20 years building a NZ company to compete internationally and with both my children now living overseas, I believe that as a country we urgently need to give our people a future. NZ can compete on the international stage. As the world shifts from an Atlantic to a Pacific focus we are right where we need to be. But we need to lift our skills, ambition and importantly agility."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6qSM",
      "name": "About me",
      "value": "I've spent the last 20 years building and running a healthcare company to look after New Zealanders and take our business, technology and services offshore into Asia. This provides high quality jobs in meaningful work which attracts Kiwis home. I understand complex sectors like healthcare and how we can deliver for New Zealanders within the resources we have available. Understanding business and delivering an effective and accountable government for Kiwis will unlock NZ's potential."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6qUH",
      "name": "Priority 1",
      "value": "Improve the cost of living by keeping taxation low through reducing government waste."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6qWC",
      "name": "Priority 2",
      "value": "Ensure Mt Albert gets affordable housing and infrastructure; roads, schools and green space."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6qY7",
      "name": "Priority 3",
      "value": "Deliver access to affordable and good quality healthcare."
     }
    ],
