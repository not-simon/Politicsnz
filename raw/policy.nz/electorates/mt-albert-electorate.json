   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6rCQ",
      "name": "Why I'm standing",
      "value": "I'm running because I believe in service. I grew up in a family of teachers, police officers and freezing workers who believed you contributed to your community. Through sport, business and media, I've met New Zealanders from every walk of life and seen what makes this country special. I want to protect those opportunities for the next generation. Rather than complain from the sidelines, I decided to put my hand up, contribute and serve."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6rEL",
      "name": "About me",
      "value": "I bring experience in leadership, business, sport and community service, and I'm comfortable working with people from every walk of life. Refereeing taught me to listen, stay calm under pressure, make tough decisions and treat everyone fairly. My professional career has taught me accountability and how to deliver results. Most importantly, I'm approachable and grounded. I understand that an elected representative is there to listen, work hard, represent their community and ultimately serve the public."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6rGG",
      "name": "Priority 1",
      "value": "Lower everyday costs so hardworking Kiwis can get ahead and keep more of what they earn."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6rIB",
      "name": "Priority 2",
      "value": "Focus on prevention, healthier Kiwis and taking pressure off our doctors, nurses and hospitals."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6rK6",
      "name": "Priority 3",
      "value": "Sustainable immigration that meets NZ's needs, protects our capacity and puts New Zealanders first."
     }
    ],
