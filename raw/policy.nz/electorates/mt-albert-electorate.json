   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6qpO",
      "name": "Why I'm standing",
      "value": "New Zealanders deserve to have a more hopeful and aspirational vision for their future, but that has been lacking for some time, regardless of which political parties are in Government. I believe that a low-emissions, productive and inclusive economy is one that will be more stable, affordable, and prosperous for the next generation, and we can only deliver the change required to get there by working together and strengthening our democracy."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6qrJ",
      "name": "About me",
      "value": "I have spent my career fighting for better ways to do business that prioritise the wellbeing of our planet and our people. Now I'm here to fight for better ways to do politics. I understand that creating change requires a vision for the future that others can get behind, and the pragmatism to bring everyone on the journey. And I am deeply committed to advocating for the diversity of perspectives that make up our communities. "
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6qtE",
      "name": "Priority 1",
      "value": "Clean up politics by regulating lobbying, limiting donations, and restoring trust in our system"
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6qv9",
      "name": "Priority 2",
      "value": "Grow the innovative, sustainable industries of the future to drive better wages and opportunities"
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6qx4",
      "name": "Priority 3",
      "value": "Bring long-term thinking to critical areas like health, education and infrastructure"
     }
    ],
