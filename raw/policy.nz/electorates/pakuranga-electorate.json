   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWerw",
      "name": "Why I'm standing",
      "value": "Our younger generation is finding it harder to find jobs, and many have voted with their feet and left the country. With a shrinking middle class and a growing aging population, we face deep systemic issues, from superannuation to ballooning healthcare costs. These problems should be at the forefront of political debate. I want to bring them forward and resolve them together, as a nation."
     },
     {
      "_key": "227mFCOl8uclHuS5roWeul",
      "name": "About me",
      "value": "Pakuranga has been home since primary school. As a pharmacist, I've spent years listening to patients, solving real problems, and making decisions together with the people affected by them. That's the kind of politics I want to bring: pragmatic, transparent, and built on collective decision-making."
     },
     {
      "_key": "227mFCOl8uclHuS5roWexa",
      "name": "Priority 1",
      "value": "Rebuilding our economy."
     },
     {
      "_key": "227mFCOl8uclHuS5roWf0P",
      "name": "Priority 2",
      "value": "Rebuilding our democracy."
     },
     {
      "_key": "227mFCOl8uclHuS5roWf3E",
      "name": "Priority 3",
      "value": "Reduce wastage within government."
     }
    ],
