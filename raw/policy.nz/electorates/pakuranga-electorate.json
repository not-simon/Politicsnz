   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWeb0",
      "name": "Why I'm standing",
      "value": "I have worked alongside many whanau in my time as a social worker. This is where I reflected on our social systems and what ultimately led me to wanting to stand for Labour in Pakuranga. My parents were always helping those in need. Providing them a hand up and supporting them wherever possible. This was imprinted into me as a young kid, and something I carried into my personal and professional life."
     },
     {
      "_key": "227mFCOl8uclHuS5roWedp",
      "name": "About me",
      "value": "I don't like to harp on about myself, as my view is I should focus on the people I want to represent. I have extensive experience as a social worker in the areas of East and South Auckland, working in both Care and Protection and Youth Justice alongside Police, the courts and other NGOs and government agencies. I also worked as a policy analyst before returning to frontline services."
     },
     {
      "_key": "227mFCOl8uclHuS5roWege",
      "name": "Priority 1",
      "value": "Lowering child poverty rates."
     },
     {
      "_key": "227mFCOl8uclHuS5roWejT",
      "name": "Priority 2",
      "value": "Easing the cost of living for middle- and lower-income households."
     },
     {
      "_key": "227mFCOl8uclHuS5roWemI",
      "name": "Priority 3",
      "value": "Advocating for further support to help everyday Kiwis into well-paying and secure employment."
     }
    ],
