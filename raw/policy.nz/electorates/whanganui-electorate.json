 "election": {
  "candidates": [
   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWZS3",
      "name": "Why I'm standing",
      "value": "Whanganui (incl Ruapehu, South Taranaki and Stratford) deserves an active, engaged local MP, advocating for our region in Wellington. That is what I have been and will continue to be, should I be re-elected on 7 Nov. In order to have the health, education and social services our region deserves, we also need to re-elect a National-led Government to ensure we have a growing economy that can pay for this."
     },
     {
      "_key": "227mFCOl8uclHuS5roWZUs",
      "name": "About me",
      "value": "Born and raised in Whanganui, Candice and I live here with our three children. A wide range of international business involvement in the primary industries and animal health, food safety and manufacturing, retail and education, gives me significant real-world experience and skills. Over the last three years I have demonstrated how an active local MP delivers results for our community - school upgrades, new police station, new Patea connectivity tower, environmental funding and more."
     },
     {
      "_key": "227mFCOl8uclHuS5roWZXh",
      "name": "Priority 1",
      "value": "Ensure ongoing improvement in healthcare services - including mental, rural & provincial healthcare."
     },
     {
      "_key": "227mFCOl8uclHuS5roWZaW",
      "name": "Priority 2",
      "value": "Drive opportunities for new jobs and higher wages, ensuring investment boost continues."
     },
     {
      "_key": "227mFCOl8uclHuS5roWZdL",
      "name": "Priority 3",
      "value": "Continue advocating for our rural sector, which is critical to this region. Backing our farmers!"
     }
    ],
    "party": {
     "name": "National Party"
    },
