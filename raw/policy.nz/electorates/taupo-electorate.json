      "_key": "227mFCOl8uclHuS5roWOhv",
      "name": "Why I'm standing",
      "value": "I want to encourage the people of Taupo Electorate to give their party vote to the Green Party."
     },
     {
      "_key": "227mFCOl8uclHuS5roWOkk",
      "name": "About me",
      "value": "I am running as an Electorate Candidate only. I am not aiming for Parliament. I am holding the space for a younger person to be a parliamentary candidate in a future election."
     },
     {
      "_key": "227mFCOl8uclHuS5roWOnZ",
      "name": "Priority 1",
      "value": "Supporting the health of rivers and lakes as our fresh water sources."
     },
     {
      "_key": "227mFCOl8uclHuS5roWOqO",
      "name": "Priority 2",
      "value": "Supporting the health of our forests and green spaces."
     },
     {
      "_key": "227mFCOl8uclHuS5roWOtD",
      "name": "Priority 3",
      "value": "Reforming the electricity system to support people rather than investors including the Government."
     }
