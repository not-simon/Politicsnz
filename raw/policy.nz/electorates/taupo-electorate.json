   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWOA3",
      "name": "Why I'm standing",
      "value": "The Taupo electorate is heartland New Zealand and our local economy is driven by tourism, forestry and farming. I'm running in this election to improve the lives of people in Taupo - from Cambridge to Turangi. I'm excited to continue serving our community and our country, as part of the National Party that is focussed on growing the economy to create jobs, lift wages and increase opportunities for all New Zealanders."
     },
     {
      "_key": "227mFCOl8uclHuS5roWOCs",
      "name": "About me",
      "value": "I've served the communities of Cambridge, Tirau, Putaruru, Tokoroa, Taupo and Turangi since being elected in 2008. Being available to locals through regular coffee catch-ups, friendly forums, online events and clinics has meant staying connected and hearing what's important in our communities. I'm proud to be a strong voice for the Taupo electorate and deliver for our communities. I've worked hard to ensure our region's priorities are heard and I'll keep doing that."
     },
     {
      "_key": "227mFCOl8uclHuS5roWOFh",
      "name": "Priority 1",
      "value": "Ensure the Cambridge to Piarere extension of the Waikato Expressway is completed."
     },
     {
      "_key": "227mFCOl8uclHuS5roWOIW",
      "name": "Priority 2",
      "value": "Grow the number of tourists visiting Taupo so there are more customers for local businesses."
     },
     {
      "_key": "227mFCOl8uclHuS5roWOLL",
      "name": "Priority 3",
      "value": "Ensure the 3rd Medical School in Waikato is completed so there is better access to GPs in Taupo."
     }
    ],
