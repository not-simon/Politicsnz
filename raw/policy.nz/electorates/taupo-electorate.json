   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWOQz",
      "name": "Why I'm standing",
      "value": "NZ should be doing better. Our economy is no longer delivering for Kiwis and our politicians are engaged in short-term, tit-for-tat thinking. We need fresh thinking and a long-term vision to take us through the next 30 years."
     },
     {
      "_key": "227mFCOl8uclHuS5roWOTo",
      "name": "About me",
      "value": "I've worked in the NZ public and private sectors and in international development, so I've experienced many perspectives. I believe that we need to listen to each other to be able to build consensus on a common way forward."
     },
     {
      "_key": "227mFCOl8uclHuS5roWOWd",
      "name": "Priority 1",
      "value": "Address the cost-of-living crisis by strengthening the economy and improving competition."
     },
     {
      "_key": "227mFCOl8uclHuS5roWOZS",
      "name": "Priority 2",
      "value": "Increase local renewable energy production to boost the local economy and reduce electricity costs."
     },
     {
      "_key": "227mFCOl8uclHuS5roWOcH",
      "name": "Priority 3",
      "value": "Protect our environment for the benefit of our next generations."
     }
    ],
