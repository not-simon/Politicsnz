   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWGNO",
      "name": "Why I'm standing",
      "value": "I am asking you to give your party vote to ACT. I want more ACT MPs who will fight to cut waste and grow the country, balance the books with no new taxes, defend equal rights, deliver better public services, cut red tape, and restore real consequences for crime. I'm asking you to choose whichever electorate candidate you believe will best represent the Wigram electorate and to give your party vote to ACT."
     },
     {
      "_key": "227mFCOl8uclHuS5roWGQD",
      "name": "About me",
      "value": "I'm not asking you to elect me as your local MP. I'm asking you to give your Party Vote to ACT to Lock Labour Out and unlock New Zealand's potential. It means keeping the coalition Government in power, but ensuring that it can go further and faster on the issues that matter most to you. A party vote for ACT will re-elect the Government and make it stronger. I am a current ACT list MP."
     },
     {
      "_key": "227mFCOl8uclHuS5roWGT2",
      "name": "Priority 1",
      "value": "Back small business, balance the books with no new taxes, and grow the economy."
     },
     {
      "_key": "227mFCOl8uclHuS5roWGVr",
      "name": "Priority 2",
      "value": "Deliver better services for taxpayers: education, police, and match Australia on medicines funding."
     },
     {
      "_key": "227mFCOl8uclHuS5roWGYg",
      "name": "Priority 3",
      "value": "Ban the creation and sharing of sexually explicit deepfake pornography."
     }
    ],
