  "candidates": [
   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWG6S",
      "name": "Why I'm standing",
      "value": "I'm running because I believe New Zealand works best when everyone has a fair chance to get ahead. Too many hardworking people are still struggling, and I'm not willing to stand by while that continues. I want to help build a government that rewards hard work, ensures public services are there when people need them, and leaves no one behind."
     },
     {
      "_key": "227mFCOl8uclHuS5roWG9H",
      "name": "About me",
      "value": "I have chosen to make Wigram my home because it is a diverse, hardworking community where people care about their neighbours and want a better future for their families. I would bring practical experience from farms, factories and technology project management, alongside a commitment to listening and delivering results. I understand the pressures local people face and will be a strong, accessible advocate for affordable living, quality public services, good jobs and well-planned growth."
     },
     {
      "_key": "227mFCOl8uclHuS5roWGC6",
      "name": "Priority 1",
      "value": "Ease cost pressures with cheaper healthcare, capped bus fares & support to lower power bills."
     },
     {
      "_key": "227mFCOl8uclHuS5roWGEv",
      "name": "Priority 2",
      "value": "Improve healthcare access so people can see a GP, get prescriptions and receive care when needed."
     },
     {
      "_key": "227mFCOl8uclHuS5roWGHk",
      "name": "Priority 3",
      "value": "Plan growth properly by matching new housing with roads, schools, transport and essential services."
     }
    ],
