   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6mSl",
      "name": "Why I'm standing",
      "value": "I'm running for the Aotearoa Legalise Cannabis Party because our communities deserve compassionate, evidence‑based drug law reform. Outdated laws have harmed whānau, limited opportunity, and ignored the wellbeing of regions like Te Tai Tokerau. I want to bring a grounded voice that pushes for fairness, health‑focused policy, and sustainable local industry. My motivation is to help build an Aotearoa where justice, dignity, and community resilience guide our decisions."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6mUg",
      "name": "About me",
      "value": "I'll make a good elected representative because I bring lived experience, strong ties to Te Tai Tokerau, and a commitment to fairness, wellbeing, and evidence‑based reform. I listen closely, act with integrity, and stay grounded in real community needs. My political focus is compassionate drug law reform, sustainable local industry, and strengthening resilience, dignity, and opportunity for whānau across Aotearoa."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6mWb",
      "name": "Priority 1",
      "value": "Community‑led health services so Te Tai Tokerau whānau have accessible, culturally grounded care."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6mYW",
      "name": "Priority 2",
      "value": "Grow a legal, locally owned cannabis industry create jobs, small business, and keep revenue local."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6maR",
      "name": "Priority 3",
      "value": "Improve rural transport links, communities are safe, reliable access to work, education, healthcare."
     }
    ],
