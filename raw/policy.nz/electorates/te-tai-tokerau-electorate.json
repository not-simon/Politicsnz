   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6mHF",
      "name": "Why I'm standing",
      "value": "Born and raised in Tai Tokerau, I am firmly committed to the rohe, peoples and diverse communities. The legacy and promise of He Whakaputanga me Te Tiriti o Waitangi drives my service as a current Member of Parliament to advocate for honourable kāwanatanga and constitutional transformation. As a first term MP I have much more to do in parliament and maintain steadfast commitment to Tai Tokerau Electorate and improving outcomes for us all."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6mJA",
      "name": "About me",
      "value": "As an MP I've had the privilege of working across my portfolios as a list MP: Health, Whānau Ora, Māori Development, Forestry, Media Communications, Māori Fisheries and Māori Education. Growing understanding and connections across portfolios and networks. Further a Tai Tokerau based List MP I have worked hard to advocate for communities hapū and iwi. Being present, learning, growing understanding of issues, supporting and advocating across local and central government I have served our people."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6mL5",
      "name": "Priority 1",
      "value": "Revoke Fast-track Projects: Ensure our voice as hapū iwi and community is heard to protect taonga."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6mN0",
      "name": "Priority 2",
      "value": "Housing for Everybody: help whānau into homes, end homelessness and building more public housing."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6mOv",
      "name": "Priority 3",
      "value": "Tai Tokerau Economic Resilience: Invest in kai, renewable energy, climate and marae resilience."
     }
    ],
