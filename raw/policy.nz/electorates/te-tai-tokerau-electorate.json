   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6meH",
      "name": "Why I'm standing",
      "value": "TTT deserves representation that is grounded in our communities and accountable to our whānau. Often our rohe appears higher in statistics reflecting hardship. We can change these realities through a dedicated TTT voice to secure funding, resources and the political attention our community deserves. Every decision I make will always be measured against whether our mokopuna will be better off. I am running to ensure TTT has a voice at the table, & the mandate to shape our own future."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6mgC",
      "name": "About me",
      "value": "Born and raised in this rohe & bring more than 40 years of experience working alongside whānau, including frontline in health, Whānau Ora, suicide prevention, social welfare, Oranga Tamariki, Rape Crisis & CEO Te Aupōuri. I bring direct experience as Independent Member of Parliament for TTT. I understand that effective representation is built through relationships and credibility. I have the experience and grit that is needed to stand up for what TTT needs and to make sure our people are heard."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6mi7",
      "name": "Priority 1",
      "value": "Strengthen whānau wellbeing by placing mokopuna, hauora & whānau at the centre of government decisions."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6mk2",
      "name": "Priority 2",
      "value": "Build warm, healthy and affordable homes."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6mlx",
      "name": "Priority 3",
      "value": "Protect our whenua, wai and moana."
     }
    ],
