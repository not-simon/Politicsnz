   {
    "attributes": [
     {
      "_key": "MBeO7ojrohBwl7F7zAPGeI",
      "name": "Why I'm standing",
      "value": "I am running to serve the community I call home. My education, professional experience and ability to engage with people have prepared me to do the practical work of an MP: listen, understand, judge, act and report back. Importantly, I have the political courage to speak up when Selwyn is not being treated fairly. I want Selwyn to have a strong, independent voice in Parliament, answerable first and foremost to the people who live here."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAPGh8",
      "name": "About me",
      "value": "I listen carefully, speak plainly and am prepared to make my own judgement. Three decades as an engineer and two decades as a business owner taught me to solve problems, weigh evidence and take responsibility for decisions. I am comfortable talking with people from all walks of life and I believe an MP should be visible and accessible. As an Independent, my loyalty will be to Selwyn residents, not a party hierarchy or political career."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAPGjy",
      "name": "Priority 1",
      "value": "Strengthen rural health so Selwyn rural communities receive care comparable with urban areas."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAPGmo",
      "name": "Priority 2",
      "value": "Oppose out-of-zone fast-track subdivisions that shift infrastructure costs onto ratepayers."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAPGpe",
      "name": "Priority 3",
      "value": "Resist the current amalgamation plan that risks reducing Selwyn to a suburb of Christchurch."
     }
    ],
