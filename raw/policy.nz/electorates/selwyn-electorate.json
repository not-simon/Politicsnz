   {
    "attributes": [
     {
      "_key": "MBeO7ojrohBwl7F7zAPGNG",
      "name": "Why I'm standing",
      "value": "I am running for Parliament because I believe politics should be about people, their hopes, their families, and the future they want to build."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAPGQ6",
      "name": "About me",
      "value": "I would make a good elected representative because I bring experience, empathy, integrity and a strong commitment to service. As an educator, community leader and Chair of a Community Board, I have learned to listen, work across differences and deliver practical outcomes. Having built my life in New Zealand for more than two decades, I understand the importance of opportunity and belonging. I would be an accessible, hardworking and honest voice for all Selwyn residents."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAPGSw",
      "name": "Priority 1",
      "value": "Support Selwyn's growth with better roads, schools, transport, healthcare and community facilities."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAPGVm",
      "name": "Priority 2",
      "value": "Ease cost-of-living pressures by improving housing affordability and supporting secure local jobs."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAPGYc",
      "name": "Priority 3",
      "value": "Strengthen Selwyn communities by ensuring residents and local groups have a strong voice."
     }
    ],
