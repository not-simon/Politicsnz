   {
    "attributes": [
     {
      "_key": "MBeO7ojrohBwl7F7zAPG3O",
      "name": "Why I'm standing",
      "value": "I am running for election because I believe Selwyn and New Zealand as a whole need a democratic-socialist alternative to the other parties currently campaigning."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAPG6E",
      "name": "About me",
      "value": "I've been involved in many advocacy groups for workers' rights, fair pay, and equality. So I understand the social and economic problems that concern our communities. This has also given me experience in organising campaigns around a specific issue. As a proud worksite union representative, I am also aware of the day-to-day issues that working families face in our current system."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAPG94",
      "name": "Priority 1",
      "value": "Prioritizing the rising nitrate levels in our groundwater that we take from for drinking water."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAPGBu",
      "name": "Priority 2",
      "value": "Establishing a strong support system for workers to ensure they are being treated fairly at work."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAPGEk",
      "name": "Priority 3",
      "value": "Creating an electrified public rail system for rural/town communities that would be free of charge."
     }
    ],
