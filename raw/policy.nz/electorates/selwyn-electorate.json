   {
    "attributes": [
     {
      "_key": "MBeO7ojrohBwl7F7zAPExG",
      "name": "Why I'm standing",
      "value": "I think we can create a far better future for our children and grandchildren with better decisions made now. I strongly believe that all New Zealanders should have a say in our future through our democratic process. Currently, I feel our democracy has been significantly influenced by corporate and lobby group interests and the tribalism that exists in the political system. I believe Opportunity can be the circuit breaker and bring about needed change."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAPF06",
      "name": "About me",
      "value": "I have worked in healthcare for over 40 years, for the majority of this time as a medical laboratory scientist but also as an infection control advisor for a District Health Board. This role involved working with a diverse range of professional groups. I believe I can bring these skills to my role as a candidate to help resolve some of our big issues that are currently put in the too-hard basket."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAPF2w",
      "name": "Priority 1",
      "value": "Address the issues associated with Fast-track of housing developments outside of the District Plan"
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAPF5m",
      "name": "Priority 2",
      "value": "Address the issues associated with central government's under-contribution to infrastructure costs."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAPF8c",
      "name": "Priority 3",
      "value": "Improve funding, staffing, resourcing and access to our public health system for Selwyn residents."
     }
    ],
