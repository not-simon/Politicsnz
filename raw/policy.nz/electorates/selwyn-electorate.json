   {
    "attributes": [
     {
      "_key": "MBeO7ojrohBwl7F7zAPFVK",
      "name": "Why I'm standing",
      "value": "I am pleased to be able to stand for NZ First as a common-sense party who shares my conservative values. As a two-term district councillor in Selwyn, I am faced daily with the impacts of central government decisions on our way of life. I am dedicated to using my knowledge and experience to improve NZ, making it a prosperous, safe and enjoyable place to live and work."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAPFYA",
      "name": "About me",
      "value": "I believe in a strong democracy in which decision making comes from the local communities impacted. On top of my councillor role, I have advocated for change at central government level, on bills as well as representing local and national issues that are important in Selwyn and beyond. Saving the Upper Selwyn Hutts community, pushing for changes to legislation regarding earthquake buildings, encouraging government to be proactive on NZ Wool industry and much more."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAPFb0",
      "name": "Priority 1",
      "value": "Back the decision that Canterbury councils made to remain stand-alone, opposing forced amalgamation."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAPFdq",
      "name": "Priority 2",
      "value": "Review fast track housing decisions  to ensure its fit for purpose, and serving local communities."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAPFgg",
      "name": "Priority 3",
      "value": "Retain NZ's GE-free status; Selwyn's economy relies on strong agricultural protections."
     }
    ],
