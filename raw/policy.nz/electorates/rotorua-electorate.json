  "candidates": [
   {
    "attributes": [
     {
      "_key": "lXvsWGt582gEfwb3602cW5",
      "name": "Why I'm standing",
      "value": "I am standing as the Opportunity Party candidate for Rotorua because I believe that Opportunity is the only party willing to legitimately work with both Labour and National to ensure that we have focused, long-term policy rather than the flip-flopping that we have been seeing in recent governments. Young people are increasingly leaving this country because they cannot see a future here, with unemployment, housing and higher wages all contributing. We need to change this."
     },
     {
      "_key": "lXvsWGt582gEfwb3602cb9",
      "name": "About me",
      "value": "I was born and raised here in Rotorua, and have been active within the local community. I have been a strong advocate for the environment and was the local organiser for the School Strike for Climate March while a student in high school. I was also the campaign manager for the locally prominent weweia in the 2024 Bird of the Year competition, and have been involved in volunteer community trapping."
     },
     {
      "_key": "lXvsWGt582gEfwb3602cgD",
      "name": "Priority 1",
      "value": "Ensuring that young people see themselves having a future in Rotorua."
     },
     {
      "_key": "lXvsWGt582gEfwb3602clH",
      "name": "Priority 2",
      "value": "Support science and innovation through increased investment."
     },
     {
      "_key": "lXvsWGt582gEfwb3602cqL",
      "name": "Priority 3",
      "value": "Restore community trust in our government."
     }
    ],
    "party": {
     "name": "Opportunity Party"
    },
