   },
   {
    "attributes": [
     {
      "_key": "lXvsWGt582gEfwb3602c1h",
      "name": "Why I'm standing",
      "value": "I'm running because I believe everyday New Zealanders have been pushed to the back of the queue for too long. I left school at 13 and spent nearly 30 years working my way from a labourer to senior leadership in civil construction. I know what hard work, accountability and delivery look like. I want to bring that real-world experience to Parliament, put Rotorua first, and help build a safer, stronger and more prosperous New Zealand."
     },
     {
      "_key": "lXvsWGt582gEfwb3602c6l",
      "name": "About me",
      "value": "I'm not a career politician. I bring nearly 30 years of real-world experience leading people, managing major infrastructure projects and delivering under pressure. I understand what working families and businesses are facing because I've lived in that world. I believe in accountability, common sense and getting things done. I'll be a strong, independent voice for Rotorua, prepared to challenge the status quo, listen to our community and fight for better outcomes."
     },
     {
      "_key": "lXvsWGt582gEfwb3602cBp",
      "name": "Priority 1",
      "value": "Build infrastructure, strengthen energy security and create well-paid jobs."
     },
     {
      "_key": "lXvsWGt582gEfwb3602cGt",
      "name": "Priority 2",
      "value": "Restore law and order, tackle gangs and put victims and community safety first."
     },
     {
      "_key": "lXvsWGt582gEfwb3602cLx",
      "name": "Priority 3",
      "value": "Strengthen education, expand trades training and get more young New Zealanders into work."
     }
    ],
