   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWbV4",
      "name": "Why I'm standing",
      "value": "I'm standing for the Greens because I want the best future for my grandchildren, and all children. I'm passionate about the environment and social justice."
     },
     {
      "_key": "227mFCOl8uclHuS5roWbXt",
      "name": "About me",
      "value": "I have had over three decades of experience in the governance and management of NGOs and community groups in Hawke's Bay, as well as running an environmentally responsible commercial cleaning business."
     },
     {
      "_key": "227mFCOl8uclHuS5roWbai",
      "name": "Priority 1",
      "value": "To make our rivers and lakes clean enough that we can swim in and drink these waters."
     },
     {
      "_key": "227mFCOl8uclHuS5roWbdX",
      "name": "Priority 2",
      "value": "There is enough for all of us, but the current economic structure helps the rich, not the poor."
     },
     {
      "_key": "227mFCOl8uclHuS5roWbgM",
      "name": "Priority 3",
      "value": "Climate change is happening in front of us, yet we are only making baby steps to reduce the harm."
     }
    ],
