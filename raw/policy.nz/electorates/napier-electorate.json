   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWbm0",
      "name": "Why I'm standing",
      "value": "I'm running because Parliament needs more everyday New Zealanders who understand the realities facing families and communities. I'm a working mum, born and raised in Napier, with experience across different sectors. I want to be a strong voice for Napier and Wairoa, focused on better healthcare, infrastructure, resilience and regional opportunities, while ensuring my daughter's generation inherits a country where hard work, aspiration and personal responsibility are rewarded."
     },
     {
      "_key": "227mFCOl8uclHuS5roWbop",
      "name": "About me",
      "value": "I'm approachable, practical and prepared to ask difficult questions. I understand the responsibility of representing a community, listening to different perspectives and being accountable for my decisions. My broad professional and community experience helps me understand how government decisions affect people on the ground. I'm deeply connected to Napier and Wairoa, and believe good representatives should listen, communicate openly, challenge the status quo when necessary and always remember who they represent."
     },
     {
      "_key": "227mFCOl8uclHuS5roWbre",
      "name": "Priority 1",
      "value": "Grow regional jobs, industry and opportunities for our young people."
     },
     {
      "_key": "227mFCOl8uclHuS5roWbuT",
      "name": "Priority 2",
      "value": "Secure investment in resilient infrastructure, roads and water."
     },
     {
      "_key": "227mFCOl8uclHuS5roWbxI",
      "name": "Priority 3",
      "value": "Improve access to healthcare in Napier and Wairoa."
     }
    ],
