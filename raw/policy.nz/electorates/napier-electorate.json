   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWbE8",
      "name": "Why I'm standing",
      "value": "I'm optimistic about our region's future and want to help shape it. I want to ensure Napier, Wairoa, and Gisborne continue to be great places to live, work and raise a family. That means supporting economic growth, improving opportunities for young people, and addressing the challenges facing our communities. I believe in National's vision of fixing the basics and building the future, while delivering practical results that help local families and businesses get ahead."
     },
     {
      "_key": "227mFCOl8uclHuS5roWbGx",
      "name": "About me",
      "value": "I've built strong relationships across our region by listening to people, understanding their concerns, and working hard to get results. As a local MP, I'm committed to being accessible, responsive, and focused on practical solutions that improve everyday life. I believe in personal responsibility, opportunity, and strong communities. I'll continue to be a strong advocate for our region in Parliament, ensuring local voices are heard and delivering outcomes that help families, businesses, and communities thrive."
     },
     {
      "_key": "227mFCOl8uclHuS5roWbJm",
      "name": "Priority 1",
      "value": "Creating global opportunities, locally: growing jobs, and helping our region get ahead and thrive."
     },
     {
      "_key": "227mFCOl8uclHuS5roWbMb",
      "name": "Priority 2",
      "value": "Future-proofing our roads, hospital, schools, and energy production to keep Hawke's Bay moving."
     },
     {
      "_key": "227mFCOl8uclHuS5roWbPQ",
      "name": "Priority 3",
      "value": "Ensuring families can access healthcare sooner, and a world-class education for their children."
     }
    ],
