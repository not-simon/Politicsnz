   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWagG",
      "name": "Why I'm standing",
      "value": "My motivation comes from a career spent on the frontlines of health and advocacy, listening to people when they need help most. Across Napier and Wairoa, I see whānau struggling with rising costs and unemployment, unaffordable housing and poor access to healthcare. Better is possible for our region, and I'm ready to deliver that change."
     },
     {
      "_key": "227mFCOl8uclHuS5roWaj5",
      "name": "About me",
      "value": "With a decade as a doctor in our hospital and community, I've been there when people faced their toughest moments, listening, understanding, and taking action. Beyond medicine, as Vice President of the NZRDA union and through health sector governance, I've proven my commitment to standing up for workers and driving systemic change. I bring deep local roots, frontline experience, and a strong track record of advocacy to deliver the leadership our electorate deserves."
     },
     {
      "_key": "227mFCOl8uclHuS5roWalu",
      "name": "Priority 1",
      "value": "Advocate for better health services and fix the systemic issues causing overnight service closures."
     },
     {
      "_key": "227mFCOl8uclHuS5roWaoj",
      "name": "Priority 2",
      "value": "Reduce the cost of living with free doctor visits & prescriptions, $10 bus fare cap and solar power."
     },
     {
      "_key": "227mFCOl8uclHuS5roWarY",
      "name": "Priority 3",
      "value": "Get social housing projects underway so everyone can have a secure home."
     }
    ],
