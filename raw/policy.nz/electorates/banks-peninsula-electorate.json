   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqoz1V4",
      "name": "Why I'm standing",
      "value": "I believe in people and nature thriving together and working as a community to confront challenges. I'm standing for Parliament to contribute my skills and experience across community, environmental action, iwi, local and central government and the private sector to Government. I know we can protect and restore our environment, embrace Te Tiriti partnership and have affordable and secure lives - if we make positive change that uplifts all of us."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz1XF",
      "name": "About me",
      "value": "I was born and raised in Ōtautahi-Christchurch, I'm a proud Pāpā to three young adults and a dedicated community and environmental leader with over 30 years' experience across resource management, local government and ecological restoration. Whether as Chair of the Regional Council, an RMA Commissioner or as a trustee of local charities, I bring a practical approach grounded in real-world results, while leading with values and bringing people together around shared responsibility for people and place."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz1ZQ",
      "name": "Priority 1",
      "value": "Secure affordable lives by gathering fairer tax and lowering power, grocery and transport bills."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz1bb",
      "name": "Priority 2",
      "value": "Fix rules to restore our environment and ensure we can drink, swim and fish in our oceans and rivers."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz1dm",
      "name": "Priority 3",
      "value": "Put decisions back in the hands of our community and better fund critical public services and jobs."
     }
    ],
    "party": {
