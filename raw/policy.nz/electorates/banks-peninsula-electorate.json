  "candidates": [
   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqoz1mU",
      "name": "Why I'm standing",
      "value": "I want New Zealand to be safe and prosperous so that my son and his friends will stay and raise their children here. I love this country and have always wanted to serve it, which is why I was in the Army. Being a politician is another form of service. "
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz1of",
      "name": "About me",
      "value": "I am a good listener, a skill I learned well as a GP looking after families and individuals. I've got a wealth of experience, and I bring a variety of skills to the job."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz1qq",
      "name": "Priority 1",
      "value": "Advocate for a decision on the future of Princess Margaret Hospital. Ensure the community is heard."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz1t1",
      "name": "Priority 2",
      "value": "Advocate for safety improvements on State Highway 75, because there are dangerous intersections."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoz1vC",
      "name": "Priority 3",
      "value": "Work with CCC to secure a city and regional deal with government, because that will help us grow."
     }
    ],
    "party": {
