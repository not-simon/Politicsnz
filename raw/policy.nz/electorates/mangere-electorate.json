   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqozB5V",
      "name": "Why I'm standing",
      "value": "I am running because Māngere is home. I have raised my family here, worked here, volunteered here and seen both the challenges and the incredible strength in our community. I want our families and young people to have more opportunities to get ahead. I believe Māngere deserves a strong local voice that listens, understands our community and is prepared to work hard to deliver better outcomes."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqozB7g",
      "name": "About me",
      "value": "I will make a good elected representative because I am a strong, practical leader who listens, brings people together and gets things done. My Pacific roots and values of family, faith, service, respect and hard work guide how I lead. I know Māngere and understand our community. I will be accessible, make clear decisions, speak up when it matters and work hard to deliver better opportunities and outcomes for our people."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqozB9r",
      "name": "Priority 1",
      "value": "Reduce everyday costs so Māngere families can keep more of what they earn and get ahead."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqozBC2",
      "name": "Priority 2",
      "value": "Increase access to safe, affordable housing so Māngere families have stability and security."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqozBED",
      "name": "Priority 3",
      "value": "Create more jobs and pathways into work so Māngere families can get ahead and build secure futures."
     }
    ],
