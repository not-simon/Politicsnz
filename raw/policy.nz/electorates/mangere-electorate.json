   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqozANx",
      "name": "Why I'm standing",
      "value": "I believe New Zealand can be an even better place to live, work and raise a family. We have awesome people, strong communities and huge potential. With longer-term thinking and the courage to tackle our big challenges, we can build a more prosperous country, restore our natural environment and make it easier for people who work hard to get ahead."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqozAQ8",
      "name": "About me",
      "value": "I've spent more than 20 years in business, leading teams and working through difficult decisions. I currently work here in Māngere. My career has taught me the importance of listening well, working constructively with people who see things differently, and taking responsibility. I would bring that same practical approach to Parliament and be an accessible, straightforward and accountable representative for Māngere."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqozASJ",
      "name": "Priority 1",
      "value": "Reset our economy to reward work, cheaper power and affordable housing."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqozAUU",
      "name": "Priority 2",
      "value": "Restore political trust, reduce flip-flops and unite people around long-term solutions."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqozAWf",
      "name": "Priority 3",
      "value": "Restore the Manukau Harbour and our oceans by reducing pollution and protecting marine life."
     }
    ],
