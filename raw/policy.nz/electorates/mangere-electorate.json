   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqozBKk",
      "name": "Why I'm standing",
      "value": "My parents came to New Zealand believing hard work could build a better life for their children. Māngere is where they built that life, and where I built mine. I'm running because I want that promise to still mean something. I'm standing for New Zealand First to bring Māngere's voice to Parliament and help ensure hard work is rewarded, families can get ahead, and our young people see their future here in New Zealand."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqozBMv",
      "name": "About me",
      "value": "I bring over 15 years of public service and community leadership, from leading teams at the Ministry of Social Development to managing the Māngere Town Centre Business Improvement District (BID), an Auckland Council programme delivered in partnership with local business associations. I have also served on local community groups. I understand how government works and the people it serves, bringing practical experience, strong advocacy and a proven record of getting things done."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqozBP6",
      "name": "Priority 1",
      "value": "Back NZ First's plans to tackle supermarket and power costs so Māngere families can get ahead."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqozBRH",
      "name": "Priority 2",
      "value": "Back NZ First's focus on trades and skills to connect Māngere people with better jobs."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqozBTS",
      "name": "Priority 3",
      "value": "Back NZ First's commitment to citizens-only voting and making New Zealand citizenship mean more."
     }
    ],
