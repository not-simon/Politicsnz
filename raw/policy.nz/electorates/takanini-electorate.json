  "candidates": [
   {
    "attributes": [
     {
      "_key": "5r5sFjSBWMIetVQk4N5BNw",
      "name": "Why I'm standing",
      "value": "I'm running to serve. People here deserve someone who puts them first — not slogans, not a party script. Housing, traffic, rates and whether families can get ahead are not talking points to me; they are the job. I'll listen hard, tell the truth about trade-offs, and fight for practical results."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5BTA",
      "name": "About me",
      "value": "I'll make a good representative because I put service first and treat every New Zealander as equal before the law. My work with Hobson's Pledge was about that principle in practice: one standard of citizenship, not race-based privilege. I listen, I say the hard thing when it's true, and I measure success by results people can feel. I'll stay close to the community, honest about trade-offs, and keep working until the job is done."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5BYO",
      "name": "Priority 1",
      "value": "Defend one law for all so every New Zealander has equal rights, not race rules."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5Bdc",
      "name": "Priority 2",
      "value": "Rebuild strong families so our young people stay off crime, gangs and despair."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5Biq",
      "name": "Priority 3",
      "value": "Protect kids with truth and order so schools and streets stay safe for families."
     }
    ],
    "party": {
