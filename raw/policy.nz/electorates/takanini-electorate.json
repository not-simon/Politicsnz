   {
    "attributes": [
     {
      "_key": "5r5sFjSBWMIetVQk4N5BtI",
      "name": "Why I'm standing",
      "value": "I am running because I want Takanini to have a strong local voice in Parliament. As a small-business owner, I understand the pressures families and businesses face around the cost of living, healthcare and reliable infrastructure. I want to listen to our communities, advocate for solutions and help build a fairer future in which everyone has the opportunity to succeed."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5ByW",
      "name": "About me",
      "value": "As a long-standing business owner, I understand the importance of listening to people and solving problems. This experience has also given me a strong understanding of the everyday pressures facing families, workers and small businesses. I will bring that practical perspective to Parliament, represent Takanini's diverse communities with respect, and work hard to ensure local concerns are heard and acted on."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5C3k",
      "name": "Priority 1",
      "value": "To support businesses in creating more employment opportunities as our communities continue to grow."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5C8y",
      "name": "Priority 2",
      "value": "To advocate for safer streets, stronger policing and better support for the Takanini local community."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5CEC",
      "name": "Priority 3",
      "value": "To improve infrastructure and roads to reduce the daily pressure on families, workers and businesses."
     }
    ],
