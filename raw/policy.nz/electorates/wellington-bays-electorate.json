   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqoyyGk",
      "name": "Why I'm standing",
      "value": "I am asking you to give your party vote to ACT. I want more ACT MPs who will fight to cut waste and grow the country, balance the books with no new taxes, defend equal rights, deliver better public services, cut red tape, and restore real consequences for crime. I'm asking you to choose whichever electorate candidate you believe will best represent the Wellington Bays electorate and to give your party vote to ACT."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyyIv",
      "name": "About me",
      "value": "I'm not asking you to elect me as your local MP. I'm asking you to give your party vote to ACT to Lock Labour Out and Unlock New Zealand's potential. It means keeping the coalition Government in power, but ensuring that it can go further and faster on the issues that matter most to you. A party vote for ACT will re-elect the Government and make it stronger. I'm ACT's Deputy Leader and a Minister."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyyL6",
      "name": "Priority 1",
      "value": "Grow the economy to balance the books with no new taxes so incomes rise faster than living costs."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyyNH",
      "name": "Priority 2",
      "value": "Deliver better services for taxpayers: education, police, and match Australia on medicines funding."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyyPS",
      "name": "Priority 3",
      "value": "Crack down on crime: three strikes for burglary, more powers for security guards, put victims first."
     }
    ],
