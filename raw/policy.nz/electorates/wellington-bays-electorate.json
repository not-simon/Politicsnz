  "candidates": [
   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqoyy3g",
      "name": "Why I'm standing",
      "value": "I'm standing for Opportunity because I believe Aotearoa New Zealand is capable of far more than the divisive, short-term politics we've become stuck with. We want to bring people together, plan for the future, and back the enormous potential of our country. I believe Aotearoa's most crucial (and undervalued) asset is nature – and I have a particular interest in seeing our ocean and fisheries restored to a state of health and abundance."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyy5r",
      "name": "About me",
      "value": "My background is in conservation, climate, and public policy, working on complex issues that don't have easy answers. What that experience has shown me is simple: we already know many of the solutions. What we lack is a political system willing to implement them properly. In my day job, I'm the Chief Executive of WWF-New Zealand. Prior to that, I served in New Zealand's public service and in the private sector."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyy82",
      "name": "Priority 1",
      "value": "Address Wellington's infrastructure deficit with a 30-Year National Infrastructure Plan."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyyAD",
      "name": "Priority 2",
      "value": "Make Wellington climate resilient by getting ahead of climate adaptation risks and natural hazards."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyyCO",
      "name": "Priority 3",
      "value": "Revitalise Wellington's local economy by driving innovation, investment, and productivity growth."
     }
    ],
    "party": {
     "name": "Opportunity Party"
    },
