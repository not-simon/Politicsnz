   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqoyxoR",
      "name": "Why I'm standing",
      "value": "I'm here to keep fighting for what matters to all of us. There's too many today who are struggling with high bills, who can't pay their rent or find a home, and need more affordable and frequent buses and trains. We can take action on climate change that also lowers the cost of living – both cutting emissions and taking steps today to ensure our communities are protected from its worst effects."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyxqc",
      "name": "About me",
      "value": "I've been a Green MP for 15 years, and the MP for Rongotai since 2023. I love the many diverse communities who call the south coast, Newtown and eastern suburbs of Wellington home, as well as the Chatham Islands. Over the past 3 years, my team and I have worked to help anyone who needs it. I would love to keep representing and helping the people of Wellington Bays, which includes Mt Cook & Brooklyn."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyxsn",
      "name": "Priority 1",
      "value": "Tackling the cost of living crisis with affordable housing, transport, power & public transport."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyxuy",
      "name": "Priority 2",
      "value": "Restoring nature and building climate resilience to flooding & sea level rise."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyxx9",
      "name": "Priority 3",
      "value": "Taxing the super rich so we can invest in essential public services (eg health care) for all of us."
     }
    ],
