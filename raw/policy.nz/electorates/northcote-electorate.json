   {
    "attributes": [
     {
      "_key": "lXvsWGt582gEfwb36036Kd",
      "name": "Why I'm standing",
      "value": "I am running to be a strong voice for the Northcote electorate and to bring practical, conservative values to Parliament. I believe in personal responsibility, strong families, safer communities, lower taxes and responsible government. I want to advocate for better healthcare, lower living costs and greater opportunities for families and businesses."
     },
     {
      "_key": "lXvsWGt582gEfwb36036Ph",
      "name": "About me",
      "value": "I believe New Zealand needs practical, accountable leadership that puts families, communities and essential services first. I want to bring my experience in healthcare and community service to Parliament and advocate for better access to healthcare, stronger communities, and responsible government."
     },
     {
      "_key": "lXvsWGt582gEfwb36036Ul",
      "name": "Priority 1",
      "value": "Improve healthcare access for essential health services for Northcote residents and affordable GPs"
     },
     {
      "_key": "lXvsWGt582gEfwb36036Zp",
      "name": "Priority 2",
      "value": "Support families and businesses, reduce living costs, support local jobs, strengthen local economy"
     },
     {
      "_key": "lXvsWGt582gEfwb36036et",
      "name": "Priority 3",
      "value": "Work with local communities to improve public safety, transport links, roads and shared spaces"
     }
