   {
    "attributes": [
     {
      "_key": "lXvsWGt582gEfwb36033EB",
      "name": "Why I'm standing",
      "value": "I'm running because everyday New Zealanders should be able to expect more: a warm home they can afford to heat, affordable groceries, and a healthy environment with clean rivers and swimmable beaches. We need a government that puts the voices of our communities ahead of fast track donors. For over thirty years, the Green Party has consistently championed that vision, and it's why I'm proud to stand for the Greens."
     },
     {
      "_key": "lXvsWGt582gEfwb36033JF",
      "name": "About me",
      "value": "After training as a lawyer, I have spent my career understanding how big business operates and holding it to account. But I also know that lasting change comes from people. I've spent years working and leading grassroots organisations to support the arts and our rainbow communities. I'd bring all of that to our Green team in parliament."
     },
     {
      "_key": "lXvsWGt582gEfwb36033OJ",
      "name": "Priority 1",
      "value": "Affordable food, power, transport and living, for all of us."
     },
     {
      "_key": "lXvsWGt582gEfwb36033TN",
      "name": "Priority 2",
      "value": "Ensuring the health of the Waitematā so we can all swim and fish at our local beaches."
     },
     {
      "_key": "lXvsWGt582gEfwb36033YR",
      "name": "Priority 3",
      "value": "A government that empowers our communities instead of big corporations and donors."
     }
    ],
