   {
    "attributes": [
     {
      "_key": "lXvsWGt582gEfwb36033iZ",
      "name": "Why I'm standing",
      "value": "I have seen the challenges of our health system first hand and my experience working in Ambulance and the North Shore Emergency Department made me want to be a driver of systemic change for patients and staff. I see our policies as working towards a better, more equitable Aotearoa NZ, improving health care access, cleaning up our politics and addressing the cost of living crisis that Kiwis are bearing the brunt of."
     },
     {
      "_key": "lXvsWGt582gEfwb36033nd",
      "name": "About me",
      "value": "I have lived in and served this community as a Paramedic and have seen the realities of how people are struggling. I want to continue to serve and advocate for the people living in the area, bringing a voice for their concerns to the party. I bring the same passion I have for my patients to parliament. I want to work to reach consensus across issues and fix these for our community."
     },
     {
      "_key": "lXvsWGt582gEfwb36033sh",
      "name": "Priority 1",
      "value": "Improve healthcare access and patient outcomes through long-term planning and cross-party agreement."
     },
     {
      "_key": "lXvsWGt582gEfwb36033xl",
      "name": "Priority 2",
      "value": "Reduce cost of living pressure for Kiwis through our abundant energy & breakthrough economy policies."
     },
     {
      "_key": "lXvsWGt582gEfwb360342p",
      "name": "Priority 3",
      "value": "Bring back the trust into politics through regulating lobbyists and reforming political donations."
     }
    ],
