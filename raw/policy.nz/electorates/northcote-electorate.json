   {
    "attributes": [
     {
      "_key": "lXvsWGt582gEfwb36034hL",
      "name": "Why I'm standing",
      "value": "I'm running for Northcote because I've spent 25 years building things from nothing with no budget and no permission, and this electorate needs someone who actually shows up and does the work, not just talks about it. There's a monster in me that doesn't like sitting on the sidelines and wants to make a difference."
     },
     {
      "_key": "lXvsWGt582gEfwb36034mP",
      "name": "About me",
      "value": "I'd make a good rep because I like to solve real problems with no safety net, and that same instinct to read the room, find what's broken and fix it fast, is exactly what Wellington needs more of."
     },
     {
      "_key": "lXvsWGt582gEfwb36034rT",
      "name": "Priority 1",
      "value": "Seniors first: protect super, speed up Pharmac, fix social housing wait times."
     },
     {
      "_key": "lXvsWGt582gEfwb36034wX",
      "name": "Priority 2",
      "value": "Safer streets, victims first: back police to actually police our neighbourhoods."
     },
     {
      "_key": "lXvsWGt582gEfwb360351b",
      "name": "Priority 3",
      "value": "Backing local business: fair costs, sensible rules, and support to keep doors open."
     }
    ],
