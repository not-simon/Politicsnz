   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqoyrhZ",
      "name": "Why I'm standing",
      "value": "I want New Zealand to become a more prosperous, self-reliant and proud nation, to improve the lives, wellbeing and sense of identity of all New Zealanders. To achieve this I want to use my experience to contribute to better policies and actions for developing and managing our energy resources, building the capacity of our manufacturing businesses to lift productivity and employment, and ensure wise planning and value for money in land transport infrastructure."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyrjk",
      "name": "About me",
      "value": "I am a fifth generation New Zealander from a farming background and a family heritage of pioneering in aviation and architecture. With degrees in law and economics, I was the inaugural CEO for two government agencies and a Council-owned company in the energy and land transport sectors. My management career includes 11 years with Fletcher Challenge, and running several small businesses. Recently I have advocated for tackling manufacturers' challenges with natural gas supply and pricing."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyrlv",
      "name": "Priority 1",
      "value": "Support balanced residential, commercial, hospitality and retail intensification and development."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyro6",
      "name": "Priority 2",
      "value": "Contribute to policies that foster orderly traffic movement and constrain congestion."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyrqH",
      "name": "Priority 3",
      "value": "Maintain law, order and civic safety, via law enforcement and relationships with government agencies."
     }
    ],
