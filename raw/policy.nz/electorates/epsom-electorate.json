   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqoyrHR",
      "name": "Why I'm standing",
      "value": "Representing Epsom has always been my first and most important job. I'm standing again because I want to keep serving my neighbours, helping people when they get a raw deal from government or council, and making sure Epsom's values are heard in Parliament. Our community believes in aspiration, education, enterprise and personal responsibility. I want to keep standing up for those values and delivering practical results as your hardworking and proven MP."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyrJc",
      "name": "About me",
      "value": "I've represented Epsom since 2014 and built an experienced electorate team that has helped thousands of local people with problems ranging from immigration and taxation to education and regulation. I listen, I'm accessible, and I'm prepared to pursue issues until we get a result – my longest-running constituency case is over 10 years. I also understand Epsom's character and values, and have a strong record of speaking up for them both locally and in Parliament."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyrLn",
      "name": "Priority 1",
      "value": "Be a responsive and effective local MP for every constituent, regardless of politics."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyrNy",
      "name": "Priority 2",
      "value": "Ensure housing growth is matched by the infrastructure, transport and services Epsom needs."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyrQ9",
      "name": "Priority 3",
      "value": "Protect Epsom's character while keeping it a safe, thriving place to live, work and raise a family."
     }
    ],
