   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6jcB",
      "name": "Why I'm standing",
      "value": "Our ability to focus on the important issues is at risk due to an oversaturated media environment and a lack of political vision. I want to help build a media environment that educates, informs and entertains without draining our attention, a political system where we discuss complicated issues in a nuanced, constructive manner, and a fair, modern tax system that affords every Kiwi equal opportunity to engage with democracy."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6je6",
      "name": "About me",
      "value": "I'm not a career politician; I'm a visual storyteller. I've been a director, post-production specialist and a teacher in the film and television industry for nearly a decade, and I understand the importance of creativity around the decision-making table. I'm comfortable leading a team, communicating clearly and listening to others before making decisions. I'm an optimist; I try not to take myself too seriously and I don't judge others."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6jg1",
      "name": "Priority 1",
      "value": "Engage with the Remutaka community to ensure that I've heard their views, concerns and priorities."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6jhw",
      "name": "Priority 2",
      "value": "Expand healthcare services across Upper Hutt, with more GPs and shorter wait times."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6jjr",
      "name": "Priority 3",
      "value": "Improve transport across the Hutt Valley, with better trains, buses, cycling, and walking options."
     }
    ],
