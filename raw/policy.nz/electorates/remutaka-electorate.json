   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6jQf",
      "name": "Why I'm standing",
      "value": "Aotearoa New Zealand has the opportunity, capacity and pluck to face the challenges of the 21st Century with the urgency and scale required - if we can muster the political will to do it. I believe the Greens have the strength of purpose and the values to set us in the right direction so the future is better for all of us - and I'm very happy to help this happen."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6jSa",
      "name": "About me",
      "value": "I find value in volunteering for the benefit of my local community, and causes that benefit the country. I respect facts established by good science and my career has involved developing programmes, policy and actions that give effect to this knowledge. In the political realm, I will always push for scale and speed when responding to the opportunities and increasingly dangerous threats coming in this century."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6jUV",
      "name": "Priority 1",
      "value": "Represent the needs of residents in parliamentary debates and processes."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6jWQ",
      "name": "Priority 2",
      "value": "Ensure laws and regulations enable Remutaka people to live lives with dignity, meaning and purpose."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6jYL",
      "name": "Priority 3",
      "value": "Work on the cost of living by reforming tax and income support systems so 96% of us pay less tax."
     }
    ],
