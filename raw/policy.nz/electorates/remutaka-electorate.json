   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6jzD",
      "name": "Why I'm standing",
      "value": "I'm running because I believe politics should be about creating opportunities for people and making sure our communities have a real voice in the decisions that affect them. I want New Zealand to be a country where people can work hard, get ahead and feel confident about the future. For me, that means making good decisions with the resources we have and focusing on practical improvements to people's everyday lives."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6k18",
      "name": "About me",
      "value": "I've spent much of my career working through complex problems, advising decision-makers and turning evidence and ideas into practical solutions. My background spans science, education, strategy, governance and community organisations. I'm naturally curious; I ask a lot of questions and I listen. I'm comfortable hearing different points of view and believe good decisions come from understanding both the evidence and the people affected by them. I'll bring that same approach to Parliament."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6k33",
      "name": "Priority 1",
      "value": "Improve access to healthcare, including after-hours care in Upper Hutt."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6k4y",
      "name": "Priority 2",
      "value": "Advocate for resilient infrastructure and transport that keeps pace with growth."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6k6t",
      "name": "Priority 3",
      "value": "Strengthen pathways into local jobs, trades and training for our young people."
     }
    ],
