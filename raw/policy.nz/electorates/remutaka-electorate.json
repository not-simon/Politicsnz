   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6jF9",
      "name": "Why I'm standing",
      "value": "I've spent my career fighting for a New Zealand where everyone can get ahead. I want to build a country where our kids want to stay with good local jobs and opportunities worth sticking around for. That means an economy that rewards hard work and gives young people a reason to put down roots here at home. Good local jobs, affordable healthcare, and warm homes people can afford to live in."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6jH4",
      "name": "About me",
      "value": "I've devoted my working life to serving the people of New Zealand. I know what it takes to get things done in politics, from leading the country through a global pandemic to securing a record number of apprenticeship opportunities for young Kiwis. I have shown I can get things done."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6jIz",
      "name": "Priority 1",
      "value": "Create good jobs in our local community so that everyone has the chance to get ahead."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6jKu",
      "name": "Priority 2",
      "value": "Ensure everyone has access to healthcare where and when they need it."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6jMp",
      "name": "Priority 3",
      "value": "Make sure everyone has a place to call home with bills they can afford."
     }
    ],
