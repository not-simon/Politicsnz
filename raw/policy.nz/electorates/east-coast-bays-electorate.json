   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6nlN",
      "name": "Why I'm standing",
      "value": "Every family deserves a fair go and a secure future. I want NZ seen as a world-class innovator, backing technology, R&D and new industries that create good jobs. That means responsible innovation: clean energy that lowers bills and protects our environment. A small country can punch above its weight and show the world how it's done. I'll be a strong voice for housing, schools, health, and a future our kids can build here at home."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6nnI",
      "name": "About me",
      "value": "I come from a poor, working-class family, and it was education and sheer determination that lifted me up. That keeps me grounded in the concerns people face every day. My career spans startups, technology and large government projects, building teams, shaping strategy, and solving connected problems at the root. I'm a systems thinker who sees how issues link together, and I'll bring that drive, innovation and accountability to Parliament, always listening first and delivering results."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6npD",
      "name": "Priority 1",
      "value": "Grow innovation and good jobs in Albany Hub so people can build careers close to home, not commute."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6nr8",
      "name": "Priority 2",
      "value": "Strengthen local health services so people get timely care close to home, without long waits away."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6nt3",
      "name": "Priority 3",
      "value": "Deliver affordable housing so young families priced out of the Bays can stay part of the community."
     }
    ],
