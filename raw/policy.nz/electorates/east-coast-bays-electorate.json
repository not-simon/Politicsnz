   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6nZr",
      "name": "Why I'm standing",
      "value": "I want to be a useful part of building a country that, at our core, puts people first ahead of private profits and we want Kiwis to have warm and secure housing, food on the table, and an environment that is looked after, as it looks after us."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6nbm",
      "name": "About me",
      "value": "From my family background of social workers and unionists and my professional career I've developed the ability to meet people where they are, regardless of background or perspective, and speak to people through common values. I've seen how businesses and industry can be shaped to benefit people and the environment, not just markets. In blending these two experiences I aim to help build a country that does just that."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6ndh",
      "name": "Priority 1",
      "value": "Affordable Lives: taxing the rich, lowering power, grocery, transport and other bills."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6nfc",
      "name": "Priority 2",
      "value": "Healthy Nature: ensuring you can drink, swim, and fish in our oceans and rivers."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6nhX",
      "name": "Priority 3",
      "value": "Local decision-making: ensuring your voice is heard."
     }
    ],
