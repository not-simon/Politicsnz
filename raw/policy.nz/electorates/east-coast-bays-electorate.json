   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6oI0",
      "name": "Why I'm standing",
      "value": "I believe NZ can only reach its potential by growing our economy and implementing common sense and bold strategies and policies. I believe NZ First has these."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6oJv",
      "name": "About me",
      "value": "I grew up very working class. I earned a degree in economics and a Master's degree in education. I lived in South Korea for 21 years, and now I work in Auckland prison. I have knowledge and experience, and I believe I can make a positive difference."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6oLq",
      "name": "Priority 1",
      "value": "Economic reform. Buy back the BNZ, break up the supermarket duopoly and electricity gentailers etc."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6oNl",
      "name": "Priority 2",
      "value": "Work to reduce unemployment. "
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6oPg",
      "name": "Priority 3",
      "value": "Actively work to reduce the harm of gangs and criminal behavior."
     }
