   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6nwt",
      "name": "Why I'm standing",
      "value": "I was born and raised in the East Coast Bays so have a deep personal connection to this area. I'm passionate about ensuring East Coast Bays remains one of the best places in New Zealand to live, work, and raise a family. For the last three years, I have also served as Minister of Education and Minister of Immigration. I've led major reforms in both portfolios and have so much more I wish to do."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6nyo",
      "name": "About me",
      "value": "I have represented East Coast Bays since 2017 and have proven my commitment and love for this community. I have remained dedicated to helping residents, including coordinating volunteers after the Auckland Anniversary floods to clear properties and deliver food parcels. I've hosted a lot of events, visited retirement villages, schools and businesses, and participated in local fundraisers and quiz nights. I'm especially proud to have led a successful campaign to save North Harbour Stadium."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6o0j",
      "name": "Priority 1",
      "value": "Continue advocating for East Coast Bays residents who need help navigating government departments."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6o2e",
      "name": "Priority 2",
      "value": "See the Glenvar Road upgrade project finally get underway. It is long overdue and badly needed."
     }
    ],
