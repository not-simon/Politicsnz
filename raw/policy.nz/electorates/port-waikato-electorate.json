   {
    "attributes": [
     {
      "_key": "MBeO7ojrohBwl7F7zAOXH8",
      "name": "Why I'm standing",
      "value": "I want to represent the Port Waikato community where I have grown up, worked and raised my children. I want to support Port Waikato to grow, providing more opportunities for our people to live and work locally, championing the strengths and ever-increasing economic potential of our incredible community. One of the keys to this success is streamlining regulation, right sizing local and central government, while also supporting balanced development to occur in the right places."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOXJy",
      "name": "About me",
      "value": "I was born in Bombay, grew up in South Auckland, having lived and worked in our community for my adult life. I initially trained as an arborist, starting my first business at the age of 23, servicing our community. For the last 12 years, I have worked and led an environmental consultancy firm, solving complex issues in land development and infrastructure. I am a business leader with a skill set built on practical experience."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOXMo",
      "name": "Priority 1",
      "value": "Support and advocate for equitable health services for both our rural and urban communities."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOXPe",
      "name": "Priority 2",
      "value": "Work to support the improved alignment of emergency service boundaries across Port Waikato."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOXSU",
      "name": "Priority 3",
      "value": "Advocate for more local trade training opportunities and options for youth employment."
     }
    ],
