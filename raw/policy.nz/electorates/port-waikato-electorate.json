   {
    "attributes": [
     {
      "_key": "MBeO7ojrohBwl7F7zAOWj4",
      "name": "Why I'm standing",
      "value": "New Zealand is a country of enormous potential that needs to have that potential unlocked to deliver economic prosperity and social cohesion. NZ has been a world leader and can be again but this requires politicians with practical experience, common sense, and a commitment to working hard. Every three years voters get to decide who will best serve them. I offer experience, common sense and commitment to working hard for New Zealanders."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOWlu",
      "name": "About me",
      "value": "I have lived and worked most of my life in South Auckland. I have raised my children here, served 14 years in the NZ Police, Pokeno is my home. For the last three years I have been an NZ First list MP and Minister of Customs, for Seniors and Associate Minister of Health, Police and Immigration. I will hit the ground running to deliver the best outcomes for Port Waikato."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOWok",
      "name": "Priority 1",
      "value": "Tangible health system reform focused on prevention and keeping New Zealanders well"
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOWra",
      "name": "Priority 2",
      "value": "Tackling organised crime and the crippling impacts it has on our communities."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOWuQ",
      "name": "Priority 3",
      "value": "Improving lives for our seniors - housing, connection, safety, cost of living and legal protections"
     }
    ],
