   {
    "attributes": [
     {
      "_key": "MBeO7ojrohBwl7F7zAOX06",
      "name": "Why I'm standing",
      "value": "My personal values are founded in equality, co-operation and opportunity for all. I believe hard work should be rewarded and people should be able to \"get ahead\". I also believe in the social contract, that as a society we need to look after each other, especially the most vulnerable amongst us. We need to live in a society where we treat each other with compassion and dignity."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOX2w",
      "name": "About me",
      "value": "I live locally with my family. I am passionate about creating change and opportunities for all Kiwis, but particularly for our young. Before teaching, I worked in the fuel industry, national newspaper advertising & technology. 13 years ago, I decided to retrain as a teacher, and have brought my wide range of skills and experience to benefit young people in South Auckland across primary, intermediate and secondary schools. I also serve on a school board."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOX5m",
      "name": "Priority 1",
      "value": "Cost of living, without a doubt, is the top priority for all constituents in Port Waikato."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOX8c",
      "name": "Priority 2",
      "value": "The availability and affordability of healthcare is a strong second."
     },
     {
      "_key": "MBeO7ojrohBwl7F7zAOXBS",
      "name": "Priority 3",
      "value": "Jobs, especially for our young people. As an educator I know firsthand the challenges being faced."
     }
    ],
