  "candidates": [
   {
    "attributes": [
     {
      "_key": "lXvsWGt582gEfwb3603Yq9",
      "name": "Why I'm standing",
      "value": "I want to ensure Ikaroa-Rawhiti retains a strong voice as we navigate the key issues impacting our whanau: the cost of living, jobs, health, homes, education and the role of Te Tiriti across these kaupapa. I want to be part of building a more affordable Aotearoa. Kia eke inainei - better starts now!"
     },
     {
      "_key": "lXvsWGt582gEfwb3603YvD",
      "name": "About me",
      "value": "As the sitting MP I've spent the past three years moving amongst the communities in the electorate and bringing their voices to Parliament. I've learnt the political systems and am now prepared to represent the people of Ikaroa-Rawhiti in Government."
     },
     {
      "_key": "lXvsWGt582gEfwb3603Z0H",
      "name": "Priority 1",
      "value": "Labour will cut whānau costs with Solar Saver, tackling one of the biggest bills: energy."
     },
     {
      "_key": "lXvsWGt582gEfwb3603Z5L",
      "name": "Priority 2",
      "value": "Labour will improve access to healthcare with free GP visits, screenings and prescriptions."
     },
     {
      "_key": "lXvsWGt582gEfwb3603ZAP",
      "name": "Priority 3",
      "value": "Labour backs Kiwis into jobs, with Future Fund, small business support and trades training."
     }
    ],
