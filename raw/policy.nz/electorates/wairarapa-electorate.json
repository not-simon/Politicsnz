   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWMqC",
      "name": "Why I'm standing",
      "value": "I'm standing because I believe we can do better. We're facing a cost of living crisis, a climate crisis, and an inequality crisis. Too many people are trying to shift the blame onto vulnerable communities instead of addressing the root causes of these issues. I am standing with the Green Party because we want to change things, and we're proposing the sort of big policies that will make a real difference."
     },
     {
      "_key": "227mFCOl8uclHuS5roWMt1",
      "name": "About me",
      "value": "I am a relentless advocate for change, and that is the passion I would bring with me to Parliament. In 2022, I co-founded Students for Climate Solutions and took the Government to court for allowing of oil and gas exploration in Taranaki. Following that, I organised the campaign against the Government's ban on puberty blockers. I've worked in politics and public policy, and would love to use these skills for all of us."
     },
     {
      "_key": "227mFCOl8uclHuS5roWMvq",
      "name": "Priority 1",
      "value": "Affordable Lives- taxing the rich, lowering power, grocery, transport and other bills."
     },
     {
      "_key": "227mFCOl8uclHuS5roWMyf",
      "name": "Priority 2",
      "value": "Healthy Nature- Ensuring you can drink, swim, and fish in our oceans and rivers."
     },
     {
      "_key": "227mFCOl8uclHuS5roWN1U",
      "name": "Priority 3",
      "value": "Decisions in your hands- making sure your voice is heard."
     }
    ],
