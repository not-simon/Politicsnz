   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWN78",
      "name": "Why I'm standing",
      "value": "I have been disappointed with the lack of vision in our current parties. I am running for Opportunity because we are boldly looking at the long-term solutions to the issues facing everyday Kiwis. Not short term election promises. We deserve better."
     },
     {
      "_key": "227mFCOl8uclHuS5roWN9x",
      "name": "About me",
      "value": "As a teacher I have worked with a lot of children and their families around New Zealand. I do not accept the current system as good enough. I am driven by empathy informed by regular face-to-face contact."
     },
     {
      "_key": "227mFCOl8uclHuS5roWNCm",
      "name": "Priority 1",
      "value": "Improving the welfare of our tamariki. They deserve consistency and safety, and hope for the future."
     },
     {
      "_key": "227mFCOl8uclHuS5roWNFb",
      "name": "Priority 2",
      "value": "Making it easier to access vital healthcare, especially getting in to see a GP."
     },
     {
      "_key": "227mFCOl8uclHuS5roWNIQ",
      "name": "Priority 3",
      "value": "Helping build stronger communities where people can support each other and their environments."
     }
    ],
