    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWBBc",
      "name": "Why I'm standing",
      "value": "I have lived in a few different countries in the world and New Zealand is the best one I've lived in. However, lately, I've become worried about the demise of liberal democracy in NZ due to the encroachment of an ideology that sees certain ancestry demand privileges over other citizens. Act is the only party that is prepared to tackle this head-on."
     },
     {
      "_key": "227mFCOl8uclHuS5roWBER",
      "name": "About me",
      "value": "I've lived in the Tauranga area for 18 years after retiring from Auckland."
     },
     {
      "_key": "227mFCOl8uclHuS5roWBHG",
      "name": "Priority 1",
      "value": "Ensure that contractors employed by the council are chosen on meritocracy rather than on ideology."
     },
     {
      "_key": "227mFCOl8uclHuS5roWBK5",
      "name": "Priority 2",
      "value": "Encourage the creation of charter schools in the area."
     },
     {
      "_key": "227mFCOl8uclHuS5roWBMu",
      "name": "Priority 3",
      "value": "Accountability on performance of councils."
     }
    ],
    "party": {
     "name": "ACT Party"
    },
