   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWBVN",
      "name": "Why I'm standing",
      "value": "I'm running because I believe government should make a practical difference in people's everyday lives—so every child has the opportunity to succeed, every worker is treated with dignity, and every community in Tauranga feels safe, supported, and heard."
     },
     {
      "_key": "227mFCOl8uclHuS5roWBYC",
      "name": "About me",
      "value": "I bring experience, resilience, and a strong focus on outcomes. My background as an educator means I listen well, build consensus, and stay focused on what works for families and communities. I'm a proud Tauranga local who knows both the challenges of rapid growth and the opportunities ahead for our city. My commitment is to fairness, inclusion, and opportunity and to building a fairer, more inclusive New Zealand, starting here in the Bay."
     },
     {
      "_key": "227mFCOl8uclHuS5roWBb1",
      "name": "Priority 1",
      "value": "I'm focused on easing the cost-of-living pressures as Tauranga residents are hurting."
     },
     {
      "_key": "227mFCOl8uclHuS5roWBdq",
      "name": "Priority 2",
      "value": "Protecting and strengthening workers' rights in Tauranga to ensure people have well paid jobs"
     },
     {
      "_key": "227mFCOl8uclHuS5roWBgf",
      "name": "Priority 3",
      "value": "Faster, fairer access to health services so Tauranga people aren't left waiting when they're unwell"
     }
    ],
