   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWBmJ",
      "name": "Why I'm standing",
      "value": "I am standing because I want to see a country that plans for the long term, one that invests in restoring our environment, builds resilient communities, and creates a New Zealand where people want to stay. We should recognise what makes our country unique and build on those strengths. Our natural environment is central to who we are, our economy relies on it, and it's what makes us proud to be Kiwi."
     },
     {
      "_key": "227mFCOl8uclHuS5roWBp8",
      "name": "About me",
      "value": "My background in architecture has taught me to solve problems holistically and think long term. I don't just think about how a building works today, but how it will perform and adapt over the next 20–50 years. I believe Parliament needs more of that long-term thinking. I'm also passionate about cities and creating places that are sustainable, connected and designed around the people who live in them."
     },
     {
      "_key": "227mFCOl8uclHuS5roWBrx",
      "name": "Priority 1",
      "value": "Healthy Oceans - restore & protect 30%, rebuild our fish stocks & phase out destructive fishing."
     },
     {
      "_key": "227mFCOl8uclHuS5roWBum",
      "name": "Priority 2",
      "value": "Energy resilience, move away from fossil fuels and create a country that runs on electricity."
     },
     {
      "_key": "227mFCOl8uclHuS5roWBxb",
      "name": "Priority 3",
      "value": "Reduce congestion, build smarter around transport hubs and reduce our dependency on cars."
     }
    ],
