     {
      "_key": "4mT89K6PpYj5QRKx0f6U2k",
      "name": "Why I'm standing",
      "value": "I believe I can make a positive difference to the lives of Hutt South residents and New Zealand citizens. The vehicle to do this is through the policies of New Zealand First."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6U4f",
      "name": "About me",
      "value": "I have actively lived in our community for over 55 years successfully operating small to medium-size businesses employing staff."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6U6a",
      "name": "Priority 1",
      "value": "Ease the cost-of-living crisis and household financial pressure."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6U8V",
      "name": "Priority 2",
      "value": "Prioritise transport and infrastructure that is fit for purpose."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6UAQ",
      "name": "Priority 3",
      "value": "Provide community safety and economic opportunity."
     }
