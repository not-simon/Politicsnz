   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6UPm",
      "name": "Why I'm standing",
      "value": "I'm asking for the support of voters again at this election so I can keep working hard and getting things done for the Hutt."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6URh",
      "name": "About me",
      "value": "Lower Hutt is where I was born and raised and it's where Jenna and I are raising our family. I've had the privilege of being an MP in the Hutt now since 2014 and I think I'm making a difference. I'm keen to keep up the hard work."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6UTc",
      "name": "Priority 1",
      "value": "Better transport infrastructure - trains and buses, the Cross Valley Link and Petone to Grenada."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6UVX",
      "name": "Priority 2",
      "value": "Health - more doctors and nurses for the Hutt"
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6UXS",
      "name": "Priority 3",
      "value": "Education - continuing National's education reform agenda - Teaching the Basics and replacing NCEA"
     }
    ],
