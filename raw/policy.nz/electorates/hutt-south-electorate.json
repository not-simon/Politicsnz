   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6UbI",
      "name": "Why I'm standing",
      "value": "I want to stand up for the voices and lives our system can too often silence - working people, children and young people, older people, animals and nature. I want to stand and challenge a political system too often shaped around corporate greed and private profit, rather than what our communities need and deserve. I believe Aotearoa has everything we need to thrive. We just need the political will to share it fairly."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6UdD",
      "name": "About me",
      "value": "I deeply care about the future of this country, and this little corner of it. I'm born and bred in Hutt South, and I'll fight to make sure it's a place our kids want to stay, work and live. I've spent my career storytelling through journalism and communications, advocating for people, animals and our beautiful planet."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6Uf8",
      "name": "Priority 1",
      "value": "Affordable Lives - lowering power bills, grocery and transport costs, through a fairer tax system."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6Uh3",
      "name": "Priority 2",
      "value": "Healthy Nature - ensuring you can actually drink, swim, and fish in our oceans and rivers."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6Uiy",
      "name": "Priority 3",
      "value": "Healthy people - healthcare for all, from hospitals and GPs to warm homes and good kai."
     }
    ],
