   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6UEG",
      "name": "Why I'm standing",
      "value": "Over my adult lifetime I've seen New Zealand become a place that's harder and harder to make a decent living in. Home ownership rates are dropping, wages aren't keeping up with costs, and there's little time left over for family and community after the work is done and the bills are paid. I couldn't stand on the sidelines and just watch; I felt I needed to step up and try to make a positive difference."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6UGB",
      "name": "About me",
      "value": "I'm here to make a difference, not to fill a seat. I'm serious about facing up to our country's challenges. I'm highly respectful of evidence in making tough decisions. I care deeply about the people of our community and our country, and I have the integrity to speak plainly."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6UI6",
      "name": "Priority 1",
      "value": "Increase funding for R&D to raise our productivity and make us more competitive with the world."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6UK1",
      "name": "Priority 2",
      "value": "Build more housing to lower the cost for young people so they don't feel they have to leave."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6ULw",
      "name": "Priority 3",
      "value": "Build abundant renewable energy to lower the cost of energy and help us reduce fossil fuel use."
     }
    ],
