   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6Rmd",
      "name": "Why I'm standing",
      "value": "I am running because I believe people have become too distant from the decisions that shape their lives. I want to change the system so that the voice of the people matters between elections, not just once every three years. I support binding referenda and direct democracy, giving communities a meaningful say over the laws and policies that affect them. For me, tino rangatiratanga begins with people having a real voice."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6RoY",
      "name": "About me",
      "value": "I listen, I question assumptions, and I am prepared to challenge systems when they are not serving people. My work has involved helping people navigate legal and government processes, often when they feel their voices are not being heard. I believe an elected representative should remain accountable to the people they represent, respect individual rights and different perspectives, and be willing to ask difficult questions rather than simply follow the established political path."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6RqT",
      "name": "Priority 1",
      "value": "Give Northlanders a binding voice through referenda on the decisions that affect their communities."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6RsO",
      "name": "Priority 2",
      "value": "Strengthen local food security by supporting growers and farmers and removing unnecessary regulation"
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6RuJ",
      "name": "Priority 3",
      "value": "Make housing and essential services more accessible by removing barriers that stop people thriving"
     }
    ],
