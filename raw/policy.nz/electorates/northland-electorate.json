   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6R6P",
      "name": "Why I'm standing",
      "value": "I want Northland's voice to be heard and our communities to have the opportunities they deserve. I believe in listening to our communities, backing local solutions and working together to deliver practical change. Northland has enormous potential, and I want to help unlock it through better healthcare, good local jobs and opportunities for our young people. Because if it's good for Northland, it's good for New Zealand."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6R8K",
      "name": "About me",
      "value": "I understand Northland's communities and the challenges and opportunities facing our region. I listen to local people, value different perspectives and believe the best solutions are grounded in the communities they serve. I will bring a practical, collaborative approach to Parliament and be a strong advocate for Northland. I'll work hard, stay connected to our communities and make sure local voices are heard when decisions affecting our region are made."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6RAF",
      "name": "Priority 1",
      "value": "Reduce cost-of-living pressures so Northland families can afford the essentials and get ahead."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6RCA",
      "name": "Priority 2",
      "value": "Improve healthcare access so Northlanders get the right care, closer to home, when they need it."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6RE5",
      "name": "Priority 3",
      "value": "Create stronger pathways for young Northlanders into education, training and good local jobs."
     }
    ],
