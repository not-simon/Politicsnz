   },
   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWDVZ",
      "name": "Why I'm standing",
      "value": "I am running for Parliament because I believe New Zealand can do better. I put my hand up for public office because I became increasingly frustrated by a lack of accountability, poor value for money and decisions being made by large bureaucratic organisations that seem too far removed from the people they are supposed to serve."
     },
     {
      "_key": "227mFCOl8uclHuS5roWDYO",
      "name": "About me",
      "value": "My background has given me a broad understanding of New Zealand life. I have worked in business, education and research, owned and operated small businesses, and built a rural farming enterprise with my husband. I understand the pressures facing families, small businesses, farmers and rural communities because I have lived and worked alongside them."
     },
     {
      "_key": "227mFCOl8uclHuS5roWDbD",
      "name": "Priority 1",
      "value": "Advocate for better value and accountability from rates and taxes. Reduce red, green, brown tape."
     },
     {
      "_key": "227mFCOl8uclHuS5roWDe2",
      "name": "Priority 2",
      "value": "Support sensible immigration policy that puts NZers first and protects rights for citizens."
     },
     {
      "_key": "227mFCOl8uclHuS5roWDgr",
      "name": "Priority 3",
      "value": "Advocate for opportunities that provide training, employment and business opportunities."
     }
    ],
