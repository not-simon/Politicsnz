   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWDEd",
      "name": "Why I'm standing",
      "value": "I want to create a better future for my children and their peers. New Zealand has so much untapped potential, but we need politicians working together to make this future possible."
     },
     {
      "_key": "227mFCOl8uclHuS5roWDHS",
      "name": "About me",
      "value": "I have a rich background spanning academia, entrepreneurship, project management, and policy development. Professionally, I bridge science, business, and public service. I thrive in collaborative environments and kotahitanga is a value I live by. I have worked, lived and/or attended Playcentre in my electorate most of my life."
     },
     {
      "_key": "227mFCOl8uclHuS5roWDKH",
      "name": "Priority 1",
      "value": "Clean up politics: Cap donations; prohibit misleading political ads; register all lobbying."
     },
     {
      "_key": "227mFCOl8uclHuS5roWDN6",
      "name": "Priority 2",
      "value": "Innovate our economy: Invest in science, research and development; allow \"Impact Company\" deductions."
     },
     {
      "_key": "227mFCOl8uclHuS5roWDPv",
      "name": "Priority 3",
      "value": "Build a 10-year, cross-party plan for Education, back NZ teachers, and lift quality in ECCE."
     }
    ],
