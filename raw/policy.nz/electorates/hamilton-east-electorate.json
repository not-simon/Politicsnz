  "candidates": [
   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWCxh",
      "name": "Why I'm standing",
      "value": "I believe we can have an affordable NZ, where everyone can get ahead. My priorities are good jobs, affordable healthcare and lower household bills - so working hard means having more left at the end of the week, more certainty for your family, and a better chance to build a future here at home."
     },
     {
      "_key": "227mFCOl8uclHuS5roWD0W",
      "name": "About me",
      "value": "I've lived and worked in Hamilton for twenty years, and am choosing to raise my children in this awesome city. I'm a former teacher, business owner and a union leader. I've spent my career advocating for workers and communities in Kirikiriroa, giving me a deep connection to Hamilton and our communities. We have a diversity of needs in Hamilton, and everyone deserves to have their voice represented in parliament."
     },
     {
      "_key": "227mFCOl8uclHuS5roWD3L",
      "name": "Priority 1",
      "value": "Bringing down the cost of living - food, fuel, and household bills."
     },
     {
      "_key": "227mFCOl8uclHuS5roWD6A",
      "name": "Priority 2",
      "value": "Affordable primary health care, starting with 3 free GP visits and free prescriptions"
     },
     {
      "_key": "227mFCOl8uclHuS5roWD8z",
      "name": "Priority 3",
      "value": "Good well-paid jobs, where everyone can get ahead."
     }
    ],
    "party": {
