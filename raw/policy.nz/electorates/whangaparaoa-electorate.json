   },
   {
    "attributes": [
     {
      "_key": "lXvsWGt582gEfwb3603A0X",
      "name": "Why I'm standing",
      "value": "I fundamentally believe that we can have a thriving country and a strong economy without it coming at the cost of looking after people or the planet. Locally, our community deserves a strong, active and more engaged representative. I believe I can be a fresh, bold, sensible and empathetic voice for Whangaparāoa."
     },
     {
      "_key": "lXvsWGt582gEfwb3603A5b",
      "name": "About me",
      "value": "Waiheke born & Whangaparāoa raised, to a kiwi dad and Spanish mum, I'm a proud coastie. Over the last 3 years, I've seen the cost of living hurt our community deeply. I'm passionate about making sure that everyone has a fair go at a good life here, from our youth to our seniors. I teach at local schools, volunteer with our community Marae, and am a self-proclaimed policy nerd who's deeply committed to our community."
     },
     {
      "_key": "lXvsWGt582gEfwb3603AAf",
      "name": "Priority 1",
      "value": "Ensuring that everyone has access to public healthcare they can afford when they need it."
     },
     {
      "_key": "lXvsWGt582gEfwb3603AFj",
      "name": "Priority 2",
      "value": "Ensuring that we have good jobs available that pay the bills & give a life of dignity."
     },
     {
      "_key": "lXvsWGt582gEfwb3603AKn",
      "name": "Priority 3",
      "value": "Protecting our public and green spaces like Tiritiri Matangi, Te Weiti River & Shakespear Park."
     }
    ],
