   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqoylcs",
      "name": "Why I'm standing",
      "value": "I'm stepping up and contesting because West Coast-Tasman has no genuine representation where a local focus is prioritized. This region has an abundance of natural resources and skilled people who can harness those resources while maintaining an environmental synergy. Many talk about the problems, and hope others will solve those problems. I decided if I want to see real and substantive change, then that change starts with me."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoylf3",
      "name": "About me",
      "value": "I live in Murchison and have a business here. I travel throughout the region extensively and converse with many people. We have some great minds and skilled people who have the ability to solve the issues we all face. The problem has been 'action' and that is where I believe I will facilitate solutions for those problems. We're all in this mess together. Together, we can get ourselves out of it."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoylhE",
      "name": "Priority 1",
      "value": "Harnessing our regional natural resources while ensuring best environmental practices."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyljP",
      "name": "Priority 2",
      "value": "Local business opportunities over multi-national corporations and removing bureaucratic red tape."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoylla",
      "name": "Priority 3",
      "value": "Greater local decision-making as opposed to the usual centralized out-of-touch authorities."
     }
    ],
