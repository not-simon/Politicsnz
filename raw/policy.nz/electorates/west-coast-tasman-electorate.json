   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqoykvK",
      "name": "Why I'm standing",
      "value": "I'm running because I've had enough of watching common sense lose to process.  As a rural business owner, I know how frustrating unnecessary bureaucracy, waste and poor decision-making can be. I want to bring a practical, real-world perspective to Parliament and make sure my community has a strong voice.  I believe government should focus on what matters, trust people to get on with things, listen before it talks, and actually get things done."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoykxV",
      "name": "About me",
      "value": "I'd make a good representative because I'm practical, approachable and prepared to listen. I've built businesses, raised a family and spent years working with people from all walks of life. I understand the pressures households and businesses face because I've experienced them myself. I won't pretend to have all the answers, but I will ask the hard questions, challenge unnecessary bureaucracy and work constructively to get better outcomes for my community and New Zealand."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoykzg",
      "name": "Priority 1",
      "value": "Unlock our resources, create jobs, attract investment and make our electorate NZ's resource hub."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyl1r",
      "name": "Priority 2",
      "value": "Cut red tape and compliance costs so local businesses, farmers and communities can get on with it."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyl42",
      "name": "Priority 3",
      "value": "Fix Knights Point permanently so road closures don't keep cutting off the Coast and tourism."
     }
    ],
