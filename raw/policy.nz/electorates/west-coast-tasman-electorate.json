     {
      "_key": "RIU5sv1nWnkj6dpEqoykVC",
      "name": "Why I'm standing",
      "value": "I have lived and worked here. I know how hard it is sometimes to just keep going. To feel like no one is listening. At some point I decided to stop just complaining about it and actually do something about it."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoykXN",
      "name": "About me",
      "value": "This is my home; it always will be. Whether I am elected to represent my community or not, I will still be here to support it."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoykZY",
      "name": "Priority 1",
      "value": "Better connections between communities, to each other and to services."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoykbj",
      "name": "Priority 2",
      "value": "A real solution to the postcode lottery with our most basic services."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoykdu",
      "name": "Priority 3",
      "value": "A long-term vision for the future and to listen to and involve communities in that vision."
     }
