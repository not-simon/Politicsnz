   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqoykI8",
      "name": "Why I'm standing",
      "value": "I have always supported community and love the clean green NZ image we used to have and I want it back. Our planet is in trouble and we are facing more devastating climate impact issues than ever before and if we do nothing then the future for our children looks grim. I believe The Green Party will create a better life for all Kiwis and create an affordable lifestyle for young and old."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoykKJ",
      "name": "About me",
      "value": "I am passionate about caring for our community and environment. For creating systems that enable us all to easily contribute to improving our world. I communicate fairly with everyone in an inclusive and kind way and want to encourage our community to interact proactively and responsibly. I know that at heart everyone wants the core values of the Green Party. Look after the planet, the people, work together and be non-violent."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoykMU",
      "name": "Priority 1",
      "value": "Reduce the cost of living! Tax the rich. Reduce power, food, fuel prices. Reduce excessive profits"
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoykOf",
      "name": "Priority 2",
      "value": "Provide clean water to drink, swim, and fish in. Protect our environment for the future."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoykQq",
      "name": "Priority 3",
      "value": "To allow the people a voice in what happens in their community, for their health and wellbeing"
     }
    ],
