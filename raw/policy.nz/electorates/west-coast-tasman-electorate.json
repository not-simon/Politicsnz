   {
    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqoylPo",
      "name": "Why I'm standing",
      "value": "I believe our political system is no longer working for the people. Freedom Party's solution to this is direct democracy where people play an active role in decision making, knowing their views are valued and heard, enabling New Zealanders the freedom from excessive government and international interference. Transparent representation and informed decision making will promote a long-term vision for protecting and promoting the interests of all New Zealanders and our children and grandchildren's future."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoylRz",
      "name": "About me",
      "value": "I will represent my electorate without having to toe a party line or obey a party whip, which allows me to serve the best interests of our region not Wellington. I have travelled to all corners of West Coast Tasman and am passionate about the uniqueness of our communities. Our electorate walks to the beat of its own drum and I will be proud to assist them in continuing to do that."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoylUA",
      "name": "Priority 1",
      "value": "Stop wasteful Govt spending with our direct democracy policy, accountability & transparency framework."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoylWL",
      "name": "Priority 2",
      "value": "Local decisions made by locals: they know what's needed, not unaccountable bureaucrats or politicians."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoylYW",
      "name": "Priority 3",
      "value": "Replace 1080 poison with modern solutions that protect our precious natives and our food basket."
     }
    ],
