    "attributes": [
     {
      "_key": "RIU5sv1nWnkj6dpEqoylpw",
      "name": "Why I'm standing",
      "value": "I believe New Zealand's political dysfunction is systemic — visible in rising poverty, poor health, and declining education. To me, this reflects leadership that lacks integrity, courage, and any genuine vision for the country. I'm standing because grassroots problems need community‑driven solutions, not more neglect. We must prioritise wellbeing over low tax rates, and I believe the wealthy have a real role in our recovery. I want to help restore responsible, sincere decision‑making."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyls7",
      "name": "About me",
      "value": "I've worked across a wide range of roles, from labouring to self‑employment, small business, and tutoring Level 1–4 business administration classes. I currently work with teenagers in a secondary school hostel as a weekend supervisor. I'm the president and sites officer of the Tasman Hang Gliding & Paragliding Club, and a part‑time landlord."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoyluI",
      "name": "Priority 1",
      "value": "Strengthen community and individual wellbeing through stewardship of people and place."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoylwT",
      "name": "Priority 2",
      "value": "Protect our land, rivers, coastline and biodiversity as core kaitiaki roles."
     },
     {
      "_key": "RIU5sv1nWnkj6dpEqoylye",
      "name": "Priority 3",
      "value": "Support fair opportunities so young people can build futures here with dignity."
     }
    ],
