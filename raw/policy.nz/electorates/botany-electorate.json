  "candidates": [
   {
    "attributes": [
     {
      "_key": "5r5sFjSBWMIetVQk4N5QDg",
      "name": "Why I'm standing",
      "value": "I'm running because Botany deserves visible leadership that listens, understands the pressures families face, and delivers practical solutions. As a specialist GP, I've spent years serving communities across South and East Auckland and have seen first-hand the challenges of rising costs, access to healthcare, housing and supporting our young people. Having served in local government and Parliament, I want to use that experience to be a strong voice for Botany and help our community thrive."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5QIu",
      "name": "About me",
      "value": "I bring experience, compassion and a strong record of public service. As a specialist GP, former MP and former local board member, I understand how government decisions affect people's everyday lives. I know how to advocate effectively, navigate government and get things done. I believe good representation means listening, being accessible and showing up. I will work hard across Botany's diverse communities, build strong relationships and be a practical, effective voice for everyone I represent."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5QO8",
      "name": "Priority 1",
      "value": "Ease cost-of-living pressures so working families can afford the basics and build a better future."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5QTM",
      "name": "Priority 2",
      "value": "Strengthen local healthcare so Botany families can access timely, affordable care close to home."
     },
     {
      "_key": "5r5sFjSBWMIetVQk4N5QYa",
      "name": "Priority 3",
      "value": "Support local small businesses to grow, create jobs and build a stronger Botany economy."
     }
    ],
    "party": {
     "name": "Labour Party"
