  "candidates": [
   {
    "attributes": [
     {
      "_key": "227mFCOl8uclHuS5roWPWj",
      "name": "Why I'm standing",
      "value": "I'm running because after 15 years as a paramedic, I've seen what happens when our systems work, and when they fail people. I want to bring that frontline experience to Parliament and focus on practical, evidence-based solutions to the challenges facing Hamilton West and New Zealand. I've spent my career helping people one patient at a time. Running for Parliament is an opportunity to improve the systems that shape people's lives in the first place."
     },
     {
      "_key": "227mFCOl8uclHuS5roWPZY",
      "name": "About me",
      "value": "15 years as a paramedic has taught me to listen, make difficult decisions, communicate clearly and remain accountable for those decisions. I've worked across rural, provincial and urban communities, giving me perspective on the challenges New Zealanders face. I believe good politics should be practical, evidence-based and focused on outcomes rather than ideology. I'll listen to my community, challenge ideas when necessary."
     },
     {
      "_key": "227mFCOl8uclHuS5roWPcN",
      "name": "Priority 1",
      "value": "Clean up politics by increasing transparency, accountability and trust in government."
     },
     {
      "_key": "227mFCOl8uclHuS5roWPfC",
      "name": "Priority 2",
      "value": "Reset our tax system to reward work, reduce inequality and make housing more affordable."
     },
     {
      "_key": "227mFCOl8uclHuS5roWPi1",
      "name": "Priority 3",
      "value": "Build a breakthrough economy with higher productivity, better jobs and greater opportunity."
     }
    ],
