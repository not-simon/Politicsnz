 "election": {
  "candidates": [
   {
    "attributes": [
     {
      "_key": "lXvsWGt582gEfwb3603Ukv",
      "name": "Why I'm standing",
      "value": "I was inspired by the uplifting conversations with the diverse range of people I have met along life's journey. Many found resonance with my perspective and my approach of a united approach towards a more prosperous future for us all. Building a future where no one gets left behind and the success of an economy that depends on a healthy environment. Service has always been a passion of mine."
     },
     {
      "_key": "lXvsWGt582gEfwb3603Upz",
      "name": "About me",
      "value": "Life so far has taught me many valuable skills whilst presenting me with the wisdom of direct experience. As a professional sportsman, serviceman of the NZ Army and Fire and Emergency, I have worked in the highest pressure situations where often lives were at stake. To remain cool, calm and collected with what is presented in front of you and search for the best solution to succeed is what I learnt to be good at."
     },
     {
      "_key": "lXvsWGt582gEfwb3603Uv3",
      "name": "Priority 1",
      "value": "Honouring Te Tiriti - Constitutional Transformation."
     },
     {
      "_key": "lXvsWGt582gEfwb3603V07",
      "name": "Priority 2",
      "value": "Uplift our people out of hardship and address the cost of living."
     },
     {
      "_key": "lXvsWGt582gEfwb3603V5B",
      "name": "Priority 3",
      "value": "Care for our natural environment. Create an economy that is dependent on a healthy environment."
     }
    ],
