   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6Spt",
      "name": "Why I'm standing",
      "value": "Because we are the time of greatest change and greatest risk in the history of our species. The economic system that arguably served us well for most of the last 300 years fails in the presence of advance automation and AI. We have a small window left to make the sort of changes that will ensure that the system serves humanity, rather than we become enslaved to the system."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6Sro",
      "name": "About me",
      "value": "I understand something of the difficulties of business, having grown up on farms, started a fishing business, then started a software business that I have run for 40 years. I have demonstrated commitment to serving my community, and life more widely, as Kaikoura district councillor, over 20 years in Lions, as chair of the Hutton's Shearwater charitable trust, and in many other roles (including appointment as a Kaikoura Marine Guardian)."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6Stj",
      "name": "Priority 1",
      "value": "Provide no interest funding of community owned infrastructure, because the risks are increasing"
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6Sve",
      "name": "Priority 2",
      "value": "Promote fundamental reform of the global economic system"
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6SxZ",
      "name": "Priority 3",
      "value": "Ensuring AI, and the systems they produce, serve the people and environment, and not enslave them."
     }
    ],
