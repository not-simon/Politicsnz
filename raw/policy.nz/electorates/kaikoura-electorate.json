   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6SN6",
      "name": "Why I'm standing",
      "value": "I am representing New Zealand First because I agree with the principles of the party - putting New Zealand and New Zealanders first in our decision making. There has never been a time when we must ensure more than ever, that we protect the principles of democracy. I believe New Zealand First is the party with the policies and principles to support our region. I will be a strong vocal advocate for the Kaikoura electorate."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6SP1",
      "name": "About me",
      "value": "I am a hard worker, good listener, excellent communicator and an active member of our community. Married with four children aged 18-26 and a long involvement in horticulture and local markets, I know the issues the electorate face. I have five terms of local government experience working across all facets of Marlborough District Council. I am the current NZ First Party Whip and have gained valuable experience in my term of being a NZ First MP."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6SQw",
      "name": "Priority 1",
      "value": "Reduce the cost of living by breaking up the supermarket duopoly and energy gentailers."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6SSr",
      "name": "Priority 2",
      "value": "Investment into ports, roads and bridges, increased access to healthcare and education opportunities"
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6SUm",
      "name": "Priority 3",
      "value": "Support Regional development into tourism and primary industries to create jobs and activity."
     }
    ],
    "party": {
     "name": "NZ First"
    },
