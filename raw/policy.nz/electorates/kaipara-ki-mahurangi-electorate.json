   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6g3S",
      "name": "Why I'm standing",
      "value": "I am standing as an Independent because Rodney has become a dumping ground for bureaucrats and party politicians. Decisions about our roads, towns, and environment are made by people who don't live here. Party candidates must obey their Wellington bosses, but I answer only to the Rodney (Kaipara ki Mahurangi) community. By giving me your Electorate Vote, you get a genuine, local champion demanding our fair share of infrastructure, healthcare, and schools."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6g5N",
      "name": "About me",
      "value": "I live here, pay local rates, and have a proven record standing up for our area as Deputy Chair of the Rodney Local Board. With 20 years in strategic leadership and operational resilience, I understand complex delivery. As an Independent, I answer only to our community. I will bring practical, common-sense scrutiny to Parliament, using my independent vote to champion Rodney's roads, healthcare, and local democracy."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6g7I",
      "name": "Priority 1",
      "value": "Demand rates reform to stop unfair wealth taxes pricing locals out of their homes."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6g9D",
      "name": "Priority 2",
      "value": "Oppose Wellington fast-track laws to protect our communities from mega-landfills and subdivisions"
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6gB8",
      "name": "Priority 3",
      "value": "Demand local upgrades before new housing to stop rapid growth from overloading our infrastructure."
     }
    ],
