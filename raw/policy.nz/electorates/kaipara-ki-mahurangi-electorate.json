   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6fHT",
      "name": "Why I'm standing",
      "value": "New Zealand welcomed my family and offered me an urban-rural upbringing that continues to define my life. I'm standing to pay back those gifts through service."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6fJO",
      "name": "About me",
      "value": "I am motivated to stand by a strong sense of responsibility to New Zealand, and to do my bit for the future my daughter will live in. My place to make an impact is in food and farming. I have worked for 10 years to transition Aotearoa New Zealand to a just, regenerative food system, starting businesses, social impact ventures and research projects to make a positive difference where I can."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6fLJ",
      "name": "Priority 1",
      "value": "Ensuring the community voice is heard on critical issues like urban development."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6fNE",
      "name": "Priority 2",
      "value": "Advocating for nature-positive climate resilience solutions."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6fP9",
      "name": "Priority 3",
      "value": "Supporting local businesses to innovate."
     }
    ],
