   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6fUu",
      "name": "Why I'm standing",
      "value": "I'm running because I want to put my experience to work for Kaipara ki Mahurangi. I understand how decisions are made in Wellington, and I want to make sure they work better for our communities. That means helping with the cost of living, backing small businesses, and making sure growth is properly planned so our infrastructure, services, and environment are protected."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6fWp",
      "name": "About me",
      "value": "I would make a good elected representative because I would bring both experience and commitment to the role. I have worked on complex policy issues, understand how government works, and know how important it is to listen to people and represent them well. I would work hard, stay accessible, and focus on practical decisions that improve life for local families and communities."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6fYk",
      "name": "Priority 1",
      "value": "Plan growth properly so new housing and development are matched by the necessary infrastructure."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6faf",
      "name": "Priority 2",
      "value": "Strengthen resilience to flooding and extreme weather."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6fca",
      "name": "Priority 3",
      "value": "Back local businesses and jobs so people can get ahead and young people have a future in the region."
     }
    ],
