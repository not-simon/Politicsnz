   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6gEy",
      "name": "Why I'm standing",
      "value": "I grew up in Coatesville and Riverhead, and Kaipara ki Mahurangi has always been home. I'm standing because I want to be a strong voice for the community that shaped me. I am committed to growing our economy, ensuring infrastructure keeps pace with population growth, and supporting local schools and healthcare services to provide for all Kiwis. Our growing communities deserve a strong local representative in Parliament, and I'm ready to be that voice."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6gGt",
      "name": "About me",
      "value": "I have a strong understanding of how to advocate effectively for communities in Parliament, through my work at the Ministry of Foreign Affairs and Trade and as a Ministerial Advisor. I will use my experience to fight for the infrastructure we need, such as roads and schools. I'm hardworking, approachable and deeply connected to this electorate. I'll be an accessible representative who listens to the community, understands their concerns and works hard to deliver meaningful results."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6gIo",
      "name": "Priority 1",
      "value": "Support local businesses, farmers and growers to create jobs and strengthen our local economy."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6gKj",
      "name": "Priority 2",
      "value": "Improve roads and other infrastructure to keep pace with the needs of our growing communities."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6gMe",
      "name": "Priority 3",
      "value": "Ensure local school and healthcare capacity to meet the needs of growing families and communities."
     }
    ],
