     {
      "_key": "4mT89K6PpYj5QRKx0f6Xl4",
      "name": "Why I'm standing",
      "value": "I'm standing to get things done in Christchurch: tackling crises like unaffordability and overcrowded emergency rooms, 250+ people sleeping rough in the city, increasingly extreme weather, and a generation of young Kiwis moving to Australia. Christchurch deserves better."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6Xmz",
      "name": "About me",
      "value": "I'm with Labour because we're focused on what matters: lowering the cost of living, decent homes, reliable healthcare, and well-paid jobs - so we can all be proud to build a future here together."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6Xou",
      "name": "Priority 1",
      "value": "Cost of living: Unaffordability and how difficult it is for people just to get by."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6Xqp",
      "name": "Priority 2",
      "value": "Making things work: Overcrowded emergency rooms, 250+ people sleeping rough in the city."
     },
     {
