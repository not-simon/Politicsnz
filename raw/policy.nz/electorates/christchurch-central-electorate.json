   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6XZY",
      "name": "Why I'm standing",
      "value": "I'm a big believer in Opportunity, as I'm convinced that together we can be a political catalyst and steady voice of reason in Aotearoa. Let's have sound policy based on evidence and community voice, and our country and people can be much better off."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6XbT",
      "name": "About me",
      "value": "I bring experience in Māori development, environmental restoration and research into alternative economic futures. I serve my marae and Ngāi Tahu whānui, having worked across government, community organisations and academia. Elected representatives, in my view, should make informed, evidence-based opinions, listen to diverse community voices and meaningfully work with other parliamentarians for the betterment of our country. I can do that.  I was born and raised in Banks Peninsula and have lived abroad."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6XdO",
      "name": "Priority 1",
      "value": "A national bed register to crack down on units being used for short-stays without permission."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6XfJ",
      "name": "Priority 2",
      "value": "A stronger Canterbury voice in Parliament; we only have two Cabinet Ministers from the South Island."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6XhE",
      "name": "Priority 3",
      "value": "Fair transport funding for the South Island's long-term infrastructure needs."
     }
    ],
