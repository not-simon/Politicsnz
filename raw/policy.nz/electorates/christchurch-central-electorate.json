   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6Xwa",
      "name": "Why I'm standing",
      "value": "As a democratic socialist, I no longer see myself represented. My main reason is to support the re-establishment of the Alliance Party of Aotearoa NZ for my grandchildren and those to come."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6XyV",
      "name": "About me",
      "value": "Governance and involved with our communities from early childcare, environmental and social justice groups and committees."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6Y0Q",
      "name": "Priority 1",
      "value": "Initiating the Mass Rapid Transit public transport network to support our Greater Christchurch development plan."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6Y2L",
      "name": "Priority 2",
      "value": "Supporting retaining publicly owned assets so profit is not leaked from the economy rather reinvested."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6Y4G",
      "name": "Priority 3",
      "value": "Securing the city's drinking water as nitrates, pollution and private ownership threaten."
     }
