   {
    "attributes": [
     {
      "_key": "4mT89K6PpYj5QRKx0f6YJc",
      "name": "Why I'm standing",
      "value": "I'm standing as an NZ First candidate because I care deeply about New Zealand and the future we leave for our children. I'm a proud New Zealander and believe patriotism, personal responsibility, strong families, social conservatism and respect for our traditions are foundations of a healthy and prosperous society. I'm passionate about putting New Zealanders first, supporting our communities, restoring confidence and accountability from government. Together, we can build a stronger, more united New Zealand."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6YLX",
      "name": "About me",
      "value": "Having lived in the electorate for over 10 years, I have a genuine connection to our community and understand the issues that matter to local people. My diverse management career, including local government and governance roles, has developed my leadership, decision-making, accountability, and problem-solving skills. I bring practical experience, integrity, and energy. I will listen, speak up, and work hard to deliver results and ensure our community has a strong voice."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6YNS",
      "name": "Priority 1",
      "value": "Improve road infrastructure including incorporating rail."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6YPN",
      "name": "Priority 2",
      "value": "Finish the hospital and ensure it's fully staffed."
     },
     {
      "_key": "4mT89K6PpYj5QRKx0f6YRI",
      "name": "Priority 3",
      "value": "Get Christ Church Cathedral open. It's the catalyst to unlock millions of dollars in CBD investment."
     }
    ],
